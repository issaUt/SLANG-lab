    ^A = Y;
    #ASM
    LD   A,(_A)
    LD   (MZ25_VRAM_SHIFT_RECT_LEFT8_Y),A
    #END

    ^A = WBYTE;
    #ASM
    LD   A,(_A)
    LD   (MZ25_VRAM_SHIFT_RECT_LEFT8_WBYTE),A
