    JR   Z,MZ25_VRAM_SHIFT_RECT_DOWN4_2P_ADD_X
    LD   B,A
    LD   DE,40
MZ25_VRAM_SHIFT_RECT_DOWN4_2P_Y_LOOP:
    ADD  HL,DE
    DJNZ MZ25_VRAM_SHIFT_RECT_DOWN4_2P_Y_LOOP
MZ25_VRAM_SHIFT_RECT_DOWN4_2P_ADD_X:
    LD   A,(MZ25_VRAM_SHIFT_RECT_DOWN4_2P_XBYTE)
    LD   E,A
    LD   D,0
    ADD  HL,DE
    RET

MZ25_VRAM_SHIFT_RECT_DOWN4_2P_WRAP:
    DB   0
MZ25_VRAM_SHIFT_RECT_DOWN4_2P_SAVE:
    DB   0
MZ25_VRAM_SHIFT_RECT_DOWN4_2P_BLOCK:
    DB   0
MZ25_VRAM_SHIFT_RECT_DOWN4_2P_XBYTE:
    DB   0
MZ25_VRAM_SHIFT_RECT_DOWN4_2P_Y:
    DB   0
MZ25_VRAM_SHIFT_RECT_DOWN4_2P_WBYTE:
    DB   0
MZ25_VRAM_SHIFT_RECT_DOWN4_2P_H:
    DB   0
MZ25_VRAM_SHIFT_RECT_DOWN4_2P_ROWS:
    DB   0
MZ25_VRAM_SHIFT_RECT_DOWN4_2P_LINEBACK:
    DB   0
MZ25_VRAM_SHIFT_RECT_DOWN4_2P_SRC:
    DW   0
MZ25_VRAM_SHIFT_RECT_DOWN4_2P_END:
    #END
}

