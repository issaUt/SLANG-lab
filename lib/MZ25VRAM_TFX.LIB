}

MZ25_TEXT_SCROLL_UP40_LOOP_NOATTR(BYTE PAGE, BYTE X, BYTE Y, BYTE W, BYTE H)
VAR BYTE ROW,COL;
VAR BYTE CELL[2],EDGE[2];
