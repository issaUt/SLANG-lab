#ASM
include "../../lib/iocs/iocs_mz2500_svc.inc"
#END

// IOCS CRTI 用の画面モード文字列を渡す。
// SLANG の文字列代入は「配列へのコピー」ではなく文字列データへのポインタ設定になる。
// ここではローカル間接変数 BUF に文字列ポインタを持たせ、HL に実アドレスを渡す。
IOCS_CRTI2(BYTE T)
VAR BYTE BUF[];
{
    CASE T OF {
        0: BUF = "320,200,16";
        1: BUF = "640,200,16";
        2: BUF = "640,400,16";
        3: BUF = "320,200,256";
        OTHERS: RETURN;
    }

    ^HL = BUF;
    #ASM
    LD  HL,(_HL)
    SVC SVC_CRTI
    #END
}

// グラフィック画面を初期化する。
// W,H,C から IOCS GINIT のモードビットを組み立てる。
IOCS_GINIT(WORD W, WORD H, WORD C)
VAR BYTE A;
{
    A = 0;
    CASE W OF {
        640: A = 10000000B;
        320:;
        OTHERS:;
    }

    CASE H OF {
        400: A = A OR 01000000B;
        200:;
        OTHERS:;
    }

    CASE C OF {
        4:;
        16:  A = A OR 010000B;
        256: A = A OR 100000B;
        OTHERS:;
    }

    ^A = A;
    #ASM
    LD   A,(_A)
    SVC  SVC_GINIT
    #END
}

//
//  MODE: 各ビットを立てると、その色が文字より上になる。
//        グラフィックすべてを上にしたい場合 $FFFF
//
IOCS_PRIORITY(WORD MODE)
VAR BYTE GM;
VAR BYTE BUF[8];
VAR WORD WBUF[];
{
    GM = 0;  // 今の所未使用
    WBUF=BUF;
    WBUF[0] = MODE;
    BUF[2] = GM;
    ^HL = BUF;

    // SCF ... Cy=1
    #ASM
    OR A
    LD HL, (_HL)
    SVC SVC_PRI
    #END
}

// グラフィック描画範囲を設定する。
IOCS_VIEW(WORD X1, WORD Y1, WORD X2, WORD Y2)
VAR BYTE BUF[12];
VAR WORD WBUF[];
{
    BUF[0]  = 0;
    BUF[1]  = 0;
    BUF[2]  = 0;
    BUF[3]  = 0;

    WBUF = &BUF[4];
    WBUF[0] = X1;
    WBUF[1] = Y1;
    WBUF[2] = X2;
    WBUF[3] = Y2;

    ^HL = BUF;
    #ASM
    LD   HL, (_HL)
    SVC  SVC_VIEW
    #END
}

// ハードウェアビューポートを設定する。
// Cy=0 で有効。座標は WORD 4個を X1,Y1,X2,Y2 の順で渡す。
IOCS_HVIEW(WORD X1, WORD Y1, WORD X2, WORD Y2)
VAR BYTE BUF[8];
VAR WORD WBUF[];
{
    WBUF = &BUF[0];
    WBUF[0] = X1;
    WBUF[1] = Y1;
    WBUF[2] = X2;
    WBUF[3] = Y2;

    ^HL = BUF;
    #ASM
    OR  A
    LD  HL,(_HL)
    SVC SVC_HVIEW
    #END
}

// ハードウェアビューポートをデフォルト状態に戻す。
// IOCS_HVIEW は Cy=1 の場合、HL の内容を参照せずデフォルト View へ初期化する。
IOCS_HVIEW_DEFAULT()
{
    #ASM
    SCF
    SVC SVC_HVIEW
    #END
}

// 画面関係を初期状態へ戻す。
IOCS_INITSCREEN()
{
    ^A = 0FFh;

    #ASM
    LD  A,(_A)
    SVC SVC_SCREN
    #END
}

// SVC_SCREN を直接呼び出す。
// FUNC: A レジスタに渡す機能番号。
// VALUE: HL レジスタに渡す値。
IOCS_SCREEN_RAW(BYTE FUNC, WORD VALUE)
{
    ^A = FUNC;
    ^HL = VALUE;
    #ASM
    LD  A,(_A)
    LD  HL,(_HL)
    SVC SVC_SCREN
    #END
}

// 描画先の入力ページを指定する。
// 320x200x16色では 0..3、640x200x16色では 0..1 を想定する。
IOCS_SCREEN_INPUT_PAGE(BYTE PAGE)
{
    ^A = 0;
    ^HL = PAGE;
    #ASM
    LD  A,(_A)
    LD  HL,(_HL)
    LD  H,0
    SVC SVC_SCREN
    #END
}

// 出力ページ指定用の表示フラグを直接指定する。
// A=1, L=FLAGS として SVC_SCREN を呼び出す。
// 640x200x16色では FLAGS=$02/$05 で 0/1 画面を切り替えられることを確認済み。
IOCS_SCREEN_OUTPUT_FLAGS(BYTE FLAGS)
{
    ^A = 1;
    ^HL = FLAGS;
    #ASM
    LD  A,(_A)
    LD  HL,(_HL)
    LD  H,0
    SVC SVC_SCREN
    #END
}

// 640x200x16色向けの出力ページを指定する。
// PAGE=0 で第0画面、PAGE!=0 で第1画面を表示する。
IOCS_SCREEN_OUTPUT_PAGE640(BYTE PAGE)
{
    IF (PAGE == 0) {
        IOCS_SCREEN_OUTPUT_FLAGS(00000010b);
    } ELSE {
        IOCS_SCREEN_OUTPUT_FLAGS(00000101b);
    }
}

// 320x200x16色向けの出力ページを指定する。
// BASICの処理では PAGE=0..3 に対して FLAGS=$02,$04,$03,$05 を指定している。
IOCS_SCREEN_OUTPUT_PAGE320(BYTE PAGE)
{
    CASE PAGE OF {
        0: IOCS_SCREEN_OUTPUT_FLAGS(00000010b);
        1: IOCS_SCREEN_OUTPUT_FLAGS(00000100b);
        2: IOCS_SCREEN_OUTPUT_FLAGS(00000011b);
        3: IOCS_SCREEN_OUTPUT_FLAGS(00000101b);
        OTHERS: IOCS_SCREEN_OUTPUT_FLAGS(00000010b);
    }
}

// 320x200x16色向けの出力ページ組を指定する。
// BASICの処理では GROUP=0 が 0/1 画面組、GROUP!=0 が 2/3 画面組に対応する。
IOCS_SCREEN_OUTPUT_GROUP320(BYTE GROUP)
{
    IF (GROUP == 0) {
        IOCS_SCREEN_OUTPUT_FLAGS(00000110b);
    } ELSE {
        IOCS_SCREEN_OUTPUT_FLAGS(00000111b);
    }
}
// 描画ページと表示ページを切り替える。
// 640x200x16色の 0/1 画面切り替え向け。
// GI: 描画対象ページ、GO: 表示ページ。
IOCS_SCREEN(BYTE GI, BYTE GO)
{
    IOCS_SCREEN_INPUT_PAGE(GI);
    IOCS_SCREEN_OUTPUT_PAGE640(GO);
}

// 描画ページと表示ページを切り替える。
// 320x200x16色の 0..3 画面切り替え向け。
// GI: 描画対象ページ、GO: 表示ページ。
IOCS_SCREEN320(BYTE GI, BYTE GO)
{
    IOCS_SCREEN_INPUT_PAGE(GI);
    IOCS_SCREEN_OUTPUT_PAGE320(GO);
}

// 描画ページと重ね合わせ表示グループを切り替える。
// 320x200x16色向け。GROUP=0 で 0/1 画面組、GROUP!=0 で 2/3 画面組を表示する。
// GI: 描画対象ページ、GROUP: 表示ページ組。
IOCS_SCREEN320_GROUP(BYTE GI, BYTE GROUP)
{
    IOCS_SCREEN_INPUT_PAGE(GI);
    IOCS_SCREEN_OUTPUT_GROUP320(GROUP);
}
// グラフィック画面を指定色で消去する。
IOCS_CLS(BYTE C)
{
    ^A = C;
    #ASM
    LD  A,(_A)
    SVC SVC_CLS
    #END
}

// ペン形状を設定する。
// 現在は固定値のみ。詳細なペン形状指定は未整理。
IOCS_PENSE()  // IOCS_PENSE(T)
VAR BYTE T;
{
    ^A = 0;   // 現在ペン形状は未設定
    #ASM
    LD  A,(_A)
    SVC SVC_PENSE
    #END
}

// 点を描画する。
// 640x200 向け。通常のSLANGワーク領域に置いたパラメータブロックを HL で渡す。
IOCS_PSET_RAW(WORD X, WORD Y, BYTE C)
VAR BYTE BUF[6];
VAR WORD WBUF[];
{
    BUF[0] = C;
    BUF[1] = 0;           // MODE

    WBUF = &BUF[2];
    WBUF[0] = X;
    WBUF[1] = Y;

    ^HL = BUF;
    #ASM
    OR   A
    LD   HL, (_HL)
    SVC  SVC_PSET
    #END
}

// 点を描画する。
// 640x400 向け。BASIC と同じ低位ワーク領域 0CC0h にパラメータを置いて呼び出す。
IOCS_PSET_RAW400(WORD X, WORD Y, BYTE C)
{
    ^HL = X;
    ^DE = Y;
    ^A  = C;
    #ASM
    LD  HL,0CC0H
    LD  A,(_A)
    LD  (HL),A
    INC HL
    LD  (HL),0
    INC HL
    LD  DE,(_HL)
    LD  (HL),E
    INC HL
    LD  (HL),D
    INC HL
    LD  DE,(_DE)
    LD  (HL),E
    INC HL
    LD  (HL),D
    OR  A
    LD  HL,0CC0H
    SVC SVC_PSET
    #END
}

// 点を描画する。640x400で誤動作するため、LINEで代用
IOCS_PSET(WORD X, WORD Y, BYTE C)
VAR BYTE BUF[13];
VAR WORD WBUF[];
{
    BUF[0] = C;
    BUF[1] = 0;           // MODE

    WBUF = &BUF[2];
    WBUF[0] = X;
    WBUF[1] = Y;
    WBUF[2] = X;
    WBUF[3] = Y;

    BUF[10] = 0;          // Line Style Type
    BUF[11] = $FF;        // Line Style
    BUF[12] = $FF;        // Line Style

    ^HL = BUF;
    #ASM
    OR   A
    LD   HL, (_HL)
    SVC  SVC_LINE
    #END
}


// 現在位置を設定する。
IOCS_POSSV_SET(WORD X, WORD Y)
VAR BYTE BUF[6];
VAR WORD WBUF[];
{
    WBUF = &BUF[0];
    WBUF[0] = X;
    WBUF[1] = Y;

    ^HL = BUF;
    #ASM
    OR  A         ; Cy = 0;
    LD  HL,(_HL)
    SVC SVC_POSSV
    #END
}

// 現在位置を読み取る。
IOCS_POSSV_READ(WORD BUF[])
{
    ^HL = BUF;
    #ASM
    SCF             ; Cy=1
    LD  HL,(_HL)
    SVC SVC_POSSV

    LD  (_DE),DE
    LD  (_HL),HL
    #END

    BUF[0] = ^DE;
    BUF[1] = ^HL;
}

// 線を描画する。
// 座標は WORD、色と描画モードは BYTE の IOCS_LINE パラメータブロックへ詰める。
IOCS_LINE(WORD X1, WORD Y1, WORD X2, WORD Y2, BYTE C)
VAR BYTE BUF[13];
VAR WORD WBUF[];
{
    /*
    BUF[0] = C;
    BUF[1] = 0;           // MODE
    BUF[2] = X1 AND $FF;
    BUF[3] = X1 >>  8;
    BUF[4] = Y1 AND $FF;
    BUF[5] = Y1 >>  8;
    BUF[6] = X2 AND $FF;
    BUF[7] = X2 >>  8;
    BUF[8] = Y2 AND $FF;
    BUF[9] = Y2 >>  8;
    BUF[10] = 0;          // Line Style Type
    BUF[11] = $FF;        // Line Style
    BUF[12] = $FF;        // Line Style
    */

    BUF[0] = C;
    BUF[1] = 0;

    WBUF = &BUF[2];
    WBUF[0] = X1;
    WBUF[1] = Y1;
    WBUF[2] = X2;
    WBUF[3] = Y2;

    BUF[10] = 0;
    BUF[11] = $FF;
    BUF[12] = $FF;

    // ^HL = &BUF[0];
    ^HL = BUF;
    #ASM
    LD   HL, (_HL)
    SVC  SVC_LINE
    #END
}

// 四角形を描画する。
// M=0: 枠線のみ、M=1: パターン線のみ、M=2: 塗りつぶし、M=3: パターン塗りつぶし。
IOCS_BOX(WORD X1, WORD Y1, WORD X2, WORD Y2, BYTE C, BYTE M)
VAR BYTE BUF[13];
VAR WORD WBUF[];
{
    BUF[0] = C;
    BUF[1] = 0;           // MODE

    WBUF = &BUF[2];
    WBUF[0] = X1;
    WBUF[1] = Y1;
    WBUF[2] = X2;
    WBUF[3] = Y2;

    BUF[10] = M;          // Line Style Type
    BUF[11] = $FF;        // Line Style
    BUF[12] = $FF;        // Line Style

    ^HL = BUF;
    #ASM
    LD   HL, (_HL)
    SVC  SVC_BOX
    #END
}

// 塗りつぶし
// X, Y 座標: X, Y
// 境界色の数バッファアドレス: B[]
// 境界色数: BC
// 単色塗りつぶし色: C
IOCS_PAINT(WORD X, WORD Y, WORD B[], BYTE BC, BYTE C)
VAR BYTE BUF[11];
VAR WORD WBUF[];
{
    WBUF = &BUF[0];
    WBUF[0] = X;
    WBUF[1] = Y;
    WBUF[2] = &B[0];

    BUF[6] = BC;
    BUF[7] = 0;           // 単色塗りつぶしモード
    BUF[8] = 0;           // ダミー（タイルペイントモードで使用）
    BUF[9] = C;           // 塗りつぶし色
    BUF[10] = 0;           // ダミー（タイルペイントモードで使用）
    BUF[11] = 0;           // ダミー（タイルペイントモードで使用）

    ^HL = BUF;
    #ASM
    LD   HL, (_HL)
    SVC  SVC_PAINT
    #END
}

// 円を描画する。
// 現状は中心、半径、色のみ指定し、拡張パラメータは 0 で埋める。
IOCS_CIRCLE(WORD X, WORD Y, WORD R, BYTE C)
VAR BYTE BUF[24];
VAR WORD WBUF[];
{
    BUF[0] = C;
    BUF[1] = 0;           // MODE

    WBUF = &BUF[2];
    WBUF[0] = X;
    WBUF[1] = Y;
    WBUF[2] = R;

    BUF[8] = 0;
    BUF[9]  = 0;   // Start Angle 0.0
    BUF[10] = 0;
    BUF[11] = 0;
    BUF[12] = 0;
    BUF[13] = 0;

    BUF[14] = $83; // End Angle 2*PI
    BUF[15] = $49;
    BUF[16] = $0F;
    BUF[17] = $DA;
    BUF[18] = 0;

    BUF[19] = $81; // Aspect Ratio 1.0
    BUF[20] = 0;
    BUF[21] = 0;
    BUF[22] = 0;
    BUF[23] = 0;

    ^HL = BUF;
    #ASM
    LD   HL, (_HL)
    SVC  SVC_CIRCLE
    #END
}

// 扇形を描画する
// 中心、半径、色、描画モード、開始角、終了角、アスペクト比
// 描画モードM: 0...円弧のみ
//             1...中心から開始角までの直線描画
//             2...中心から終了角までの直線描画
//             3...1,2共（扇描画）
IOCS_FANSHAPE(WORD X, WORD Y, WORD R, BYTE C, BYTE M, BYTE SA[], BYTE EA[], BYTE AR[])
VAR I;
VAR BYTE BUF[24];
VAR WORD WBUF[];
{
    BUF[0] = C;
    BUF[1] = 0;           // MODE

    WBUF = &BUF[2];
    WBUF[0] = X;
    WBUF[1] = Y;
    WBUF[2] = R;

    BUF[8] = M;

    FOR I=0 TO 4 {
        BUF[I+9]  = SA[I]; // Start Angle
        BUF[I+14] = EA[I]; // End Angle
        BUF[I+19] = AR[I]; // Aspect Ratio
    }

    ^HL = BUF;
    #ASM
    LD   HL, (_HL)
    SVC  SVC_CIRCLE
    #END
}

// パレットを初期状態へ戻す。
IOCS_INITCOLOR()
{
    #ASM
    LD  A,0
    SCF             ; Cy=1
    SVC SVC_COLOR
    #END
}

// 16色パレットの色番号対応を変更する。
// TABLE は [PaletteID, ColorIndex] の繰り返しで、C 個分を指定する。
IOCS_COLOR(BYTE C, BYTE TABLE[])
// C: テーブルサイズ
// TABLE: 指定サイズ分のテーブルx2,PaletteID, COLORの順
VAR BYTE I,J,E;
VAR BYTE BUF[33];
{
    /*
    // NOTE:
    // IOCS_COLOR は色番号から参照パレット番号への対応を変更する。
    // 4096色パレットを設定する前に 15->1 のような非単調/巻き戻り指定を行うと、
    // パレット15番のRGB値自体は更新されても、実表示色が期待通りにならない場合がある。
    // 4096色設定と組み合わせる場合は、identity mapping(0->0 ... 15->15)、
    // または必要な範囲だけの単調な指定に留めるのが安全。
    */
    IF (C == 0 ) { RETURN; }
    IF (C > 16) { C = 16; }
    BUF[0] = C;
    E=C-1;
    FOR I= 0 TO E {
        J = I * 2;
        BUF[J+1] = TABLE[J];    // PaletteID
        BUF[J+2] = TABLE[J+1];  // ColorIndex
    }

    ^HL = BUF;
    #ASM
    OR  A       ; Cy = 0
    LD  A,0
    LD  HL,(_HL)
    SVC SVC_COLOR
    #END
}

// 4096色パレットのRGB値を変更する。
// TABLE は [PaletteID, G, R, B] の繰り返しで、C 個分を指定する。
IOCS_COLOR4096(BYTE C, BYTE TABLE[])
// C: テーブルサイズ。配列はCx4のサイズが必要
// TABLE: 1色あたり、Color, 3ByteのRGB、計4Byteデータセット
VAR BYTE I,J,E;
VAR BYTE BUF[65];
{
    IF (C == 0 ) { RETURN; }
    IF (C > 16) { C = 16; }
    BUF[0] = C;
    E=C-1;
    FOR I= 0 TO E {
        J = I * 4;
        BUF[J+1] = TABLE[J];    // PaletteID
        BUF[J+2] = TABLE[J+1];  // Green Level 0..15
        BUF[J+3] = TABLE[J+2];  // Red Level 0..15
        BUF[J+4] = TABLE[J+3];  // Blue Level 0..15
    }

    ^HL = BUF;
    #ASM
    OR  A       ; Cy = 0
    LD  A,1
    LD  HL,(_HL)
    SVC SVC_COLOR
    #END
}

// SYMBOL
// 現在のグラフィック位置(POSSV)から文字列を描画する。
// 640x200 向け。通常のSLANGワーク領域に置いたパラメータブロックを HL で渡す。
// BUF[0]: 色、BUF[1]: モード、BUF[2]: 文字数、BUF[3..4]: 文字列アドレス。
// BUF[5..6] は倍率系、BUF[7] は角度、BUF[8] はフォント系として IOCS が参照する。
// AG: 角度(0...ノーマル, 1...90deg, 2...180deg, 3...270deg)
// FM: フォント(0...8x8, 1...8x16)
IOCS_SVMBL(BYTE SBUF[], BYTE BC, BYTE C, BYTE M, BYTE MX, BYTE MY, BYTE AG, BYTE FM)
VAR BYTE BUF[24];
{
    BUF[0] = C;
    BUF[1] = M;
    BUF[2] = BC;
    BUF[3] = SBUF AND $FF;
    BUF[4] = SBUF >>  8;
    BUF[5] = MX;
    BUF[6] = MY;
    BUF[7] = AG;
    BUF[8] = FM;

    ^HL = BUF;
    #ASM
    OR  A
    LD  HL,(_HL)
    SVC SVC_SVMBL
    #END
}

// SYMBOL
// 現在のグラフィック位置(POSSV)から文字列を描画する。
// 640x400 向け。BASIC と同じ低位ワーク領域 0CC0h にパラメータ、
// 0CD0h に文字列本体を置いて呼び出す。
// 長い文字列を扱う場合は 0CD0h 以降の使用範囲に注意する。
IOCS_SVMBL400(BYTE SBUF[], BYTE BC, BYTE C, BYTE M, BYTE MX, BYTE MY, BYTE AG, BYTE FM)
VAR I;
{
    FOR I = 0 TO BC-1 {
        MEM[$0CD0+I] = SBUF[I];
    }
    MEM[$0CD0+BC] = 0;

    MEM[$0CC0] = C;
    MEM[$0CC1] = M;
    MEM[$0CC2] = BC;
    MEM[$0CC3] = $D0;
    MEM[$0CC4] = $0C;
    MEM[$0CC5] = MX;
    MEM[$0CC6] = MY;
    MEM[$0CC7] = AG;
    MEM[$0CC8] = FM;

    #ASM
    OR  A
    LD  HL,0CC0H
    SVC SVC_SVMBL
    #END
}

// ハードウェアスクロール
// MODE: 0...SCROLL, 1...Initialize
IOCS_HROLL(BYTE MODE, WORD Y)
{
    IF (MODE != 0) {
        #ASM
        SCF
        SVC SVC_HROLL
        #END
        RETURN;
    }

    ^DE = Y;
    #ASM
    LD DE,(_DE)
    OR A
    SVC SVC_HROLL
    #END
}

// 文字を１文字表示する
IOCS_CRT1C(BYTE C)
{
    ^A = C;
    #ASM
    LD  A,(_A)
    SVC SVC_CRT1C
    #END
}

// 改行する
IOCS_CR1()
{
    #ASM
    SVC SVC_CR1
    #END
}

// 文字列を表示する。
// S は 0 終端文字列を指す BYTE 間接変数。
IOCS_CRTMS(BYTE S[])
{
    ^DE = S;
    #ASM
    LD   DE,(_DE)
    SVC  SVC_CRTMS
    #END
}


// 8x8ドットPCGパターンを1面分定義する。
// CH: 1バイト文字コード。BASIC の DEF CHR$(64) なら $40 を指定する。
// SEL: PCGセレクト番号。カラーPCGでは 1=B, 2=R, 3=G として使う。
// DATA: 1面分の8バイトデータ。
// SPCG はパターンを DIRARE($1000-) から読むため、先に MEM[$1000+I] へコピーする。
// IOCS側の処理は SEL 指定先へ8バイトだけコピーする。
// 8x16ドットPCGは文字コードが $0100..$01FE になるため、別関数として扱う予定。
IOCS_SPCG8(BYTE CH, BYTE SEL, BYTE DATA[])
VAR BYTE I;
{
    FOR I = 0 TO 7 {
        MEM[$1000 + I] = DATA[I];
    }

    ^DE = CH;
    ^A = SEL;
    #ASM
    LD  DE,(_DE)
    LD  A,(_A)
    LD  B,A
    SVC SVC_SPCG
    #END
}

/*
// PCGデータ定義例。
// BASIC の hexchr$("8DAD...") は、2桁ずつ BYTE 配列に展開して持つ。
// 文字列ではなく BYTE 配列にすることで、$00 を含むパターンも安全に扱える。
VAR BYTE PCG_64_B[8] = {
    $8D,$AD,$AD,$AD,$AD,$AD,$AD,$AD
};
VAR BYTE PCG_64_R[8] = {
    $00,$00,$04,$0C,$0C,$0C,$0C,$08
};
VAR BYTE PCG_64_G[8] = {
    $00,$01,$81,$84,$8D,$0D,$8D,$88
};

// カラーPCG使用例:
// IOCS_SPCG8($40, 1, PCG_64_B);
// IOCS_SPCG8($40, 2, PCG_64_R);
// IOCS_SPCG8($40, 3, PCG_64_G);
*/

IOCS_LOCATE(BYTE X, BYTE Y)
VAR WORD XY;
{
    XY = Y << 8;
    XY = XY OR X;
    ^HL = XY;

    #ASM
    LD HL,(_HL)
    SVC SVC_CMOV
    #END
}

IOCS_GETCURSOR(BYTE POS[])
VAR BYTE BUF[];
{
    BUF = $05E2;
    POS[0] = BUF[0];
    POS[1] = BUF[1];
}


// テキスト画面を初期化する。
// IOCS TINIT をそのまま呼び出す。
// TYPE = 0
//    MODE: b4=0 ... 通常スクロール
//          b4=1 ... スムーススクロール
//          b3=0 ... 8x8フォント
//          b2=1 ... 8x16フォント
//          b2.b1=00 ... 25行
//          b2.b1=01 ... 20行
//          b2.b1=10 ... 12行
//          b0=0 ... 80桁(幅)
//          b0=1 ... 40桁(幅)
// TYPE = 1
//    MODE = 0 ... 8色モード
//    MODE = 1 ... 256色モード
//
IOCS_TINIT(BYTE TYPE, BYTE MODE)
{
    ^A = MODE;

    IF (TYPE == 0) {
        #ASM
        OR  A
        LD  A,(_A)
        SVC SVC_TINIT
        #END
        RETURN;
    }
    #ASM
    LD A,(_A)
    SCF  ; Cy=1
    SVC SVC_TINIT
    #END
}

// テキスト画面モードを設定する。
// TYPE = 0: MODE = 0 ... KMODE=0: セミグラフィック
//           MODE = 1 ... KMODE=1: S-JIS
// TYPE = 1: MODE = 0 ... KLIST=0: 最下層ファンクションキー非表示
//           MODE = 1 ... KLIST=1: ファンクションキー表示
//           MODE = 2 ... KLIST=2: ファンクションキー, 時計表示
// TYPE = 2: MODE = 0 ... 常にカーソルを消す
//           MODE = 1 ... 常にカーソルをつける
//           MODE = 2 ... キー入力時のみカーソルを付ける
// TYPE = 3: MODE = 0 ... スクロール可能
//           MODE = 1 ... スクロール禁止
// TYPE = 4: MODE = 0 ... 文字の背景色透明
//           MODE = 1 ... 文字の背景色黒
// TYPE = 5: MODE = 0 ... モノクロディスプレイ表示
//           MODE = 1 ... モノクロディスプレイ反転表示
// TYPE = 6: MODE = 0 ... Cy+MODE の9bitでカラー0の実表示色を指定
// TYPE = 7: MODE = 0 ... モノクロディスプレイにグラフィックも表示
//           MODE = 1 ... モノクロディスプレイは文字のみ表示
IOCS_TMOD(BYTE TYPE, BYTE MODE)
{
    ^BC = TYPE;
    ^A = MODE;
    #ASM
    LD  BC,(_BC);
    LD  A,(_A)
    SVC SVC_TMOD
    #END
}

//
//  PI: 入力ページ指定 0/1
//      0 ... ページ0
//      1 ... ページ1
//  PO: 出力ページ指定 0/1/2
//      0 ... ページ0
//      1 ... ページ1
//      2 ... ページ0/1合成
IOCS_TSCREEN(BYTE PI, BYTE PO)
VAR BYTE VAL;
{
    VAL = 0;
    IF (PI == 0) {
        VAL = 1;
    } ELSE {
        VAL = 2;
    }

    CASE PO OF {
        0: VAL = VAL OR 00100b;
        1: VAL = VAL OR 01000b;
        2: VAL = VAL OR 01100b;
    }

    IOCS_TSCRN(VAL);
}

// テキスト画面表示状態を設定する。
// MODE: b1b0=00 ... アクセスページは変更しない
//       b1b0=01 ... ページ0をアクセス
//       b1b0=10 ... ページ1をアクセス
//       b3b2=00 ... 表示ページは変更しない
//       b3b2=01 ... ページ0のみ表示
//       b3b2=10 ... ページ1のみ表示
//       b3b2=11 ... ページ0>ページ1で合成表示
IOCS_TSCRN(BYTE MODE)
{
    ^A = MODE;
    #ASM
    LD  A,(_A)
    SVC SVC_TSCRN
    #END
}

// テキスト属性を設定する。
// MODE = 0: ATRの色（64色系）に変更
// MODE = 1: ATR==0 ... ブリンク解除
//           ATR<>1 ... ブリンク
// MODE = 2:  ATR==0 ... リバース解除
//           ATR<>1 ... リバース
//
// SX: 開始座標X
// SY: 開始座標Y
// LX: X長さ
// LY: Y長さ
//
IOCS_TATR(BYTE MODE, BYTE SX, BYTE SY, BYTE LX, BYTE LY, BYTE ATR)
VAR WORD XY, L;
{
    ^BC = MODE;
    ^A = ATR;

    XY = SY << 8;
    XY = XY OR SX;
    ^HL = XY;

    L = LY << 8;
    L = L OR LX;
    ^DE = L;

    #ASM
    LD  A,(_A)
    LD  BC,(_BC)
    LD  HL,(_HL)
    LD  DE,(_DE)
    SVC SVC_TATR
    #END
}

//
// これから表示するテキストの色と属性を設定する。
// $05F4/$05F6 に文字色、$05F5/$05F7 に属性を直接指定する。
// COLOR: b2b1b0 の文字色。001=青, 010=赤, 100=緑。組み合わせ指定可。
// ATR: b7=ブリンク, b6=リバース, b5b4=00通常/01 PCG1/10 PCG2/11 PCG3, b3=モノクロ用。
IOCS_SETTCOLOR(BYTE COLOR, BYTE ATR)
{
    MEM[$05F4] = COLOR;
    MEM[$05F6] = COLOR;
    MEM[$05F5] = ATR;
    MEM[$05F7] = ATR;
}


// テキスト画面幅を設定する。
// WIDTH: b0=0 ... 80桁
//        b0=1 ... 40桁
//        b2b1=00 ... 25行
//        b2b1=01 ... 20行
//        b2b1=10 ... 12行
IOCS_TWID(BYTE WIDTH)
{
    ^A = WIDTH;
    #ASM
    LD  A,(_A)
    SVC SVC_TWID
    #END
}

// テキスト画面をクリアする。
// A=0 として IOCS TCLR を呼び出す。
IOCS_TCLR()
{
    ^A = 0;
    #ASM
    LD  A,(_A)
    SVC SVC_TCLR
    #END
}

// テキスト画面クリアを直接呼び出す。
// MODE の意味は IOCS 側仕様確認中。A=MODE として呼び出す薄いラッパー。
IOCS_TCLR_RAW(BYTE MODE)
{
    ^A = MODE;
    #ASM
    LD  A,(_A)
    SVC SVC_TCLR
    #END
}

// テキスト画面をスクロールする。
// DIR == 0 ... 上方向にスクロール
// DIR <> 0 ... 下方向にスクロール
IOCS_TSCRL(BYTE DIR)
{
    ^A = DIR;
    #ASM
    LD  A,(_A)
    SVC SVC_TSCRL
    #END
}

// テキストウィンドウを設定する CONSOLE 相当
// SX ... 開始X位置
// SY ... 開始Y位置
// LX ... X方向長さ
// LY ... Y方向長さ
IOCS_TWARE(BYTE SX, BYTE SY, BYTE LX, BYTE LY)
VAR WORD XY, L;
{
    XY = SY << 8;
    XY = XY OR SX;
    ^HL = XY;

    L = LY << 8;
    L = L OR LX;
    ^DE = L;

    #ASM
    LD  HL,(_HL)
    LD  DE,(_DE)
    SVC SVC_TWARE
    #END
}

// ハードウェアテキスト表示領域を設定する。CONSOLE@相当
// SX ... 開始X位置
// SY ... 開始Y位置
// LX ... X方向長さ
// LY ... Y方向長さ
IOCS_TDARE(BYTE SX, BYTE SY, BYTE LX, BYTE LY)
VAR WORD XY, L;
{
    XY = SY << 8;
    XY = XY OR SX;
    ^HL = XY;

    L = LY << 8;
    L = L OR LX;
    ^DE = L;

    #ASM
    LD  HL,(_HL)
    LD  DE,(_DE)
    SVC SVC_TDARE
    #END
}
