    LD   A,1
    OUT  (0B4H),A
    LD   A,(MZ25_VRAM_SHIFT_RECT_LEFT4_2P_SAVE)
    OUT  (0B5H),A
    EI
    JR   MZ25_VRAM_SHIFT_RECT_LEFT4_2P_END

MZ25_VRAM_SHIFT_RECT_LEFT4_2P_BLOCK_PROC:
    CALL MZ25_VRAM_SHIFT_RECT_LEFT4_2P_CALC_START
    LD   A,(MZ25_VRAM_SHIFT_RECT_LEFT4_2P_H)
MZ25_VRAM_SHIFT_RECT_LEFT4_2P_LINE:
    LD   (MZ25_VRAM_SHIFT_RECT_LEFT4_2P_WRAP),A
    LD   A,(MZ25_VRAM_SHIFT_RECT_LEFT4_2P_WBYTE)
    LD   B,A
    CALL MZ25_VRAM_SHIFT_RECT_LEFT4_2P_LINE_PROC
    LD   A,(MZ25_VRAM_SHIFT_RECT_LEFT4_2P_LINEADD)
    LD   C,A
    LD   B,0
    ADD  HL,BC
    LD   A,(MZ25_VRAM_SHIFT_RECT_LEFT4_2P_WRAP)
    DEC  A
    JR   NZ,MZ25_VRAM_SHIFT_RECT_LEFT4_2P_LINE
    RET

MZ25_VRAM_SHIFT_RECT_LEFT4_2P_LINE_PROC:
    LD   E,B
    LD   D,0
    ADD  HL,DE
    DEC  HL
    LD   A,B
    DEC  A
    JR   Z,MZ25_VRAM_SHIFT_RECT_LEFT4_2P_FIRST
    LD   B,A
MZ25_VRAM_SHIFT_RECT_LEFT4_2P_BYTE:
    LD   A,(HL)
    AND  0FH
    RLCA
    RLCA
    RLCA
    RLCA
    LD   C,A
    DEC  HL
    LD   A,(HL)
    AND  0F0H
    RRCA
    RRCA
    RRCA
    RRCA
    OR   C
    INC  HL
    LD   (HL),A
    DEC  HL
    DJNZ MZ25_VRAM_SHIFT_RECT_LEFT4_2P_BYTE
MZ25_VRAM_SHIFT_RECT_LEFT4_2P_FIRST:
    LD   A,(HL)
    AND  0FH
    RLCA
    RLCA
    RLCA
    RLCA
    LD   (HL),A
    LD   A,(MZ25_VRAM_SHIFT_RECT_LEFT4_2P_WBYTE)
    LD   E,A
    LD   D,0
    ADD  HL,DE
    RET

MZ25_VRAM_SHIFT_RECT_LEFT4_2P_CALC_START:
    LD   HL,2000H
    LD   A,(MZ25_VRAM_SHIFT_RECT_LEFT4_2P_Y)
    OR   A
    JR   Z,MZ25_VRAM_SHIFT_RECT_LEFT4_2P_ADD_X
    LD   B,A
    LD   DE,40
MZ25_VRAM_SHIFT_RECT_LEFT4_2P_Y_LOOP:
    ADD  HL,DE
    DJNZ MZ25_VRAM_SHIFT_RECT_LEFT4_2P_Y_LOOP
MZ25_VRAM_SHIFT_RECT_LEFT4_2P_ADD_X:
    LD   A,(MZ25_VRAM_SHIFT_RECT_LEFT4_2P_XBYTE)
    LD   E,A
    LD   D,0
    ADD  HL,DE
    RET

MZ25_VRAM_SHIFT_RECT_LEFT4_2P_WRAP:
    DB   0
MZ25_VRAM_SHIFT_RECT_LEFT4_2P_SAVE:
    DB   0
MZ25_VRAM_SHIFT_RECT_LEFT4_2P_BLOCK:
    DB   0
MZ25_VRAM_SHIFT_RECT_LEFT4_2P_XBYTE:
    DB   0
MZ25_VRAM_SHIFT_RECT_LEFT4_2P_Y:
    DB   0
MZ25_VRAM_SHIFT_RECT_LEFT4_2P_WBYTE:
    DB   0
MZ25_VRAM_SHIFT_RECT_LEFT4_2P_H:
    DB   0
MZ25_VRAM_SHIFT_RECT_LEFT4_2P_LINEADD:
    DB   0
MZ25_VRAM_SHIFT_RECT_LEFT4_2P_END:
    #END
}
// タイル番号マップから、8x8タイル矩形を高速にまとめて描画する。
// TILETBL は plane0 のタイルアドレス表を先頭に、plane1, plane2, plane3 の順で並べる。
// 各プレーンの表サイズは TILE_COUNT * 2 バイト。
// MAPADR: マップ配列先頭, MAP_W: マップ横幅, VIEW_W/VIEW_H: 表示タイル数。
MZ25_VRAM_DRAW_TILEMAP8_2P(BYTE PAGE, BYTE SXBYTE, BYTE SY, BYTE VIEW_X, BYTE VIEW_Y, BYTE MAP_W, BYTE VIEW_W, BYTE VIEW_H, BYTE TILE_COUNT, WORD MAPADR, WORD TILETBL)
{
    ^A = PAGE;
    #ASM
    LD   A,(_A)
    AND  03H
    LD   C,A
    AND  01H
    LD   B,A
    LD   A,C
    AND  02H
    ADD  A,A
    ADD  A,A
    ADD  A,B
    ADD  A,20H
    LD   (MZ25_VRAM_DRAW_TILEMAP8_2P_BLOCK),A
    #END

    ^A = SXBYTE;
    #ASM
    LD   A,(_A)
    LD   (MZ25_VRAM_DRAW_TILEMAP8_2P_SXBYTE),A
    #END

    ^A = SY;
    #ASM
    LD   A,(_A)
    LD   (MZ25_VRAM_DRAW_TILEMAP8_2P_SY),A
    #END

    ^A = VIEW_X;
    #ASM
    LD   A,(_A)
    LD   (MZ25_VRAM_DRAW_TILEMAP8_2P_VIEW_X),A
    #END

    ^A = VIEW_Y;
    #ASM
    LD   A,(_A)
    LD   (MZ25_VRAM_DRAW_TILEMAP8_2P_VIEW_Y),A
    #END

    ^A = MAP_W;
    #ASM
    LD   A,(_A)
    LD   (MZ25_VRAM_DRAW_TILEMAP8_2P_MAP_W),A
    #END

    ^A = VIEW_W;
    #ASM
    LD   A,(_A)
    LD   (MZ25_VRAM_DRAW_TILEMAP8_2P_VIEW_W),A
    #END

    ^A = VIEW_H;
    #ASM
    LD   A,(_A)
    LD   (MZ25_VRAM_DRAW_TILEMAP8_2P_VIEW_H),A
    #END

    ^A = TILE_COUNT;
    #ASM
    LD   A,(_A)
    ADD  A,A
    LD   (MZ25_VRAM_DRAW_TILEMAP8_2P_TABLE_STEP),A
    #END

    ^HL = MAPADR;
    #ASM
    LD   HL,(_HL)
    LD   (MZ25_VRAM_DRAW_TILEMAP8_2P_MAP_BASE),HL
    #END

    ^HL = TILETBL;
    #ASM
    LD   HL,(_HL)
    LD   (MZ25_VRAM_DRAW_TILEMAP8_2P_TABLE),HL

    DI
    LD   A,1
    OUT  (0B4H),A
    IN   A,(0B5H)
    LD   (MZ25_VRAM_DRAW_TILEMAP8_2P_SAVE),A

    LD   C,2
MZ25_VRAM_DRAW_TILEMAP8_2P_PLANE:
    PUSH BC
    LD   A,1
    OUT  (0B4H),A
    LD   A,(MZ25_VRAM_DRAW_TILEMAP8_2P_BLOCK)
    OUT  (0B5H),A

    CALL MZ25_VRAM_DRAW_TILEMAP8_2P_PLANE_PROC

    LD   A,(MZ25_VRAM_DRAW_TILEMAP8_2P_BLOCK)
    ADD  A,2
    LD   (MZ25_VRAM_DRAW_TILEMAP8_2P_BLOCK),A
    LD   HL,(MZ25_VRAM_DRAW_TILEMAP8_2P_TABLE)
    LD   A,(MZ25_VRAM_DRAW_TILEMAP8_2P_TABLE_STEP)
    LD   E,A
    LD   D,0
    ADD  HL,DE
    LD   (MZ25_VRAM_DRAW_TILEMAP8_2P_TABLE),HL
    POP  BC
    DEC  C
    JR   NZ,MZ25_VRAM_DRAW_TILEMAP8_2P_PLANE

    LD   A,1
    OUT  (0B4H),A
    LD   A,(MZ25_VRAM_DRAW_TILEMAP8_2P_SAVE)
    OUT  (0B5H),A
    EI
    JP   MZ25_VRAM_DRAW_TILEMAP8_2P_END

MZ25_VRAM_DRAW_TILEMAP8_2P_PLANE_PROC:
    LD   HL,(MZ25_VRAM_DRAW_TILEMAP8_2P_MAP_BASE)
    LD   A,(MZ25_VRAM_DRAW_TILEMAP8_2P_VIEW_Y)
    OR   A
    JR   Z,MZ25_VRAM_DRAW_TILEMAP8_2P_MAP_ADD_X
    LD   B,A
MZ25_VRAM_DRAW_TILEMAP8_2P_MAP_Y_LOOP:
    LD   A,(MZ25_VRAM_DRAW_TILEMAP8_2P_MAP_W)
    LD   E,A
    LD   D,0
    ADD  HL,DE
    DJNZ MZ25_VRAM_DRAW_TILEMAP8_2P_MAP_Y_LOOP
MZ25_VRAM_DRAW_TILEMAP8_2P_MAP_ADD_X:
    LD   A,(MZ25_VRAM_DRAW_TILEMAP8_2P_VIEW_X)
    LD   E,A
    LD   D,0
    ADD  HL,DE
    LD   (MZ25_VRAM_DRAW_TILEMAP8_2P_MAP_ROW),HL

    CALL MZ25_VRAM_DRAW_TILEMAP8_2P_CALC_DEST
    LD   (MZ25_VRAM_DRAW_TILEMAP8_2P_DEST_ROW),HL
    LD   A,(MZ25_VRAM_DRAW_TILEMAP8_2P_VIEW_H)
MZ25_VRAM_DRAW_TILEMAP8_2P_TILE_ROW:
    LD   (MZ25_VRAM_DRAW_TILEMAP8_2P_ROW_COUNT),A
    LD   HL,(MZ25_VRAM_DRAW_TILEMAP8_2P_MAP_ROW)
    LD   (MZ25_VRAM_DRAW_TILEMAP8_2P_MAP_PTR),HL
    LD   HL,(MZ25_VRAM_DRAW_TILEMAP8_2P_DEST_ROW)
    LD   (MZ25_VRAM_DRAW_TILEMAP8_2P_DEST_PTR),HL
    LD   A,(MZ25_VRAM_DRAW_TILEMAP8_2P_VIEW_W)
MZ25_VRAM_DRAW_TILEMAP8_2P_TILE_COL:
    LD   (MZ25_VRAM_DRAW_TILEMAP8_2P_COL_COUNT),A

    LD   HL,(MZ25_VRAM_DRAW_TILEMAP8_2P_MAP_PTR)
    LD   A,(HL)
    INC  HL
    LD   (MZ25_VRAM_DRAW_TILEMAP8_2P_MAP_PTR),HL

    LD   L,A
    LD   H,0
    ADD  HL,HL
    LD   DE,(MZ25_VRAM_DRAW_TILEMAP8_2P_TABLE)
    ADD  HL,DE
    LD   E,(HL)
    INC  HL
    LD   D,(HL)

    LD   HL,(MZ25_VRAM_DRAW_TILEMAP8_2P_DEST_PTR)
    LD   B,8
MZ25_VRAM_DRAW_TILEMAP8_2P_TILE_BYTE:
    LD   A,(DE)
    LD   (HL),A
    INC  DE
    PUSH DE
    LD   DE,40
    ADD  HL,DE
    POP  DE
    DJNZ MZ25_VRAM_DRAW_TILEMAP8_2P_TILE_BYTE

    LD   HL,(MZ25_VRAM_DRAW_TILEMAP8_2P_DEST_PTR)
    INC  HL
    LD   (MZ25_VRAM_DRAW_TILEMAP8_2P_DEST_PTR),HL
    LD   A,(MZ25_VRAM_DRAW_TILEMAP8_2P_COL_COUNT)
    DEC  A
    JR   NZ,MZ25_VRAM_DRAW_TILEMAP8_2P_TILE_COL

    LD   HL,(MZ25_VRAM_DRAW_TILEMAP8_2P_MAP_ROW)
    LD   A,(MZ25_VRAM_DRAW_TILEMAP8_2P_MAP_W)
    LD   E,A
    LD   D,0
    ADD  HL,DE
    LD   (MZ25_VRAM_DRAW_TILEMAP8_2P_MAP_ROW),HL
    LD   HL,(MZ25_VRAM_DRAW_TILEMAP8_2P_DEST_ROW)
    LD   DE,320
    ADD  HL,DE
    LD   (MZ25_VRAM_DRAW_TILEMAP8_2P_DEST_ROW),HL
    LD   A,(MZ25_VRAM_DRAW_TILEMAP8_2P_ROW_COUNT)
    DEC  A
    JR   NZ,MZ25_VRAM_DRAW_TILEMAP8_2P_TILE_ROW
    RET

MZ25_VRAM_DRAW_TILEMAP8_2P_CALC_DEST:
    LD   HL,2000H
    LD   A,(MZ25_VRAM_DRAW_TILEMAP8_2P_SY)
    OR   A
    JR   Z,MZ25_VRAM_DRAW_TILEMAP8_2P_ADD_X
    LD   B,A
    LD   DE,40
MZ25_VRAM_DRAW_TILEMAP8_2P_Y_LOOP:
    ADD  HL,DE
    DJNZ MZ25_VRAM_DRAW_TILEMAP8_2P_Y_LOOP
MZ25_VRAM_DRAW_TILEMAP8_2P_ADD_X:
    LD   A,(MZ25_VRAM_DRAW_TILEMAP8_2P_SXBYTE)
    LD   E,A
    LD   D,0
    ADD  HL,DE
    RET

MZ25_VRAM_DRAW_TILEMAP8_2P_SAVE:
    DB   0
MZ25_VRAM_DRAW_TILEMAP8_2P_BLOCK:
    DB   0
MZ25_VRAM_DRAW_TILEMAP8_2P_SXBYTE:
    DB   0
MZ25_VRAM_DRAW_TILEMAP8_2P_SY:
    DB   0
MZ25_VRAM_DRAW_TILEMAP8_2P_VIEW_X:
    DB   0
MZ25_VRAM_DRAW_TILEMAP8_2P_VIEW_Y:
    DB   0
MZ25_VRAM_DRAW_TILEMAP8_2P_MAP_W:
    DB   0
MZ25_VRAM_DRAW_TILEMAP8_2P_VIEW_W:
    DB   0
MZ25_VRAM_DRAW_TILEMAP8_2P_VIEW_H:
    DB   0
MZ25_VRAM_DRAW_TILEMAP8_2P_TABLE_STEP:
    DB   0
MZ25_VRAM_DRAW_TILEMAP8_2P_TABLE:
    DW   0
MZ25_VRAM_DRAW_TILEMAP8_2P_MAP_BASE:
    DW   0
MZ25_VRAM_DRAW_TILEMAP8_2P_ROW_COUNT:
    DB   0
MZ25_VRAM_DRAW_TILEMAP8_2P_COL_COUNT:
    DB   0
MZ25_VRAM_DRAW_TILEMAP8_2P_MAP_ROW:
    DW   0
MZ25_VRAM_DRAW_TILEMAP8_2P_MAP_PTR:
    DW   0
MZ25_VRAM_DRAW_TILEMAP8_2P_DEST_ROW:
    DW   0
MZ25_VRAM_DRAW_TILEMAP8_2P_DEST_PTR:
    DW   0
MZ25_VRAM_DRAW_TILEMAP8_2P_END:
    #END
}

// 設定配列を使って、タイル番号マップから8x8タイル矩形を高速描画する。
// PARAM[0] = MAPADR, PARAM[1] = TILETBL, PARAM[2] = PAGE, PARAM[3] = SXBYTE,
// PARAM[4] = SY, PARAM[5] = VIEW_X, PARAM[6] = VIEW_Y, PARAM[7] = MAP_W,
// PARAM[8] = VIEW_W, PARAM[9] = VIEW_H, PARAM[10] = TILE_COUNT。
MZ25_VRAM_DRAW_TILEMAP8_2P_PARAM(WORD P)
VAR WORD PARAM[];
{
    PARAM = P;

    ^HL = PARAM[0];
    #ASM
    LD   HL,(_HL)
    LD   (MZ25_VRAM_DRAW_TILEMAP8_2P_MAP_BASE),HL
    #END

    ^HL = PARAM[1];
    #ASM
    LD   HL,(_HL)
    LD   (MZ25_VRAM_DRAW_TILEMAP8_2P_TABLE),HL
    #END

    ^A = PARAM[2];
    #ASM
    LD   A,(_A)
    AND  03H
    LD   C,A
    AND  01H
    LD   B,A
    LD   A,C
    AND  02H
    ADD  A,A
    ADD  A,A
    ADD  A,B
    ADD  A,20H
    LD   (MZ25_VRAM_DRAW_TILEMAP8_2P_BLOCK),A
    #END

    ^A = PARAM[3];
    #ASM
    LD   A,(_A)
    LD   (MZ25_VRAM_DRAW_TILEMAP8_2P_SXBYTE),A
    #END

    ^A = PARAM[4];
    #ASM
    LD   A,(_A)
    LD   (MZ25_VRAM_DRAW_TILEMAP8_2P_SY),A
    #END

    ^A = PARAM[5];
    #ASM
    LD   A,(_A)
    LD   (MZ25_VRAM_DRAW_TILEMAP8_2P_VIEW_X),A
    #END

    ^A = PARAM[6];
    #ASM
    LD   A,(_A)
    LD   (MZ25_VRAM_DRAW_TILEMAP8_2P_VIEW_Y),A
    #END

    ^A = PARAM[7];
    #ASM
    LD   A,(_A)
    LD   (MZ25_VRAM_DRAW_TILEMAP8_2P_MAP_W),A
    #END

    ^A = PARAM[8];
    #ASM
    LD   A,(_A)
    LD   (MZ25_VRAM_DRAW_TILEMAP8_2P_VIEW_W),A
    #END

    ^A = PARAM[9];
    #ASM
    LD   A,(_A)
    LD   (MZ25_VRAM_DRAW_TILEMAP8_2P_VIEW_H),A
    #END

    ^A = PARAM[10];
    #ASM
    LD   A,(_A)
    ADD  A,A
    LD   (MZ25_VRAM_DRAW_TILEMAP8_2P_TABLE_STEP),A

    DI
    LD   A,1
    OUT  (0B4H),A
    IN   A,(0B5H)
    LD   (MZ25_VRAM_DRAW_TILEMAP8_2P_SAVE),A

    LD   C,2
MZ25_VRAM_DRAW_TILEMAP8_2P_PARAM_PLANE:
    PUSH BC
    LD   A,1
    OUT  (0B4H),A
    LD   A,(MZ25_VRAM_DRAW_TILEMAP8_2P_BLOCK)
    OUT  (0B5H),A

    CALL MZ25_VRAM_DRAW_TILEMAP8_2P_PLANE_PROC

    LD   A,(MZ25_VRAM_DRAW_TILEMAP8_2P_BLOCK)
    ADD  A,2
    LD   (MZ25_VRAM_DRAW_TILEMAP8_2P_BLOCK),A
    LD   HL,(MZ25_VRAM_DRAW_TILEMAP8_2P_TABLE)
    LD   A,(MZ25_VRAM_DRAW_TILEMAP8_2P_TABLE_STEP)
    LD   E,A
    LD   D,0
    ADD  HL,DE
    LD   (MZ25_VRAM_DRAW_TILEMAP8_2P_TABLE),HL
    POP  BC
    DEC  C
    JR   NZ,MZ25_VRAM_DRAW_TILEMAP8_2P_PARAM_PLANE

    LD   A,1
    OUT  (0B4H),A
    LD   A,(MZ25_VRAM_DRAW_TILEMAP8_2P_SAVE)
    OUT  (0B5H),A
    EI
MZ25_VRAM_DRAW_TILEMAP8_2P_PARAM_END:
    #END
}

// PARAM設定を使って、マップ上のタイル番号から8x8タイルを2プレーンだけ描画する。
MZ25_VRAM_PUT_MAP_TILE8_2P_PARAM(WORD P, BYTE XBYTE, BYTE Y, BYTE T)
VAR WORD PARAM[];
VAR WORD TABLE[];
{
    PARAM = P;
    TABLE = PARAM[1];
    MZ25_VRAM_PUT_TILE8_2P(PARAM[2], XBYTE, Y, TABLE[T]);
}

// PARAM設定を使って、マップ上のタイル番号から横4ドット分を2プレーンだけ描画する。
MZ25_VRAM_PUT_MAP_TILE4_2P_PARAM(WORD P, BYTE XBYTE, BYTE Y, BYTE T, BYTE MODE)
VAR WORD PARAM[];
VAR WORD TABLE[];
{
    PARAM = P;
    TABLE = PARAM[1];
    MZ25_VRAM_PUT_TILE4_2P(PARAM[2], XBYTE, Y, TABLE[T], MODE);
}

// PARAM設定を使って、マップ上のタイル番号から縦4ライン分を2プレーンだけ描画する。
MZ25_VRAM_PUT_MAP_TILE_V4_2P_PARAM(WORD P, BYTE XBYTE, BYTE Y, BYTE T, BYTE MODE)
VAR WORD PARAM[];
VAR WORD TABLE[];
{
    PARAM = P;
    TABLE = PARAM[1];
    MZ25_VRAM_PUT_TILE_V4_2P(PARAM[2], XBYTE, Y, TABLE[T], MODE);
}

// PARAM設定を使って、マップ上のタイル番号から4x4ドット分を2プレーンだけ描画する。
MZ25_VRAM_PUT_MAP_TILE_4X4_2P_PARAM(WORD P, BYTE XBYTE, BYTE Y, BYTE T, BYTE MODE)
VAR WORD PARAM[];
VAR WORD TABLE[];
{
    PARAM = P;
    TABLE = PARAM[1];
    MZ25_VRAM_PUT_TILE_4X4_2P(PARAM[2], XBYTE, Y, TABLE[T], MODE);
}

// PARAM設定を使って、表示範囲の端1列へ横4ドット分を2プレーンだけ補充する。
MZ25_VRAM_DRAW_MAP_HALF_COL_2P_PARAM(WORD P, BYTE MAP_COL, BYTE DST_COL, BYTE MODE)
VAR WORD PARAM[];
VAR BYTE MAP[];
VAR Y, I;
{
    PARAM = P;
    MAP = PARAM[0];
    FOR Y = 0 TO PARAM[9] - 1 {
        I = (PARAM[6] + Y) * PARAM[7] + MAP_COL;
        MZ25_VRAM_PUT_MAP_TILE4_2P_PARAM(P, PARAM[3] + DST_COL, PARAM[4] + Y * 8, MAP[I], MODE);
    }
}

// PARAM設定を使って、表示範囲の端1行へ縦4ライン分を2プレーンだけ補充する。
MZ25_VRAM_DRAW_MAP_HALF_ROW_2P_PARAM(WORD P, BYTE MAP_ROW, BYTE DST_Y, BYTE MODE)
VAR WORD PARAM[];
VAR BYTE MAP[];
VAR X, I;
{
    PARAM = P;
    MAP = PARAM[0];
    FOR X = 0 TO PARAM[8] - 1 {
        I = MAP_ROW * PARAM[7] + PARAM[5] + X;
        MZ25_VRAM_PUT_MAP_TILE_V4_2P_PARAM(P, PARAM[3] + X, PARAM[4] + DST_Y, MAP[I], MODE);
    }
}

// 横4ドットずれ状態で、表示範囲の端1行を2プレーンの4x4合成で補充する。
MZ25_VRAM_DRAW_MAP_HALF_ROW_XSHIFT_2P_PARAM(WORD P, BYTE MAP_ROW, BYTE DST_Y, BYTE VMODE)
VAR WORD PARAM[];
VAR BYTE MAP[];
VAR X, I, M1, M2;
{
    PARAM = P;
    MAP = PARAM[0];
    M1 = VMODE * 4 + 2;
    M2 = VMODE * 4 + 1;
    FOR X = 0 TO PARAM[8] - 1 {
        I = MAP_ROW * PARAM[7] + PARAM[5] + X;
        MZ25_VRAM_PUT_MAP_TILE_4X4_2P_PARAM(P, PARAM[3] + X, PARAM[4] + DST_Y, MAP[I], M1);
        I = MAP_ROW * PARAM[7] + PARAM[5] + X + 1;
        MZ25_VRAM_PUT_MAP_TILE_4X4_2P_PARAM(P, PARAM[3] + X, PARAM[4] + DST_Y, MAP[I], M2);
    }
}

// 縦4ラインずれ状態で、表示範囲の端1列を2プレーンの4x4合成で補充する。
MZ25_VRAM_DRAW_MAP_HALF_COL_YSHIFT_2P_PARAM(WORD P, BYTE MAP_COL, BYTE DST_COL, BYTE HMODE)
VAR WORD PARAM[];
VAR BYTE MAP[];
VAR Y, I, M1, M2;
{
    PARAM = P;
    MAP = PARAM[0];
    M1 = 4 + HMODE;
    M2 = HMODE;
    FOR Y = 0 TO PARAM[9] - 1 {
        I = (PARAM[6] + Y) * PARAM[7] + MAP_COL;
        MZ25_VRAM_PUT_MAP_TILE_4X4_2P_PARAM(P, PARAM[3] + DST_COL, PARAM[4] + Y * 8, MAP[I], M1);
        I = (PARAM[6] + Y + 1) * PARAM[7] + MAP_COL;
        MZ25_VRAM_PUT_MAP_TILE_4X4_2P_PARAM(P, PARAM[3] + DST_COL, PARAM[4] + Y * 8 + 4, MAP[I], M2);
    }
}


// 320x200x16色ページ間で矩形をコピーする。
// マップレジスタ1を読み元(2000H-3FFFH)、マップレジスタ2を書き先(4000H-5FFFH)として使う。
// XBYTE と WBYTE は8ドット単位。4プレーン(B/R/G/I)をコピーする。
MZ25_VRAM_COPY_RECT(BYTE SRC_PAGE, BYTE DST_PAGE, BYTE XBYTE, BYTE Y, BYTE WBYTE, BYTE H)
{
    ^A = SRC_PAGE;
    #ASM
    LD   A,(_A)
    AND  03H
    LD   C,A
    AND  01H
    LD   B,A
    LD   A,C
    AND  02H
    ADD  A,A
    ADD  A,A
    ADD  A,B
    ADD  A,20H
    LD   (MZ25_VRAM_COPY_RECT_SRC_BLOCK),A
    #END

    ^A = DST_PAGE;
    #ASM
    LD   A,(_A)
    AND  03H
    LD   C,A
    AND  01H
    LD   B,A
    LD   A,C
    AND  02H
    ADD  A,A
    ADD  A,A
    ADD  A,B
    ADD  A,20H
    LD   (MZ25_VRAM_COPY_RECT_DST_BLOCK),A
    #END

    ^A = XBYTE;
    #ASM
    LD   A,(_A)
    LD   (MZ25_VRAM_COPY_RECT_XBYTE),A
    #END

    ^A = Y;
    #ASM
    LD   A,(_A)
    LD   (MZ25_VRAM_COPY_RECT_Y),A
    #END

    ^A = WBYTE;
    #ASM
    LD   A,(_A)
    LD   (MZ25_VRAM_COPY_RECT_WBYTE),A
    #END

    ^A = H;
    #ASM
    LD   A,(_A)
    LD   (MZ25_VRAM_COPY_RECT_H),A

    LD   A,(MZ25_VRAM_COPY_RECT_H)
    OR   A
    JP   Z,MZ25_VRAM_COPY_RECT_END
    LD   A,(MZ25_VRAM_COPY_RECT_WBYTE)
    OR   A
    JP   Z,MZ25_VRAM_COPY_RECT_END

    DI
    LD   A,1
    OUT  (0B4H),A
    IN   A,(0B5H)
    LD   (MZ25_VRAM_COPY_RECT_SAVE1),A
    LD   A,2
    OUT  (0B4H),A
    IN   A,(0B5H)
    LD   (MZ25_VRAM_COPY_RECT_SAVE2),A

    LD   B,4
MZ25_VRAM_COPY_RECT_PLANE:
    PUSH BC
    LD   A,1
    OUT  (0B4H),A
    LD   A,(MZ25_VRAM_COPY_RECT_SRC_BLOCK)
    OUT  (0B5H),A
    LD   A,2
    OUT  (0B4H),A
    LD   A,(MZ25_VRAM_COPY_RECT_DST_BLOCK)
    OUT  (0B5H),A

    CALL MZ25_VRAM_COPY_RECT_BLOCK_PROC

    LD   A,(MZ25_VRAM_COPY_RECT_SRC_BLOCK)
    ADD  A,2
    LD   (MZ25_VRAM_COPY_RECT_SRC_BLOCK),A
    LD   A,(MZ25_VRAM_COPY_RECT_DST_BLOCK)
    ADD  A,2
    LD   (MZ25_VRAM_COPY_RECT_DST_BLOCK),A
    POP  BC
    DJNZ MZ25_VRAM_COPY_RECT_PLANE

    LD   A,1
    OUT  (0B4H),A
    LD   A,(MZ25_VRAM_COPY_RECT_SAVE1)
    OUT  (0B5H),A
    LD   A,2
    OUT  (0B4H),A
    LD   A,(MZ25_VRAM_COPY_RECT_SAVE2)
    OUT  (0B5H),A
    EI
    JR   MZ25_VRAM_COPY_RECT_END

MZ25_VRAM_COPY_RECT_BLOCK_PROC:
    LD   H,0
    LD   A,(MZ25_VRAM_COPY_RECT_Y)
    LD   L,A
    ADD  HL,HL
    ADD  HL,HL
    ADD  HL,HL
    LD   D,H
    LD   E,L
    ADD  HL,HL
    ADD  HL,HL
    ADD  HL,DE
    LD   D,0
    LD   A,(MZ25_VRAM_COPY_RECT_XBYTE)
    LD   E,A
    ADD  HL,DE
    LD   DE,2000H
    ADD  HL,DE
    LD   D,H
    LD   E,L
    LD   BC,2000H
    EX   DE,HL
    ADD  HL,BC
    EX   DE,HL

    LD   A,(MZ25_VRAM_COPY_RECT_H)
MZ25_VRAM_COPY_RECT_LINE:
    LD   (MZ25_VRAM_COPY_RECT_LINECOUNT),A
    PUSH HL
    PUSH DE
    LD   B,0
    LD   A,(MZ25_VRAM_COPY_RECT_WBYTE)
    LD   C,A
    LDIR
    POP  DE
    POP  HL
    LD   BC,40
    ADD  HL,BC
    EX   DE,HL
    LD   BC,40
    ADD  HL,BC
    EX   DE,HL
    LD   A,(MZ25_VRAM_COPY_RECT_LINECOUNT)
    DEC  A
    JR   NZ,MZ25_VRAM_COPY_RECT_LINE
    RET

MZ25_VRAM_COPY_RECT_XBYTE:
    DB   0
MZ25_VRAM_COPY_RECT_Y:
    DB   0
MZ25_VRAM_COPY_RECT_WBYTE:
    DB   0
MZ25_VRAM_COPY_RECT_H:
    DB   0
MZ25_VRAM_COPY_RECT_LINECOUNT:
    DB   0
MZ25_VRAM_COPY_RECT_SRC_BLOCK:
    DB   0
MZ25_VRAM_COPY_RECT_DST_BLOCK:
    DB   0
MZ25_VRAM_COPY_RECT_SAVE1:
    DB   0
MZ25_VRAM_COPY_RECT_SAVE2:
    DB   0
MZ25_VRAM_COPY_RECT_END:
    #END
}

// 320x200x16色ページ間で矩形を2プレーン(B/R)だけコピーする。
MZ25_VRAM_COPY_RECT_2P(BYTE SRC_PAGE, BYTE DST_PAGE, BYTE XBYTE, BYTE Y, BYTE WBYTE, BYTE H)
{
    ^A = SRC_PAGE;
    #ASM
    LD   A,(_A)
    AND  03H
    LD   C,A
    AND  01H
    LD   B,A
    LD   A,C
    AND  02H
    ADD  A,A
    ADD  A,A
    ADD  A,B
    ADD  A,20H
    LD   (MZ25_VRAM_COPY_RECT_2P_SRC_BLOCK),A
    #END

    ^A = DST_PAGE;
    #ASM
    LD   A,(_A)
    AND  03H
    LD   C,A
    AND  01H
    LD   B,A
    LD   A,C
    AND  02H
    ADD  A,A
    ADD  A,A
    ADD  A,B
    ADD  A,20H
    LD   (MZ25_VRAM_COPY_RECT_2P_DST_BLOCK),A
    #END

    ^A = XBYTE;
    #ASM
    LD   A,(_A)
    LD   (MZ25_VRAM_COPY_RECT_2P_XBYTE),A
    #END

    ^A = Y;
    #ASM
    LD   A,(_A)
    LD   (MZ25_VRAM_COPY_RECT_2P_Y),A
    #END

    ^A = WBYTE;
    #ASM
    LD   A,(_A)
    LD   (MZ25_VRAM_COPY_RECT_2P_WBYTE),A
    #END

    ^A = H;
    #ASM
    LD   A,(_A)
    LD   (MZ25_VRAM_COPY_RECT_2P_H),A

    LD   A,(MZ25_VRAM_COPY_RECT_2P_H)
    OR   A
    JP   Z,MZ25_VRAM_COPY_RECT_2P_END
    LD   A,(MZ25_VRAM_COPY_RECT_2P_WBYTE)
    OR   A
    JP   Z,MZ25_VRAM_COPY_RECT_2P_END

    DI
    LD   A,1
    OUT  (0B4H),A
    IN   A,(0B5H)
    LD   (MZ25_VRAM_COPY_RECT_2P_SAVE1),A
    LD   A,2
    OUT  (0B4H),A
    IN   A,(0B5H)
    LD   (MZ25_VRAM_COPY_RECT_2P_SAVE2),A

    LD   B,2
MZ25_VRAM_COPY_RECT_2P_PLANE:
    PUSH BC
    LD   A,1
    OUT  (0B4H),A
    LD   A,(MZ25_VRAM_COPY_RECT_2P_SRC_BLOCK)
    OUT  (0B5H),A
    LD   A,2
    OUT  (0B4H),A
    LD   A,(MZ25_VRAM_COPY_RECT_2P_DST_BLOCK)
    OUT  (0B5H),A

    CALL MZ25_VRAM_COPY_RECT_2P_BLOCK_PROC

    LD   A,(MZ25_VRAM_COPY_RECT_2P_SRC_BLOCK)
    ADD  A,2
    LD   (MZ25_VRAM_COPY_RECT_2P_SRC_BLOCK),A
    LD   A,(MZ25_VRAM_COPY_RECT_2P_DST_BLOCK)
    ADD  A,2
    LD   (MZ25_VRAM_COPY_RECT_2P_DST_BLOCK),A
    POP  BC
    DJNZ MZ25_VRAM_COPY_RECT_2P_PLANE

    LD   A,1
    OUT  (0B4H),A
    LD   A,(MZ25_VRAM_COPY_RECT_2P_SAVE1)
    OUT  (0B5H),A
    LD   A,2
    OUT  (0B4H),A
    LD   A,(MZ25_VRAM_COPY_RECT_2P_SAVE2)
    OUT  (0B5H),A
    EI
    JR   MZ25_VRAM_COPY_RECT_2P_END

MZ25_VRAM_COPY_RECT_2P_BLOCK_PROC:
    LD   H,0
    LD   A,(MZ25_VRAM_COPY_RECT_2P_Y)
    LD   L,A
    ADD  HL,HL
    ADD  HL,HL
    ADD  HL,HL
    LD   D,H
    LD   E,L
    ADD  HL,HL
    ADD  HL,HL
    ADD  HL,DE
    LD   D,0
    LD   A,(MZ25_VRAM_COPY_RECT_2P_XBYTE)
    LD   E,A
    ADD  HL,DE
    LD   DE,2000H
    ADD  HL,DE
    LD   D,H
    LD   E,L
    LD   BC,2000H
    EX   DE,HL
    ADD  HL,BC
    EX   DE,HL

    LD   A,(MZ25_VRAM_COPY_RECT_2P_H)
MZ25_VRAM_COPY_RECT_2P_LINE:
    LD   (MZ25_VRAM_COPY_RECT_2P_LINECOUNT),A
    PUSH HL
    PUSH DE
    LD   B,0
    LD   A,(MZ25_VRAM_COPY_RECT_2P_WBYTE)
    LD   C,A
    LDIR
    POP  DE
    POP  HL
    LD   BC,40
    ADD  HL,BC
    EX   DE,HL
    LD   BC,40
    ADD  HL,BC
    EX   DE,HL
    LD   A,(MZ25_VRAM_COPY_RECT_2P_LINECOUNT)
    DEC  A
    JR   NZ,MZ25_VRAM_COPY_RECT_2P_LINE
    RET

MZ25_VRAM_COPY_RECT_2P_XBYTE:
    DB   0
MZ25_VRAM_COPY_RECT_2P_Y:
    DB   0
MZ25_VRAM_COPY_RECT_2P_WBYTE:
    DB   0
MZ25_VRAM_COPY_RECT_2P_H:
    DB   0
MZ25_VRAM_COPY_RECT_2P_LINECOUNT:
    DB   0
MZ25_VRAM_COPY_RECT_2P_SRC_BLOCK:
    DB   0
MZ25_VRAM_COPY_RECT_2P_DST_BLOCK:
    DB   0
MZ25_VRAM_COPY_RECT_2P_SAVE1:
    DB   0
MZ25_VRAM_COPY_RECT_2P_SAVE2:
    DB   0
MZ25_VRAM_COPY_RECT_2P_END:
    #END
}


// 8x8ドットパターンをOR合成で描画する。
// タイルデータは32バイト構成。B/R/G/I の順に各8バイト。
// PAGE: 0..3, XBYTE: 0..39, Y: 0..192, TADR: パターンデータ先頭アドレス。
MZ25_VRAM_OR_PATTERN8(BYTE PAGE, BYTE XBYTE, BYTE Y, WORD TADR)
{
    ^A = PAGE;
    #ASM
    LD   A,(_A)
    AND  03H
    LD   C,A
    AND  01H
    LD   B,A
    LD   A,C
    AND  02H
    ADD  A,A
    ADD  A,A
    ADD  A,B
    ADD  A,20H
    LD   (MZ25_VRAM_OR_PATTERN8_BLOCK),A
    #END

    ^A = XBYTE;
    #ASM
    LD   A,(_A)
    LD   (MZ25_VRAM_OR_PATTERN8_XBYTE),A
    #END

    ^A = Y;
    #ASM
    LD   A,(_A)
    LD   (MZ25_VRAM_OR_PATTERN8_Y),A
    #END

    ^HL = TADR;
    #ASM
    LD   HL,(_HL)
    LD   (MZ25_VRAM_OR_PATTERN8_SRC),HL

    DI
    LD   A,1
    OUT  (0B4H),A
    IN   A,(0B5H)
    LD   (MZ25_VRAM_OR_PATTERN8_SAVE),A

    LD   B,4
MZ25_VRAM_OR_PATTERN8_PLANE_LOOP:
    PUSH BC
    LD   A,1
    OUT  (0B4H),A
    LD   A,(MZ25_VRAM_OR_PATTERN8_BLOCK)
    OUT  (0B5H),A

    CALL MZ25_VRAM_OR_PATTERN8_PLANE

    LD   A,(MZ25_VRAM_OR_PATTERN8_BLOCK)
    ADD  A,2
    LD   (MZ25_VRAM_OR_PATTERN8_BLOCK),A
    POP  BC
    DJNZ MZ25_VRAM_OR_PATTERN8_PLANE_LOOP

    LD   A,1
    OUT  (0B4H),A
    LD   A,(MZ25_VRAM_OR_PATTERN8_SAVE)
    OUT  (0B5H),A
    EI
    JR   MZ25_VRAM_OR_PATTERN8_END

MZ25_VRAM_OR_PATTERN8_PLANE:
    CALL MZ25_VRAM_OR_PATTERN8_CALC_DEST
    EX   DE,HL
    LD   HL,(MZ25_VRAM_OR_PATTERN8_SRC)
    LD   B,8
MZ25_VRAM_OR_PATTERN8_ROW:
    LD   A,(HL)
    LD   C,A
    LD   A,(DE)
    OR   C
    LD   (DE),A
    INC  HL
    PUSH HL
    LD   HL,40
    ADD  HL,DE
    EX   DE,HL
    POP  HL
    DJNZ MZ25_VRAM_OR_PATTERN8_ROW
    LD   (MZ25_VRAM_OR_PATTERN8_SRC),HL
    RET

MZ25_VRAM_OR_PATTERN8_CALC_DEST:
    LD   HL,2000H
    LD   A,(MZ25_VRAM_OR_PATTERN8_Y)
    OR   A
    JR   Z,MZ25_VRAM_OR_PATTERN8_ADD_X
    LD   B,A
    LD   DE,40
MZ25_VRAM_OR_PATTERN8_Y_LOOP:
    ADD  HL,DE
    DJNZ MZ25_VRAM_OR_PATTERN8_Y_LOOP
MZ25_VRAM_OR_PATTERN8_ADD_X:
    LD   A,(MZ25_VRAM_OR_PATTERN8_XBYTE)
    LD   E,A
    LD   D,0
    ADD  HL,DE
    RET

MZ25_VRAM_OR_PATTERN8_SAVE:
    DB   0
MZ25_VRAM_OR_PATTERN8_BLOCK:
    DB   0
MZ25_VRAM_OR_PATTERN8_XBYTE:
    DB   0
MZ25_VRAM_OR_PATTERN8_Y:
    DB   0
MZ25_VRAM_OR_PATTERN8_SRC:
    DW   0
MZ25_VRAM_OR_PATTERN8_END:
    #END
}

// 16x16ドットパターンをOR合成で描画する。
// データは128バイト構成。B/R/G/I の順に、各プレーンは16ライン x 2バイト。
// PAGE: 0..3, XBYTE: 0..38, Y: 0..184, TADR: パターンデータ先頭アドレス。
MZ25_VRAM_OR_PATTERN16(BYTE PAGE, BYTE XBYTE, BYTE Y, WORD TADR)
{
    ^A = PAGE;
    #ASM
    LD   A,(_A)
    AND  03H
    LD   C,A
    AND  01H
    LD   B,A
    LD   A,C
    AND  02H
    ADD  A,A
    ADD  A,A
    ADD  A,B
    ADD  A,20H
    LD   (MZ25_VRAM_OR_PATTERN16_BLOCK),A
    #END

    ^A = XBYTE;
    #ASM
    LD   A,(_A)
    LD   (MZ25_VRAM_OR_PATTERN16_XBYTE),A
    #END

    ^A = Y;
    #ASM
    LD   A,(_A)
    LD   (MZ25_VRAM_OR_PATTERN16_Y),A
    #END

    ^HL = TADR;
    #ASM
    LD   HL,(_HL)
    LD   (MZ25_VRAM_OR_PATTERN16_SRC),HL

    DI
    LD   A,1
    OUT  (0B4H),A
    IN   A,(0B5H)
    LD   (MZ25_VRAM_OR_PATTERN16_SAVE),A

    LD   B,4
MZ25_VRAM_OR_PATTERN16_PLANE_LOOP:
    PUSH BC
    LD   A,1
    OUT  (0B4H),A
    LD   A,(MZ25_VRAM_OR_PATTERN16_BLOCK)
    OUT  (0B5H),A

    CALL MZ25_VRAM_OR_PATTERN16_PLANE

    LD   A,(MZ25_VRAM_OR_PATTERN16_BLOCK)
    ADD  A,2
    LD   (MZ25_VRAM_OR_PATTERN16_BLOCK),A
    POP  BC
    DJNZ MZ25_VRAM_OR_PATTERN16_PLANE_LOOP

    LD   A,1
    OUT  (0B4H),A
    LD   A,(MZ25_VRAM_OR_PATTERN16_SAVE)
    OUT  (0B5H),A
    EI
    JR   MZ25_VRAM_OR_PATTERN16_END

MZ25_VRAM_OR_PATTERN16_PLANE:
    CALL MZ25_VRAM_OR_PATTERN16_CALC_DEST
    EX   DE,HL
    LD   HL,(MZ25_VRAM_OR_PATTERN16_SRC)
    LD   B,16
MZ25_VRAM_OR_PATTERN16_ROW:
    LD   A,(HL)
    LD   C,A
    LD   A,(DE)
    OR   C
    LD   (DE),A
    INC  HL
    INC  DE
    LD   A,(HL)
    LD   C,A
    LD   A,(DE)
    OR   C
    LD   (DE),A
    INC  HL
    PUSH HL
    LD   HL,39
    ADD  HL,DE
    EX   DE,HL
    POP  HL
    DJNZ MZ25_VRAM_OR_PATTERN16_ROW
    LD   (MZ25_VRAM_OR_PATTERN16_SRC),HL
    RET

MZ25_VRAM_OR_PATTERN16_CALC_DEST:
    LD   HL,2000H
    LD   A,(MZ25_VRAM_OR_PATTERN16_Y)
    OR   A
    JR   Z,MZ25_VRAM_OR_PATTERN16_ADD_X
    LD   B,A
    LD   DE,40
MZ25_VRAM_OR_PATTERN16_Y_LOOP:
    ADD  HL,DE
    DJNZ MZ25_VRAM_OR_PATTERN16_Y_LOOP
MZ25_VRAM_OR_PATTERN16_ADD_X:
    LD   A,(MZ25_VRAM_OR_PATTERN16_XBYTE)
    LD   E,A
    LD   D,0
    ADD  HL,DE
    RET

MZ25_VRAM_OR_PATTERN16_SAVE:
    DB   0
MZ25_VRAM_OR_PATTERN16_BLOCK:
    DB   0
MZ25_VRAM_OR_PATTERN16_XBYTE:
    DB   0
MZ25_VRAM_OR_PATTERN16_Y:
    DB   0
MZ25_VRAM_OR_PATTERN16_SRC:
    DW   0
MZ25_VRAM_OR_PATTERN16_END:
    #END
}


// 8x8ドットパターンをマスク付きで描画する。
// 描画式: dst = (dst AND mask) OR pattern
// maskは8バイト。bit=1で背景を残し、bit=0でpatternを描く。
// patternは32バイト構成。B/R/G/I の順に各8バイト。
MZ25_VRAM_MASK_PATTERN8(BYTE PAGE, BYTE XBYTE, BYTE Y, WORD TADR, WORD MADR)
{
    ^A = PAGE;
    #ASM
    LD   A,(_A)
    AND  03H
    LD   C,A
    AND  01H
    LD   B,A
    LD   A,C
    AND  02H
    ADD  A,A
    ADD  A,A
    ADD  A,B
    ADD  A,20H
    LD   (MZ25_VRAM_MASK_PATTERN8_BLOCK),A
    #END

    ^A = XBYTE;
    #ASM
    LD   A,(_A)
    LD   (MZ25_VRAM_MASK_PATTERN8_XBYTE),A
    #END

    ^A = Y;
    #ASM
    LD   A,(_A)
    LD   (MZ25_VRAM_MASK_PATTERN8_Y),A
    #END

    ^HL = TADR;
    #ASM
    LD   HL,(_HL)
    LD   (MZ25_VRAM_MASK_PATTERN8_SRC),HL
    #END

    ^HL = MADR;
    #ASM
    LD   HL,(_HL)
    LD   (MZ25_VRAM_MASK_PATTERN8_MASK),HL

    DI
    LD   A,1
    OUT  (0B4H),A
    IN   A,(0B5H)
    LD   (MZ25_VRAM_MASK_PATTERN8_SAVE),A

    LD   B,4
MZ25_VRAM_MASK_PATTERN8_PLANE_LOOP:
    PUSH BC
    LD   A,1
    OUT  (0B4H),A
    LD   A,(MZ25_VRAM_MASK_PATTERN8_BLOCK)
    OUT  (0B5H),A

    CALL MZ25_VRAM_MASK_PATTERN8_PLANE

    LD   A,(MZ25_VRAM_MASK_PATTERN8_BLOCK)
    ADD  A,2
    LD   (MZ25_VRAM_MASK_PATTERN8_BLOCK),A
    POP  BC
    DJNZ MZ25_VRAM_MASK_PATTERN8_PLANE_LOOP

    LD   A,1
    OUT  (0B4H),A
    LD   A,(MZ25_VRAM_MASK_PATTERN8_SAVE)
    OUT  (0B5H),A
    EI
    JR   MZ25_VRAM_MASK_PATTERN8_END

MZ25_VRAM_MASK_PATTERN8_PLANE:
    CALL MZ25_VRAM_MASK_PATTERN8_CALC_DEST
    EX   DE,HL
    LD   HL,(MZ25_VRAM_MASK_PATTERN8_SRC)
    LD   IX,(MZ25_VRAM_MASK_PATTERN8_MASK)
    LD   B,8
MZ25_VRAM_MASK_PATTERN8_ROW:
    LD   A,(DE)
    AND  (IX+0)
    OR   (HL)
    LD   (DE),A
    INC  HL
    INC  IX
    PUSH HL
    LD   HL,40
    ADD  HL,DE
    EX   DE,HL
    POP  HL
    DJNZ MZ25_VRAM_MASK_PATTERN8_ROW
    LD   (MZ25_VRAM_MASK_PATTERN8_SRC),HL
    RET

MZ25_VRAM_MASK_PATTERN8_CALC_DEST:
    LD   HL,2000H
    LD   A,(MZ25_VRAM_MASK_PATTERN8_Y)
    OR   A
    JR   Z,MZ25_VRAM_MASK_PATTERN8_ADD_X
    LD   B,A
    LD   DE,40
MZ25_VRAM_MASK_PATTERN8_Y_LOOP:
    ADD  HL,DE
    DJNZ MZ25_VRAM_MASK_PATTERN8_Y_LOOP
MZ25_VRAM_MASK_PATTERN8_ADD_X:
    LD   A,(MZ25_VRAM_MASK_PATTERN8_XBYTE)
    LD   E,A
    LD   D,0
    ADD  HL,DE
    RET

MZ25_VRAM_MASK_PATTERN8_SAVE:
    DB   0
MZ25_VRAM_MASK_PATTERN8_BLOCK:
    DB   0
MZ25_VRAM_MASK_PATTERN8_XBYTE:
    DB   0
MZ25_VRAM_MASK_PATTERN8_Y:
    DB   0
MZ25_VRAM_MASK_PATTERN8_SRC:
    DW   0
MZ25_VRAM_MASK_PATTERN8_MASK:
    DW   0
MZ25_VRAM_MASK_PATTERN8_END:
    #END
}

// 16x16ドットパターンをマスク付きで描画する。
// maskは32バイト。1ライン2バイト x 16ライン。
// patternは128バイト構成。B/R/G/I の順に各32バイト。
MZ25_VRAM_MASK_PATTERN16(BYTE PAGE, BYTE XBYTE, BYTE Y, WORD TADR, WORD MADR)
{
    ^A = PAGE;
    #ASM
    LD   A,(_A)
    AND  03H
    LD   C,A
    AND  01H
    LD   B,A
    LD   A,C
    AND  02H
    ADD  A,A
    ADD  A,A
    ADD  A,B
    ADD  A,20H
    LD   (MZ25_VRAM_MASK_PATTERN16_BLOCK),A
    #END

    ^A = XBYTE;
    #ASM
    LD   A,(_A)
    LD   (MZ25_VRAM_MASK_PATTERN16_XBYTE),A
    #END

    ^A = Y;
    #ASM
    LD   A,(_A)
    LD   (MZ25_VRAM_MASK_PATTERN16_Y),A
    #END

    ^HL = TADR;
    #ASM
    LD   HL,(_HL)
    LD   (MZ25_VRAM_MASK_PATTERN16_SRC),HL
    #END

    ^HL = MADR;
    #ASM
    LD   HL,(_HL)
    LD   (MZ25_VRAM_MASK_PATTERN16_MASK),HL

    DI
    LD   A,1
    OUT  (0B4H),A
    IN   A,(0B5H)
    LD   (MZ25_VRAM_MASK_PATTERN16_SAVE),A

    LD   B,4
MZ25_VRAM_MASK_PATTERN16_PLANE_LOOP:
    PUSH BC
    LD   A,1
    OUT  (0B4H),A
    LD   A,(MZ25_VRAM_MASK_PATTERN16_BLOCK)
    OUT  (0B5H),A

    CALL MZ25_VRAM_MASK_PATTERN16_PLANE

    LD   A,(MZ25_VRAM_MASK_PATTERN16_BLOCK)
    ADD  A,2
    LD   (MZ25_VRAM_MASK_PATTERN16_BLOCK),A
    POP  BC
    DJNZ MZ25_VRAM_MASK_PATTERN16_PLANE_LOOP

    LD   A,1
    OUT  (0B4H),A
    LD   A,(MZ25_VRAM_MASK_PATTERN16_SAVE)
    OUT  (0B5H),A
    EI
    JR   MZ25_VRAM_MASK_PATTERN16_END

MZ25_VRAM_MASK_PATTERN16_PLANE:
    CALL MZ25_VRAM_MASK_PATTERN16_CALC_DEST
    EX   DE,HL
    LD   HL,(MZ25_VRAM_MASK_PATTERN16_SRC)
    LD   IX,(MZ25_VRAM_MASK_PATTERN16_MASK)
    LD   B,16
MZ25_VRAM_MASK_PATTERN16_ROW:
    LD   A,(DE)
    AND  (IX+0)
    OR   (HL)
    LD   (DE),A
    INC  HL
    INC  IX
    INC  DE
    LD   A,(DE)
    AND  (IX+0)
    OR   (HL)
    LD   (DE),A
    INC  HL
    INC  IX
    PUSH HL
    LD   HL,39
    ADD  HL,DE
    EX   DE,HL
    POP  HL
    DJNZ MZ25_VRAM_MASK_PATTERN16_ROW
    LD   (MZ25_VRAM_MASK_PATTERN16_SRC),HL
    RET

MZ25_VRAM_MASK_PATTERN16_CALC_DEST:
    LD   HL,2000H
    LD   A,(MZ25_VRAM_MASK_PATTERN16_Y)
    OR   A
    JR   Z,MZ25_VRAM_MASK_PATTERN16_ADD_X
    LD   B,A
    LD   DE,40
MZ25_VRAM_MASK_PATTERN16_Y_LOOP:
    ADD  HL,DE
    DJNZ MZ25_VRAM_MASK_PATTERN16_Y_LOOP
MZ25_VRAM_MASK_PATTERN16_ADD_X:
    LD   A,(MZ25_VRAM_MASK_PATTERN16_XBYTE)
    LD   E,A
    LD   D,0
    ADD  HL,DE
    RET

MZ25_VRAM_MASK_PATTERN16_SAVE:
    DB   0
MZ25_VRAM_MASK_PATTERN16_BLOCK:
    DB   0
MZ25_VRAM_MASK_PATTERN16_XBYTE:
    DB   0
MZ25_VRAM_MASK_PATTERN16_Y:
    DB   0
MZ25_VRAM_MASK_PATTERN16_SRC:
    DW   0
MZ25_VRAM_MASK_PATTERN16_MASK:
    DW   0
MZ25_VRAM_MASK_PATTERN16_END:
    #END
}


// 8x8ドットパターンを、Xドット単位指定でマスク付き描画する。
// 描画式: dst = (dst AND mask) OR pattern
// Xは0..312程度を想定。Xが8ドット境界でない場合は左右2バイトに分けて描画する。
// maskは8バイト。bit=1で背景を残し、bit=0でpatternを描く。
MZ25_VRAM_MASK_PATTERN8_X(BYTE PAGE, WORD X, BYTE Y, WORD TADR, WORD MADR)
{
    ^A = PAGE;
    #ASM
    LD   A,(_A)
    AND  03H
    LD   C,A
    AND  01H
    LD   B,A
    LD   A,C
    AND  02H
    ADD  A,A
    ADD  A,A
    ADD  A,B
    ADD  A,20H
    LD   (MZ25_VRAM_MASK_PATTERN8_X_BLOCK),A
    #END

    ^HL = X;
    #ASM
    LD   HL,(_HL)
    LD   A,L
    AND  07H
    LD   (MZ25_VRAM_MASK_PATTERN8_X_SHIFT),A
    SRL  H
    RR   L
    SRL  H
    RR   L
    SRL  H
    RR   L
    LD   A,L
    LD   (MZ25_VRAM_MASK_PATTERN8_X_XBYTE),A
    #END

    ^A = Y;
    #ASM
    LD   A,(_A)
    LD   (MZ25_VRAM_MASK_PATTERN8_X_Y),A
    #END

    ^HL = TADR;
    #ASM
    LD   HL,(_HL)
    LD   (MZ25_VRAM_MASK_PATTERN8_X_SRC),HL
    #END

    ^HL = MADR;
    #ASM
    LD   HL,(_HL)
    LD   (MZ25_VRAM_MASK_PATTERN8_X_MASK),HL

    DI
    LD   A,1
    OUT  (0B4H),A
    IN   A,(0B5H)
    LD   (MZ25_VRAM_MASK_PATTERN8_X_SAVE),A

    LD   B,4
MZ25_VRAM_MASK_PATTERN8_X_PLANE_LOOP:
    PUSH BC
    LD   A,1
    OUT  (0B4H),A
    LD   A,(MZ25_VRAM_MASK_PATTERN8_X_BLOCK)
    OUT  (0B5H),A

    CALL MZ25_VRAM_MASK_PATTERN8_X_PLANE

    LD   A,(MZ25_VRAM_MASK_PATTERN8_X_BLOCK)
    ADD  A,2
    LD   (MZ25_VRAM_MASK_PATTERN8_X_BLOCK),A
    POP  BC
    DJNZ MZ25_VRAM_MASK_PATTERN8_X_PLANE_LOOP

    LD   A,1
    OUT  (0B4H),A
    LD   A,(MZ25_VRAM_MASK_PATTERN8_X_SAVE)
    OUT  (0B5H),A
    EI
    JP   MZ25_VRAM_MASK_PATTERN8_X_END

MZ25_VRAM_MASK_PATTERN8_X_PLANE:
    CALL MZ25_VRAM_MASK_PATTERN8_X_CALC_DEST
    EX   DE,HL
    LD   HL,(MZ25_VRAM_MASK_PATTERN8_X_SRC)
    LD   IX,(MZ25_VRAM_MASK_PATTERN8_X_MASK)
    LD   B,8
MZ25_VRAM_MASK_PATTERN8_X_ROW:
    LD   A,(MZ25_VRAM_MASK_PATTERN8_X_SHIFT)
    OR   A
    JR   Z,MZ25_VRAM_MASK_PATTERN8_X_ROW_ALIGNED

    LD   A,(HL)
    LD   C,A
    LD   A,(IX+0)
    LD   (MZ25_VRAM_MASK_PATTERN8_X_MASKBYTE),A
    PUSH BC
    PUSH DE
    CALL MZ25_VRAM_MASK_PATTERN8_X_SHIFT_BYTES
    POP  DE
    POP  BC

    LD   A,(DE)
    LD   C,A
    LD   A,(MZ25_VRAM_MASK_PATTERN8_X_LMASK)
    AND  C
    LD   C,A
    LD   A,(MZ25_VRAM_MASK_PATTERN8_X_LPAT)
    OR   C
    LD   (DE),A

    INC  DE
    LD   A,(DE)
    LD   C,A
    LD   A,(MZ25_VRAM_MASK_PATTERN8_X_RMASK)
    AND  C
    LD   C,A
    LD   A,(MZ25_VRAM_MASK_PATTERN8_X_RPAT)
    OR   C
    LD   (DE),A
    DEC  DE
    JR   MZ25_VRAM_MASK_PATTERN8_X_NEXT_ROW

MZ25_VRAM_MASK_PATTERN8_X_ROW_ALIGNED:
    LD   A,(DE)
    AND  (IX+0)
    OR   (HL)
    LD   (DE),A

MZ25_VRAM_MASK_PATTERN8_X_NEXT_ROW:
    INC  HL
    INC  IX
    PUSH HL
    LD   HL,40
    ADD  HL,DE
    EX   DE,HL
    POP  HL
    DJNZ MZ25_VRAM_MASK_PATTERN8_X_ROW
    LD   (MZ25_VRAM_MASK_PATTERN8_X_SRC),HL
    RET

; C=pattern, MASKBYTE=mask, SHIFT=1..7
MZ25_VRAM_MASK_PATTERN8_X_SHIFT_BYTES:
    LD   A,(MZ25_VRAM_MASK_PATTERN8_X_SHIFT)
    LD   B,A
    LD   A,C
    LD   D,0
MZ25_VRAM_MASK_PATTERN8_X_PAT_SHIFT:
    SLA  A
    RL   D
    DJNZ MZ25_VRAM_MASK_PATTERN8_X_PAT_SHIFT
    LD   (MZ25_VRAM_MASK_PATTERN8_X_LPAT),A
    LD   A,D
    LD   (MZ25_VRAM_MASK_PATTERN8_X_RPAT),A

    LD   A,(MZ25_VRAM_MASK_PATTERN8_X_SHIFT)
    LD   B,A
    LD   A,(MZ25_VRAM_MASK_PATTERN8_X_MASKBYTE)
    LD   D,0
MZ25_VRAM_MASK_PATTERN8_X_MASK_SHIFT:
    SLA  A
    RL   D
    DJNZ MZ25_VRAM_MASK_PATTERN8_X_MASK_SHIFT
    LD   C,A
    LD   A,(MZ25_VRAM_MASK_PATTERN8_X_SHIFT)
    LD   B,A
    XOR  A
MZ25_VRAM_MASK_PATTERN8_X_LKEEP:
    SCF
    RLA
    DJNZ MZ25_VRAM_MASK_PATTERN8_X_LKEEP
    OR   C
    LD   (MZ25_VRAM_MASK_PATTERN8_X_LMASK),A

    LD   A,(MZ25_VRAM_MASK_PATTERN8_X_SHIFT)
    LD   B,A
    LD   A,0FFH
MZ25_VRAM_MASK_PATTERN8_X_RKEEP:
    SLA  A
    DJNZ MZ25_VRAM_MASK_PATTERN8_X_RKEEP
    OR   D
    LD   (MZ25_VRAM_MASK_PATTERN8_X_RMASK),A
    RET

MZ25_VRAM_MASK_PATTERN8_X_CALC_DEST:
    LD   HL,2000H
    LD   A,(MZ25_VRAM_MASK_PATTERN8_X_Y)
    OR   A
    JR   Z,MZ25_VRAM_MASK_PATTERN8_X_ADD_X
    LD   B,A
    LD   DE,40
MZ25_VRAM_MASK_PATTERN8_X_Y_LOOP:
    ADD  HL,DE
    DJNZ MZ25_VRAM_MASK_PATTERN8_X_Y_LOOP
MZ25_VRAM_MASK_PATTERN8_X_ADD_X:
    LD   A,(MZ25_VRAM_MASK_PATTERN8_X_XBYTE)
    LD   E,A
    LD   D,0
    ADD  HL,DE
    RET

MZ25_VRAM_MASK_PATTERN8_X_SAVE:
    DB   0
MZ25_VRAM_MASK_PATTERN8_X_BLOCK:
    DB   0
MZ25_VRAM_MASK_PATTERN8_X_XBYTE:
    DB   0
MZ25_VRAM_MASK_PATTERN8_X_SHIFT:
    DB   0
MZ25_VRAM_MASK_PATTERN8_X_Y:
    DB   0
MZ25_VRAM_MASK_PATTERN8_X_SRC:
    DW   0
MZ25_VRAM_MASK_PATTERN8_X_MASK:
    DW   0
MZ25_VRAM_MASK_PATTERN8_X_MASKBYTE:
    DB   0
MZ25_VRAM_MASK_PATTERN8_X_LPAT:
    DB   0
MZ25_VRAM_MASK_PATTERN8_X_RPAT:
    DB   0
MZ25_VRAM_MASK_PATTERN8_X_LMASK:
    DB   0
MZ25_VRAM_MASK_PATTERN8_X_RMASK:
    DB   0
MZ25_VRAM_MASK_PATTERN8_X_END:
    #END
}


// 320x200x16色ページの指定矩形を0で消去する。
// XBYTE と WBYTE は8ドット単位。ドット単位キャラの消去では、
// Xが8ドット境界でなければWBYTE=2、境界ならWBYTE=1を指定する。
// PAGE: 0..3, XBYTE: 0..39, Y: 0..199, WBYTE: 1..40, H: 1..200
MZ25_VRAM_CLEAR_RECT(BYTE PAGE, BYTE XBYTE, BYTE Y, BYTE WBYTE, BYTE H)
{
    ^A = PAGE;
    #ASM
    LD   A,(_A)
    AND  03H
    LD   C,A
    AND  01H
    LD   B,A
    LD   A,C
    AND  02H
    ADD  A,A
    ADD  A,A
    ADD  A,B
    ADD  A,20H
    LD   (MZ25_VRAM_CLEAR_RECT_BLOCK),A
    #END

    ^A = XBYTE;
    #ASM
    LD   A,(_A)
    LD   (MZ25_VRAM_CLEAR_RECT_XBYTE),A
    #END

    ^A = Y;
    #ASM
    LD   A,(_A)
    LD   (MZ25_VRAM_CLEAR_RECT_Y),A
    #END

    ^A = WBYTE;
    #ASM
    LD   A,(_A)
    LD   (MZ25_VRAM_CLEAR_RECT_WBYTE),A
    #END

    ^A = H;
    #ASM
    LD   A,(_A)
    LD   (MZ25_VRAM_CLEAR_RECT_H),A

    LD   A,(MZ25_VRAM_CLEAR_RECT_H)
    OR   A
    JP   Z,MZ25_VRAM_CLEAR_RECT_END
    LD   A,(MZ25_VRAM_CLEAR_RECT_WBYTE)
    OR   A
    JP   Z,MZ25_VRAM_CLEAR_RECT_END

    DI
    LD   A,1
    OUT  (0B4H),A
    IN   A,(0B5H)
    LD   (MZ25_VRAM_CLEAR_RECT_SAVE),A

    LD   B,4
MZ25_VRAM_CLEAR_RECT_PLANE:
    PUSH BC
    LD   A,1
    OUT  (0B4H),A
    LD   A,(MZ25_VRAM_CLEAR_RECT_BLOCK)
    OUT  (0B5H),A

    CALL MZ25_VRAM_CLEAR_RECT_BLOCK_PROC

    LD   A,(MZ25_VRAM_CLEAR_RECT_BLOCK)
    ADD  A,2
    LD   (MZ25_VRAM_CLEAR_RECT_BLOCK),A
    POP  BC
    DJNZ MZ25_VRAM_CLEAR_RECT_PLANE

    LD   A,1
    OUT  (0B4H),A
    LD   A,(MZ25_VRAM_CLEAR_RECT_SAVE)
    OUT  (0B5H),A
    EI
    JP   MZ25_VRAM_CLEAR_RECT_END

MZ25_VRAM_CLEAR_RECT_BLOCK_PROC:
    CALL MZ25_VRAM_CLEAR_RECT_CALC_START
    LD   A,(MZ25_VRAM_CLEAR_RECT_WBYTE)
    LD   C,A
    LD   A,40
    SUB  C
    LD   (MZ25_VRAM_CLEAR_RECT_LINEADD),A
    LD   A,(MZ25_VRAM_CLEAR_RECT_H)
MZ25_VRAM_CLEAR_RECT_LINE:
    LD   (MZ25_VRAM_CLEAR_RECT_WRAP),A
    LD   A,(MZ25_VRAM_CLEAR_RECT_WBYTE)
    LD   B,A
    XOR  A
MZ25_VRAM_CLEAR_RECT_BYTE:
    LD   (HL),A
    INC  HL
    DJNZ MZ25_VRAM_CLEAR_RECT_BYTE
    LD   A,(MZ25_VRAM_CLEAR_RECT_LINEADD)
    LD   C,A
    LD   B,0
    ADD  HL,BC
    LD   A,(MZ25_VRAM_CLEAR_RECT_WRAP)
    DEC  A
    JR   NZ,MZ25_VRAM_CLEAR_RECT_LINE
    RET

MZ25_VRAM_CLEAR_RECT_CALC_START:
    LD   HL,2000H
    LD   A,(MZ25_VRAM_CLEAR_RECT_Y)
    OR   A
    JR   Z,MZ25_VRAM_CLEAR_RECT_ADD_X
    LD   B,A
    LD   DE,40
MZ25_VRAM_CLEAR_RECT_Y_LOOP:
    ADD  HL,DE
    DJNZ MZ25_VRAM_CLEAR_RECT_Y_LOOP
MZ25_VRAM_CLEAR_RECT_ADD_X:
    LD   A,(MZ25_VRAM_CLEAR_RECT_XBYTE)
    LD   E,A
    LD   D,0
    ADD  HL,DE
    RET

MZ25_VRAM_CLEAR_RECT_WRAP:
    DB   0
MZ25_VRAM_CLEAR_RECT_SAVE:
    DB   0
MZ25_VRAM_CLEAR_RECT_BLOCK:
    DB   0
MZ25_VRAM_CLEAR_RECT_XBYTE:
    DB   0
MZ25_VRAM_CLEAR_RECT_Y:
    DB   0
MZ25_VRAM_CLEAR_RECT_WBYTE:
    DB   0
MZ25_VRAM_CLEAR_RECT_H:
    DB   0
MZ25_VRAM_CLEAR_RECT_LINEADD:
    DB   0
MZ25_VRAM_CLEAR_RECT_END:
    #END
}

// 320x200x16色ページの指定矩形を0で消去する2プレーン版。
// B/Rプレーンだけを消すため、弾など少ない色数のオブジェクト用に軽い。
MZ25_VRAM_CLEAR_RECT_2P(BYTE PAGE, BYTE XBYTE, BYTE Y, BYTE WBYTE, BYTE H)
{
    ^A = PAGE;
    #ASM
    LD   A,(_A)
    AND  03H
    LD   C,A
    AND  01H
    LD   B,A
    LD   A,C
    AND  02H
    ADD  A,A
    ADD  A,A
    ADD  A,B
    ADD  A,20H
    LD   (MZ25_VRAM_CLEAR_RECT_2P_BLOCK),A
    #END

    ^A = XBYTE;
    #ASM
    LD   A,(_A)
    LD   (MZ25_VRAM_CLEAR_RECT_2P_XBYTE),A
    #END

    ^A = Y;
    #ASM
    LD   A,(_A)
    LD   (MZ25_VRAM_CLEAR_RECT_2P_Y),A
    #END

    ^A = WBYTE;
    #ASM
    LD   A,(_A)
    LD   (MZ25_VRAM_CLEAR_RECT_2P_WBYTE),A
    #END

    ^A = H;
    #ASM
    LD   A,(_A)
    LD   (MZ25_VRAM_CLEAR_RECT_2P_H),A

    LD   A,(MZ25_VRAM_CLEAR_RECT_2P_H)
    OR   A
    JP   Z,MZ25_VRAM_CLEAR_RECT_2P_END
    LD   A,(MZ25_VRAM_CLEAR_RECT_2P_WBYTE)
    OR   A
    JP   Z,MZ25_VRAM_CLEAR_RECT_2P_END

    DI
    LD   A,1
    OUT  (0B4H),A
    IN   A,(0B5H)
    LD   (MZ25_VRAM_CLEAR_RECT_2P_SAVE),A

    LD   B,2
MZ25_VRAM_CLEAR_RECT_2P_PLANE:
    PUSH BC
    LD   A,1
    OUT  (0B4H),A
    LD   A,(MZ25_VRAM_CLEAR_RECT_2P_BLOCK)
    OUT  (0B5H),A

    CALL MZ25_VRAM_CLEAR_RECT_2P_BLOCK_PROC

    LD   A,(MZ25_VRAM_CLEAR_RECT_2P_BLOCK)
    ADD  A,2
    LD   (MZ25_VRAM_CLEAR_RECT_2P_BLOCK),A
    POP  BC
    DJNZ MZ25_VRAM_CLEAR_RECT_2P_PLANE

    LD   A,1
    OUT  (0B4H),A
    LD   A,(MZ25_VRAM_CLEAR_RECT_2P_SAVE)
    OUT  (0B5H),A
    EI
    JP   MZ25_VRAM_CLEAR_RECT_2P_END

MZ25_VRAM_CLEAR_RECT_2P_BLOCK_PROC:
    LD   HL,2000H
    LD   A,(MZ25_VRAM_CLEAR_RECT_2P_Y)
    OR   A
    JR   Z,MZ25_VRAM_CLEAR_RECT_2P_ADD_X
    LD   B,A
    LD   DE,40
MZ25_VRAM_CLEAR_RECT_2P_Y_LOOP:
    ADD  HL,DE
    DJNZ MZ25_VRAM_CLEAR_RECT_2P_Y_LOOP
MZ25_VRAM_CLEAR_RECT_2P_ADD_X:
    LD   A,(MZ25_VRAM_CLEAR_RECT_2P_XBYTE)
    LD   E,A
    LD   D,0
    ADD  HL,DE
    LD   A,(MZ25_VRAM_CLEAR_RECT_2P_WBYTE)
    LD   C,A
    LD   A,40
    SUB  C
    LD   (MZ25_VRAM_CLEAR_RECT_2P_LINEADD),A
    LD   A,(MZ25_VRAM_CLEAR_RECT_2P_H)
MZ25_VRAM_CLEAR_RECT_2P_LINE:
    LD   (MZ25_VRAM_CLEAR_RECT_2P_WRAP),A
    LD   A,(MZ25_VRAM_CLEAR_RECT_2P_WBYTE)
    LD   B,A
    XOR  A
MZ25_VRAM_CLEAR_RECT_2P_BYTE:
    LD   (HL),A
    INC  HL
    DJNZ MZ25_VRAM_CLEAR_RECT_2P_BYTE
    LD   A,(MZ25_VRAM_CLEAR_RECT_2P_LINEADD)
    LD   C,A
    LD   B,0
    ADD  HL,BC
    LD   A,(MZ25_VRAM_CLEAR_RECT_2P_WRAP)
    DEC  A
    JR   NZ,MZ25_VRAM_CLEAR_RECT_2P_LINE
    RET

MZ25_VRAM_CLEAR_RECT_2P_WRAP:
    DB   0
MZ25_VRAM_CLEAR_RECT_2P_SAVE:
    DB   0
MZ25_VRAM_CLEAR_RECT_2P_BLOCK:
    DB   0
MZ25_VRAM_CLEAR_RECT_2P_XBYTE:
    DB   0
MZ25_VRAM_CLEAR_RECT_2P_Y:
    DB   0
MZ25_VRAM_CLEAR_RECT_2P_WBYTE:
    DB   0
MZ25_VRAM_CLEAR_RECT_2P_H:
    DB   0
MZ25_VRAM_CLEAR_RECT_2P_LINEADD:
    DB   0
MZ25_VRAM_CLEAR_RECT_2P_END:
    #END
}


// 8x8ドットパターンを、Xドット単位指定でマスク付き描画する2プレーン版。
// 描画式: dst = (dst AND mask) OR pattern
// Xは0..312程度を想定。Xが8ドット境界でない場合は左右2バイトに分けて描画する。
// B/Rプレーンだけを処理する。弾など少色オブジェクト用。
MZ25_VRAM_MASK_PATTERN8_X_2P(BYTE PAGE, WORD X, BYTE Y, WORD TADR, WORD MADR)
{
    ^A = PAGE;
    #ASM
    LD   A,(_A)
    AND  03H
    LD   C,A
    AND  01H
    LD   B,A
    LD   A,C
    AND  02H
    ADD  A,A
    ADD  A,A
    ADD  A,B
    ADD  A,20H
    LD   (MZ25_VRAM_MASK_PATTERN8_X_2P_BLOCK),A
    #END

    ^HL = X;
    #ASM
    LD   HL,(_HL)
    LD   A,L
    AND  07H
    LD   (MZ25_VRAM_MASK_PATTERN8_X_2P_SHIFT),A
    SRL  H
    RR   L
    SRL  H
    RR   L
    SRL  H
    RR   L
    LD   A,L
    LD   (MZ25_VRAM_MASK_PATTERN8_X_2P_XBYTE),A
    #END

    ^A = Y;
    #ASM
    LD   A,(_A)
    LD   (MZ25_VRAM_MASK_PATTERN8_X_2P_Y),A
    #END

    ^HL = TADR;
    #ASM
    LD   HL,(_HL)
    LD   (MZ25_VRAM_MASK_PATTERN8_X_2P_SRC),HL
    #END

    ^HL = MADR;
    #ASM
    LD   HL,(_HL)
    LD   (MZ25_VRAM_MASK_PATTERN8_X_2P_MASK),HL

    DI
    LD   A,1
    OUT  (0B4H),A
    IN   A,(0B5H)
    LD   (MZ25_VRAM_MASK_PATTERN8_X_2P_SAVE),A

    LD   B,2
MZ25_VRAM_MASK_PATTERN8_X_2P_PLANE_LOOP:
    PUSH BC
    LD   A,1
    OUT  (0B4H),A
    LD   A,(MZ25_VRAM_MASK_PATTERN8_X_2P_BLOCK)
    OUT  (0B5H),A

    CALL MZ25_VRAM_MASK_PATTERN8_X_2P_PLANE

    LD   A,(MZ25_VRAM_MASK_PATTERN8_X_2P_BLOCK)
    ADD  A,2
    LD   (MZ25_VRAM_MASK_PATTERN8_X_2P_BLOCK),A
    POP  BC
    DJNZ MZ25_VRAM_MASK_PATTERN8_X_2P_PLANE_LOOP

    LD   A,1
    OUT  (0B4H),A
    LD   A,(MZ25_VRAM_MASK_PATTERN8_X_2P_SAVE)
    OUT  (0B5H),A
    EI
    JP   MZ25_VRAM_MASK_PATTERN8_X_2P_END

MZ25_VRAM_MASK_PATTERN8_X_2P_PLANE:
    CALL MZ25_VRAM_MASK_PATTERN8_X_2P_CALC_DEST
    EX   DE,HL
    LD   HL,(MZ25_VRAM_MASK_PATTERN8_X_2P_SRC)
    LD   IX,(MZ25_VRAM_MASK_PATTERN8_X_2P_MASK)
    LD   B,8
MZ25_VRAM_MASK_PATTERN8_X_2P_ROW:
    LD   A,(MZ25_VRAM_MASK_PATTERN8_X_2P_SHIFT)
    OR   A
    JR   Z,MZ25_VRAM_MASK_PATTERN8_X_2P_ROW_ALIGNED

    LD   A,(HL)
    LD   C,A
    LD   A,(IX+0)
    LD   (MZ25_VRAM_MASK_PATTERN8_X_2P_MASKBYTE),A
    PUSH BC
    PUSH DE
    CALL MZ25_VRAM_MASK_PATTERN8_X_2P_SHIFT_BYTES
    POP  DE
    POP  BC

    LD   A,(DE)
    LD   C,A
    LD   A,(MZ25_VRAM_MASK_PATTERN8_X_2P_LMASK)
    AND  C
    LD   C,A
    LD   A,(MZ25_VRAM_MASK_PATTERN8_X_2P_LPAT)
    OR   C
    LD   (DE),A

    INC  DE
    LD   A,(DE)
    LD   C,A
    LD   A,(MZ25_VRAM_MASK_PATTERN8_X_2P_RMASK)
    AND  C
    LD   C,A
    LD   A,(MZ25_VRAM_MASK_PATTERN8_X_2P_RPAT)
    OR   C
    LD   (DE),A
    DEC  DE
    JR   MZ25_VRAM_MASK_PATTERN8_X_2P_NEXT_ROW

MZ25_VRAM_MASK_PATTERN8_X_2P_ROW_ALIGNED:
    LD   A,(DE)
    AND  (IX+0)
    OR   (HL)
    LD   (DE),A

MZ25_VRAM_MASK_PATTERN8_X_2P_NEXT_ROW:
    INC  HL
    INC  IX
    PUSH HL
    LD   HL,40
    ADD  HL,DE
    EX   DE,HL
    POP  HL
    DJNZ MZ25_VRAM_MASK_PATTERN8_X_2P_ROW
    LD   (MZ25_VRAM_MASK_PATTERN8_X_2P_SRC),HL
    RET

; C=pattern, MASKBYTE=mask, SHIFT=1..7
MZ25_VRAM_MASK_PATTERN8_X_2P_SHIFT_BYTES:
    LD   A,(MZ25_VRAM_MASK_PATTERN8_X_2P_SHIFT)
    LD   B,A
    LD   A,C
    LD   D,0
MZ25_VRAM_MASK_PATTERN8_X_2P_PAT_SHIFT:
    SLA  A
    RL   D
    DJNZ MZ25_VRAM_MASK_PATTERN8_X_2P_PAT_SHIFT
    LD   (MZ25_VRAM_MASK_PATTERN8_X_2P_LPAT),A
    LD   A,D
    LD   (MZ25_VRAM_MASK_PATTERN8_X_2P_RPAT),A

    LD   A,(MZ25_VRAM_MASK_PATTERN8_X_2P_SHIFT)
    LD   B,A
    LD   A,(MZ25_VRAM_MASK_PATTERN8_X_2P_MASKBYTE)
    LD   D,0
MZ25_VRAM_MASK_PATTERN8_X_2P_MASK_SHIFT:
    SLA  A
    RL   D
    DJNZ MZ25_VRAM_MASK_PATTERN8_X_2P_MASK_SHIFT
    LD   C,A
    LD   A,(MZ25_VRAM_MASK_PATTERN8_X_2P_SHIFT)
    LD   B,A
    XOR  A
MZ25_VRAM_MASK_PATTERN8_X_2P_LKEEP:
    SCF
    RLA
    DJNZ MZ25_VRAM_MASK_PATTERN8_X_2P_LKEEP
    OR   C
    LD   (MZ25_VRAM_MASK_PATTERN8_X_2P_LMASK),A

    LD   A,(MZ25_VRAM_MASK_PATTERN8_X_2P_SHIFT)
    LD   B,A
    LD   A,0FFH
MZ25_VRAM_MASK_PATTERN8_X_2P_RKEEP:
    SLA  A
    DJNZ MZ25_VRAM_MASK_PATTERN8_X_2P_RKEEP
    OR   D
    LD   (MZ25_VRAM_MASK_PATTERN8_X_2P_RMASK),A
    RET

MZ25_VRAM_MASK_PATTERN8_X_2P_CALC_DEST:
    LD   HL,2000H
    LD   A,(MZ25_VRAM_MASK_PATTERN8_X_2P_Y)
    OR   A
    JR   Z,MZ25_VRAM_MASK_PATTERN8_X_2P_ADD_X
    LD   B,A
    LD   DE,40
MZ25_VRAM_MASK_PATTERN8_X_2P_Y_LOOP:
    ADD  HL,DE
    DJNZ MZ25_VRAM_MASK_PATTERN8_X_2P_Y_LOOP
MZ25_VRAM_MASK_PATTERN8_X_2P_ADD_X:
    LD   A,(MZ25_VRAM_MASK_PATTERN8_X_2P_XBYTE)
    LD   E,A
    LD   D,0
    ADD  HL,DE
    RET

MZ25_VRAM_MASK_PATTERN8_X_2P_SAVE:
    DB   0
MZ25_VRAM_MASK_PATTERN8_X_2P_BLOCK:
    DB   0
MZ25_VRAM_MASK_PATTERN8_X_2P_XBYTE:
    DB   0
MZ25_VRAM_MASK_PATTERN8_X_2P_SHIFT:
    DB   0
MZ25_VRAM_MASK_PATTERN8_X_2P_Y:
    DB   0
MZ25_VRAM_MASK_PATTERN8_X_2P_SRC:
    DW   0
MZ25_VRAM_MASK_PATTERN8_X_2P_MASK:
    DW   0
MZ25_VRAM_MASK_PATTERN8_X_2P_MASKBYTE:
    DB   0
MZ25_VRAM_MASK_PATTERN8_X_2P_LPAT:
    DB   0
MZ25_VRAM_MASK_PATTERN8_X_2P_RPAT:
    DB   0
MZ25_VRAM_MASK_PATTERN8_X_2P_LMASK:
    DB   0
MZ25_VRAM_MASK_PATTERN8_X_2P_RMASK:
    DB   0
MZ25_VRAM_MASK_PATTERN8_X_2P_END:
    #END
}
