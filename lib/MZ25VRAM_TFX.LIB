    }
}


// RAM上のPCG文字コードマップを40x25テキストVRAMへ一括描画する。
// MAP[]には$40などのPCG文字コードをそのまま入れる。
// ATTRは通常カラーPCG用途ではb3=1を含める。例: $1F。
MZ25_TEXT_DRAW_PCGMAP40(BYTE PAGE, BYTE X, BYTE Y, BYTE W, BYTE H, BYTE MAP[], BYTE ATTR)
VAR WORD POS,SIZE;
{
    POS = MZ25_TEXT_OFFSET40(PAGE, X, Y);
    SIZE = H * 256 + W;

    ^HL = POS;
    ^DE = MAP;
    ^BC = SIZE;
    ^A = ATTR;
    #ASM
    DI
    LD   A,1
    OUT  (0B4H),A
    IN   A,(0B5H)
    LD   (MZ25_TEXT_DRAW_PCGMAP40_SAVE),A

    LD   A,1
    OUT  (0B4H),A
    LD   A,38H
    OUT  (0B5H),A

    LD   A,(_A)
    LD   (MZ25_TEXT_DRAW_PCGMAP40_ATTR),A

    LD   IX,(_DE)
    LD   HL,(_HL)
    LD   DE,2000H
    ADD  HL,DE
    LD   BC,(_BC)

MZ25_TEXT_DRAW_PCGMAP40_ROW:
    PUSH BC
    PUSH HL
MZ25_TEXT_DRAW_PCGMAP40_COL:
    LD   A,(IX+0)
    LD   (HL),A
    SET  3,H
    LD   A,(MZ25_TEXT_DRAW_PCGMAP40_ATTR)
    LD   (HL),A
    RES  3,H
    SET  4,H
    XOR  A
    LD   (HL),A
    RES  4,H
    INC  IX
    INC  HL
    DEC  C
    JR   NZ,MZ25_TEXT_DRAW_PCGMAP40_COL
    POP  HL
    LD   DE,40
    ADD  HL,DE
    POP  BC
    DJNZ MZ25_TEXT_DRAW_PCGMAP40_ROW

    LD   A,1
    OUT  (0B4H),A
    LD   A,(MZ25_TEXT_DRAW_PCGMAP40_SAVE)
    OUT  (0B5H),A
    EI
    JR   MZ25_TEXT_DRAW_PCGMAP40_END

MZ25_TEXT_DRAW_PCGMAP40_ATTR:
    DB   0
MZ25_TEXT_DRAW_PCGMAP40_SAVE:
    DB   0
MZ25_TEXT_DRAW_PCGMAP40_END:
    #END
}


// 40x25の指定範囲を左へ1セル高速スクロールする。属性は変更しない。
// PCG用途を想定し、右端のTEXTVRAM1にFILL_C、TEXTVRAM2に0を書き込む。
MZ25_TEXT_SCROLL_LEFT40_FAST_NOATTR(BYTE PAGE, BYTE X, BYTE Y, BYTE W, BYTE H, BYTE FILL_C)
VAR WORD POS,SIZE;
{
    POS = MZ25_TEXT_OFFSET40(PAGE, X, Y);
    SIZE = H * 256 + W;
    ^HL = POS;
    ^BC = SIZE;
    ^A = FILL_C;
    #ASM
    DI
    LD   A,1
    OUT  (0B4H),A
    IN   A,(0B5H)
    LD   (MZ25_TEXT_SCROLL_LEFT40_FAST_NA_SAVE),A
    LD   A,1
    OUT  (0B4H),A
    LD   A,38H
    OUT  (0B5H),A

    LD   A,(_A)
    LD   (MZ25_TEXT_SCROLL_LEFT40_FAST_NA_FILL),A
    LD   BC,(_BC)
    LD   A,B
    LD   (MZ25_TEXT_SCROLL_LEFT40_FAST_NA_ROWS),A
    LD   A,C
    LD   (MZ25_TEXT_SCROLL_LEFT40_FAST_NA_W),A
    LD   HL,(_HL)
    LD   DE,2000H
    ADD  HL,DE

MZ25_TEXT_SCROLL_LEFT40_FAST_NA_ROW:
    PUSH HL
    LD   D,H
    LD   E,L
    INC  HL
    LD   A,(MZ25_TEXT_SCROLL_LEFT40_FAST_NA_W)
    DEC  A
    LD   C,A
    LD   B,0
    LDIR
    LD   A,(MZ25_TEXT_SCROLL_LEFT40_FAST_NA_FILL)
    LD   (DE),A
    POP  HL

    PUSH HL
    SET  4,H
    LD   D,H
    LD   E,L
    INC  HL
    LD   A,(MZ25_TEXT_SCROLL_LEFT40_FAST_NA_W)
    DEC  A
    LD   C,A
    LD   B,0
    LDIR
    XOR  A
    LD   (DE),A
    POP  HL

    LD   DE,40
    ADD  HL,DE
    LD   A,(MZ25_TEXT_SCROLL_LEFT40_FAST_NA_ROWS)
    DEC  A
    LD   (MZ25_TEXT_SCROLL_LEFT40_FAST_NA_ROWS),A
    JR   NZ,MZ25_TEXT_SCROLL_LEFT40_FAST_NA_ROW

    LD   A,1
    OUT  (0B4H),A
    LD   A,(MZ25_TEXT_SCROLL_LEFT40_FAST_NA_SAVE)
    OUT  (0B5H),A
    EI
    JR   MZ25_TEXT_SCROLL_LEFT40_FAST_NA_END

MZ25_TEXT_SCROLL_LEFT40_FAST_NA_FILL: DB 0
MZ25_TEXT_SCROLL_LEFT40_FAST_NA_W:    DB 0
MZ25_TEXT_SCROLL_LEFT40_FAST_NA_ROWS: DB 0
MZ25_TEXT_SCROLL_LEFT40_FAST_NA_SAVE: DB 0
MZ25_TEXT_SCROLL_LEFT40_FAST_NA_END:
    #END
}

// 40x25の指定範囲を右へ1セル高速スクロールする。属性は変更しない。
MZ25_TEXT_SCROLL_RIGHT40_FAST_NOATTR(BYTE PAGE, BYTE X, BYTE Y, BYTE W, BYTE H, BYTE FILL_C)
VAR WORD POS,SIZE;
{
    POS = MZ25_TEXT_OFFSET40(PAGE, X, Y);
    SIZE = H * 256 + W;
    ^HL = POS;
    ^BC = SIZE;
    ^A = FILL_C;
    #ASM
    DI
    LD   A,1
    OUT  (0B4H),A
    IN   A,(0B5H)
    LD   (MZ25_TEXT_SCROLL_RIGHT40_FAST_NA_SAVE),A
    LD   A,1
    OUT  (0B4H),A
    LD   A,38H
    OUT  (0B5H),A

    LD   A,(_A)
    LD   (MZ25_TEXT_SCROLL_RIGHT40_FAST_NA_FILL),A
    LD   BC,(_BC)
    LD   A,B
    LD   (MZ25_TEXT_SCROLL_RIGHT40_FAST_NA_ROWS),A
    LD   A,C
    LD   (MZ25_TEXT_SCROLL_RIGHT40_FAST_NA_W),A
    LD   HL,(_HL)
    LD   DE,2000H
    ADD  HL,DE

MZ25_TEXT_SCROLL_RIGHT40_FAST_NA_ROW:
    PUSH HL
    LD   A,(MZ25_TEXT_SCROLL_RIGHT40_FAST_NA_W)
    DEC  A
    LD   E,A
    LD   D,0
    ADD  HL,DE
    LD   D,H
    LD   E,L
    DEC  HL
    LD   A,(MZ25_TEXT_SCROLL_RIGHT40_FAST_NA_W)
    DEC  A
    LD   C,A
    LD   B,0
    LDDR
    POP  HL
    LD   A,(MZ25_TEXT_SCROLL_RIGHT40_FAST_NA_FILL)
    LD   (HL),A

    PUSH HL
    SET  4,H
    LD   A,(MZ25_TEXT_SCROLL_RIGHT40_FAST_NA_W)
    DEC  A
    LD   E,A
    LD   D,0
    ADD  HL,DE
    LD   D,H
    LD   E,L
    DEC  HL
    LD   A,(MZ25_TEXT_SCROLL_RIGHT40_FAST_NA_W)
    DEC  A
    LD   C,A
    LD   B,0
    LDDR
    POP  HL
    PUSH HL
    SET  4,H
    XOR  A
    LD   (HL),A
    POP  HL

    LD   DE,40
    ADD  HL,DE
    LD   A,(MZ25_TEXT_SCROLL_RIGHT40_FAST_NA_ROWS)
    DEC  A
    LD   (MZ25_TEXT_SCROLL_RIGHT40_FAST_NA_ROWS),A
    JR   NZ,MZ25_TEXT_SCROLL_RIGHT40_FAST_NA_ROW

    LD   A,1
    OUT  (0B4H),A
    LD   A,(MZ25_TEXT_SCROLL_RIGHT40_FAST_NA_SAVE)
    OUT  (0B5H),A
    EI
    JR   MZ25_TEXT_SCROLL_RIGHT40_FAST_NA_END

MZ25_TEXT_SCROLL_RIGHT40_FAST_NA_FILL: DB 0
MZ25_TEXT_SCROLL_RIGHT40_FAST_NA_W:    DB 0
MZ25_TEXT_SCROLL_RIGHT40_FAST_NA_ROWS: DB 0
MZ25_TEXT_SCROLL_RIGHT40_FAST_NA_SAVE: DB 0
MZ25_TEXT_SCROLL_RIGHT40_FAST_NA_END:
    #END
}

// 40x25の指定範囲を上へ1行高速スクロールする。属性は変更しない。
MZ25_TEXT_SCROLL_UP40_FAST_NOATTR(BYTE PAGE, BYTE X, BYTE Y, BYTE W, BYTE H, BYTE FILL_C)
VAR WORD POS,SIZE;
{
    POS = MZ25_TEXT_OFFSET40(PAGE, X, Y);
    SIZE = H * 256 + W;
    ^HL = POS;
    ^BC = SIZE;
    ^A = FILL_C;
    #ASM
    DI
    LD   A,1
    OUT  (0B4H),A
    IN   A,(0B5H)
    LD   (MZ25_TEXT_SCROLL_UP40_FAST_NA_SAVE),A
    LD   A,1
    OUT  (0B4H),A
    LD   A,38H
    OUT  (0B5H),A

    LD   A,(_A)
    LD   (MZ25_TEXT_SCROLL_UP40_FAST_NA_FILL),A
    LD   BC,(_BC)
    LD   A,B
    DEC  A
    LD   (MZ25_TEXT_SCROLL_UP40_FAST_NA_ROWS),A
    LD   A,C
    LD   (MZ25_TEXT_SCROLL_UP40_FAST_NA_W),A
    LD   HL,(_HL)
    LD   DE,2000H
    ADD  HL,DE

MZ25_TEXT_SCROLL_UP40_FAST_NA_ROW:
    PUSH HL
    LD   D,H
    LD   E,L
    PUSH HL
    LD   DE,40
    ADD  HL,DE
    EX   DE,HL
    POP  HL
    EX   DE,HL
    LD   A,(MZ25_TEXT_SCROLL_UP40_FAST_NA_W)
    LD   C,A
    LD   B,0
    LDIR
    POP  HL

    PUSH HL
    SET  4,H
    LD   D,H
    LD   E,L
    PUSH HL
    LD   DE,40
    ADD  HL,DE
    EX   DE,HL
    POP  HL
    EX   DE,HL
    LD   A,(MZ25_TEXT_SCROLL_UP40_FAST_NA_W)
    LD   C,A
    LD   B,0
    LDIR
    POP  HL

    LD   DE,40
    ADD  HL,DE
    LD   A,(MZ25_TEXT_SCROLL_UP40_FAST_NA_ROWS)
    DEC  A
    LD   (MZ25_TEXT_SCROLL_UP40_FAST_NA_ROWS),A
    JR   NZ,MZ25_TEXT_SCROLL_UP40_FAST_NA_ROW

    LD   A,(MZ25_TEXT_SCROLL_UP40_FAST_NA_W)
    LD   C,A
    LD   B,0
    LD   A,(MZ25_TEXT_SCROLL_UP40_FAST_NA_FILL)
MZ25_TEXT_SCROLL_UP40_FAST_NA_FILL1:
    LD   (HL),A
    INC  HL
    DEC  C
    JR   NZ,MZ25_TEXT_SCROLL_UP40_FAST_NA_FILL1
    LD   A,(MZ25_TEXT_SCROLL_UP40_FAST_NA_W)
    LD   C,A
    LD   B,0
    LD   DE,-1
    ADD  HL,DE
    SET  4,H
    XOR  A
MZ25_TEXT_SCROLL_UP40_FAST_NA_FILL2:
    LD   (HL),A
    DEC  HL
    DEC  C
    JR   NZ,MZ25_TEXT_SCROLL_UP40_FAST_NA_FILL2

    LD   A,1
    OUT  (0B4H),A
    LD   A,(MZ25_TEXT_SCROLL_UP40_FAST_NA_SAVE)
    OUT  (0B5H),A
    EI
    JR   MZ25_TEXT_SCROLL_UP40_FAST_NA_END

MZ25_TEXT_SCROLL_UP40_FAST_NA_FILL: DB 0
MZ25_TEXT_SCROLL_UP40_FAST_NA_W:    DB 0
MZ25_TEXT_SCROLL_UP40_FAST_NA_ROWS: DB 0
MZ25_TEXT_SCROLL_UP40_FAST_NA_SAVE: DB 0
MZ25_TEXT_SCROLL_UP40_FAST_NA_END:
    #END
}

// 40x25の指定範囲を下へ1行高速スクロールする。属性は変更しない。
MZ25_TEXT_SCROLL_DOWN40_FAST_NOATTR(BYTE PAGE, BYTE X, BYTE Y, BYTE W, BYTE H, BYTE FILL_C)
VAR WORD POS,SIZE;
{
    POS = MZ25_TEXT_OFFSET40(PAGE, X, Y);
    SIZE = H * 256 + W;
    ^HL = POS;
    ^BC = SIZE;
    ^A = FILL_C;
    #ASM
    DI
    LD   A,1
    OUT  (0B4H),A
    IN   A,(0B5H)
    LD   (MZ25_TEXT_SCROLL_DOWN40_FAST_NA_SAVE),A
    LD   A,1
    OUT  (0B4H),A
    LD   A,38H
    OUT  (0B5H),A

    LD   A,(_A)
    LD   (MZ25_TEXT_SCROLL_DOWN40_FAST_NA_FILL),A
    LD   BC,(_BC)
    LD   A,B
    DEC  A
    LD   (MZ25_TEXT_SCROLL_DOWN40_FAST_NA_ROWS),A
    LD   (MZ25_TEXT_SCROLL_DOWN40_FAST_NA_SEEK),A
    LD   A,C
    LD   (MZ25_TEXT_SCROLL_DOWN40_FAST_NA_W),A
    LD   HL,(_HL)
    LD   DE,2000H
    ADD  HL,DE

MZ25_TEXT_SCROLL_DOWN40_FAST_NA_SEEK_LOOP:
    LD   A,(MZ25_TEXT_SCROLL_DOWN40_FAST_NA_SEEK)
    OR   A
    JR   Z,MZ25_TEXT_SCROLL_DOWN40_FAST_NA_ROW
    LD   DE,40
    ADD  HL,DE
    DEC  A
    LD   (MZ25_TEXT_SCROLL_DOWN40_FAST_NA_SEEK),A
    JR   MZ25_TEXT_SCROLL_DOWN40_FAST_NA_SEEK_LOOP

MZ25_TEXT_SCROLL_DOWN40_FAST_NA_ROW:
    PUSH HL
    PUSH HL
    LD   DE,-40
    ADD  HL,DE
    POP  DE
    PUSH DE
    LD   A,(MZ25_TEXT_SCROLL_DOWN40_FAST_NA_W)
    LD   C,A
    LD   B,0
    LDIR
    POP  HL
    POP  AF

    SET  4,H
    PUSH HL
    LD   DE,-40
    ADD  HL,DE
    POP  DE
    PUSH DE
    LD   A,(MZ25_TEXT_SCROLL_DOWN40_FAST_NA_W)
