    SUB  8
    LD   (MZ25_VRAM_SCROLL_RECT_DOWN8_ROWS),A
    LD   A,(MZ25_VRAM_SCROLL_RECT_DOWN8_WBYTE)
    OR   A
    JP   Z,MZ25_VRAM_SCROLL_RECT_DOWN8_END
    ADD  A,40
    LD   (MZ25_VRAM_SCROLL_RECT_DOWN8_LINEBACK),A

    DI
    LD   A,1
    OUT  (0B4H),A
    IN   A,(0B5H)
    LD   (MZ25_VRAM_SCROLL_RECT_DOWN8_SAVE),A

    LD   B,4
MZ25_VRAM_SCROLL_RECT_DOWN8_PLANE:
    PUSH BC
    LD   A,1
    OUT  (0B4H),A
    LD   A,(MZ25_VRAM_SCROLL_RECT_DOWN8_BLOCK)
    OUT  (0B5H),A

    CALL MZ25_VRAM_SCROLL_RECT_DOWN8_BLOCK_PROC

    LD   A,(MZ25_VRAM_SCROLL_RECT_DOWN8_BLOCK)
    ADD  A,2
    LD   (MZ25_VRAM_SCROLL_RECT_DOWN8_BLOCK),A
    POP  BC
    DJNZ MZ25_VRAM_SCROLL_RECT_DOWN8_PLANE

    LD   A,1
    OUT  (0B4H),A
    LD   A,(MZ25_VRAM_SCROLL_RECT_DOWN8_SAVE)
    OUT  (0B5H),A
    EI
    JR   MZ25_VRAM_SCROLL_RECT_DOWN8_END

MZ25_VRAM_SCROLL_RECT_DOWN8_BLOCK_PROC:
    CALL MZ25_VRAM_SCROLL_RECT_DOWN8_CALC_BOTTOM
    LD   D,H
    LD   E,L
    LD   BC,320
    OR   A
    SBC  HL,BC
    LD   A,(MZ25_VRAM_SCROLL_RECT_DOWN8_ROWS)
MZ25_VRAM_SCROLL_RECT_DOWN8_LINE:
    LD   (MZ25_VRAM_SCROLL_RECT_DOWN8_WRAP),A
    LD   A,(MZ25_VRAM_SCROLL_RECT_DOWN8_WBYTE)
    LD   C,A
    LD   B,0
    LDIR
    LD   (MZ25_VRAM_SCROLL_RECT_DOWN8_SRC),HL
    EX   DE,HL
    LD   A,(MZ25_VRAM_SCROLL_RECT_DOWN8_LINEBACK)
    LD   C,A
    LD   B,0
    OR   A
    SBC  HL,BC
    EX   DE,HL
    LD   HL,(MZ25_VRAM_SCROLL_RECT_DOWN8_SRC)
    LD   A,(MZ25_VRAM_SCROLL_RECT_DOWN8_LINEBACK)
    LD   C,A
    LD   B,0
    OR   A
    SBC  HL,BC
    LD   A,(MZ25_VRAM_SCROLL_RECT_DOWN8_WRAP)
    DEC  A
    JR   NZ,MZ25_VRAM_SCROLL_RECT_DOWN8_LINE
    RET

MZ25_VRAM_SCROLL_RECT_DOWN8_CALC_BOTTOM:
    LD   HL,2000H
    LD   A,(MZ25_VRAM_SCROLL_RECT_DOWN8_Y)
    LD   C,A
    LD   A,(MZ25_VRAM_SCROLL_RECT_DOWN8_H)
    ADD  A,C
    DEC  A
    OR   A
    JR   Z,MZ25_VRAM_SCROLL_RECT_DOWN8_ADD_X
    LD   B,A
    LD   DE,40
MZ25_VRAM_SCROLL_RECT_DOWN8_Y_LOOP:
    ADD  HL,DE
    DJNZ MZ25_VRAM_SCROLL_RECT_DOWN8_Y_LOOP
MZ25_VRAM_SCROLL_RECT_DOWN8_ADD_X:
    LD   A,(MZ25_VRAM_SCROLL_RECT_DOWN8_XBYTE)
    LD   E,A
    LD   D,0
    ADD  HL,DE
    RET

MZ25_VRAM_SCROLL_RECT_DOWN8_WRAP:
    DB   0
MZ25_VRAM_SCROLL_RECT_DOWN8_SAVE:
    DB   0
MZ25_VRAM_SCROLL_RECT_DOWN8_BLOCK:
    DB   0
MZ25_VRAM_SCROLL_RECT_DOWN8_XBYTE:
    DB   0
MZ25_VRAM_SCROLL_RECT_DOWN8_Y:
    DB   0
MZ25_VRAM_SCROLL_RECT_DOWN8_WBYTE:
    DB   0
MZ25_VRAM_SCROLL_RECT_DOWN8_H:
    DB   0
MZ25_VRAM_SCROLL_RECT_DOWN8_ROWS:
    DB   0
MZ25_VRAM_SCROLL_RECT_DOWN8_LINEBACK:
    DB   0
MZ25_VRAM_SCROLL_RECT_DOWN8_SRC:
    DW   0
MZ25_VRAM_SCROLL_RECT_DOWN8_END:
    #END
}

// 320x200x16色ページの指定矩形を8ドット左へ非ループシフトする。
// XBYTE と WBYTE は8ドット単位。例: X=40, 幅=240なら XBYTE=5, WBYTE=30。
// PAGE: 0..3, XBYTE: 0..39, Y: 0..199, WBYTE: 1..40, H: 1..200
MZ25_VRAM_SHIFT_RECT_LEFT8(BYTE PAGE, BYTE XBYTE, BYTE Y, BYTE WBYTE, BYTE H)
{
    ^A = PAGE;
    #ASM
    LD   A,(_A)
    AND  03H
    LD   C,A
    AND  01H
    LD   B,A
    LD   A,C
    AND  02H
    ADD  A,A
    ADD  A,A
    ADD  A,B
    ADD  A,20H
    LD   (MZ25_VRAM_SHIFT_RECT_LEFT8_BLOCK),A
    #END

    ^A = XBYTE;
    #ASM
    LD   A,(_A)
    LD   (MZ25_VRAM_SHIFT_RECT_LEFT8_XBYTE),A
    #END

    ^A = Y;
    #ASM
    LD   A,(_A)
    LD   (MZ25_VRAM_SHIFT_RECT_LEFT8_Y),A
    #END

    ^A = WBYTE;
    #ASM
    LD   A,(_A)
    LD   (MZ25_VRAM_SHIFT_RECT_LEFT8_WBYTE),A
    #END

    ^A = H;
    #ASM
    LD   A,(_A)
    LD   (MZ25_VRAM_SHIFT_RECT_LEFT8_H),A

    LD   A,(MZ25_VRAM_SHIFT_RECT_LEFT8_H)
    OR   A
    JP   Z,MZ25_VRAM_SHIFT_RECT_LEFT8_END
    LD   A,(MZ25_VRAM_SHIFT_RECT_LEFT8_WBYTE)
    CP   2
    JP   C,MZ25_VRAM_SHIFT_RECT_LEFT8_END

    LD   B,A
    DEC  B
    LD   A,B
    LD   (MZ25_VRAM_SHIFT_RECT_LEFT8_COUNT),A
    LD   A,40
    SUB  B
    DEC  A
    LD   (MZ25_VRAM_SHIFT_RECT_LEFT8_LINEADD),A

    DI
    LD   A,1
    OUT  (0B4H),A
    IN   A,(0B5H)
    LD   (MZ25_VRAM_SHIFT_RECT_LEFT8_SAVE),A

    LD   B,4
MZ25_VRAM_SHIFT_RECT_LEFT8_PLANE:
    PUSH BC
    LD   A,1
    OUT  (0B4H),A
    LD   A,(MZ25_VRAM_SHIFT_RECT_LEFT8_BLOCK)
    OUT  (0B5H),A

    CALL MZ25_VRAM_SHIFT_RECT_LEFT8_BLOCK_PROC

    LD   A,(MZ25_VRAM_SHIFT_RECT_LEFT8_BLOCK)
    ADD  A,2
    LD   (MZ25_VRAM_SHIFT_RECT_LEFT8_BLOCK),A
    POP  BC
    DJNZ MZ25_VRAM_SHIFT_RECT_LEFT8_PLANE

    LD   A,1
    OUT  (0B4H),A
    LD   A,(MZ25_VRAM_SHIFT_RECT_LEFT8_SAVE)
    OUT  (0B5H),A
    EI
    JR   MZ25_VRAM_SHIFT_RECT_LEFT8_END

MZ25_VRAM_SHIFT_RECT_LEFT8_BLOCK_PROC:
    CALL MZ25_VRAM_SHIFT_RECT_LEFT8_CALC_START
    LD   A,(MZ25_VRAM_SHIFT_RECT_LEFT8_H)
MZ25_VRAM_SHIFT_RECT_LEFT8_LINE:
    LD   (MZ25_VRAM_SHIFT_RECT_LEFT8_WRAP),A
    LD   D,H
    LD   E,L
    INC  HL
    LD   A,(MZ25_VRAM_SHIFT_RECT_LEFT8_COUNT)
    LD   C,A
    LD   B,0
    LDIR
    EX   DE,HL
    INC  HL
    LD   A,(MZ25_VRAM_SHIFT_RECT_LEFT8_LINEADD)
    LD   C,A
    LD   B,0
    ADD  HL,BC
    LD   A,(MZ25_VRAM_SHIFT_RECT_LEFT8_WRAP)
    DEC  A
    JR   NZ,MZ25_VRAM_SHIFT_RECT_LEFT8_LINE
    RET

MZ25_VRAM_SHIFT_RECT_LEFT8_CALC_START:
    LD   HL,2000H
    LD   A,(MZ25_VRAM_SHIFT_RECT_LEFT8_Y)
    OR   A
    JR   Z,MZ25_VRAM_SHIFT_RECT_LEFT8_ADD_X
    LD   B,A
    LD   DE,40
MZ25_VRAM_SHIFT_RECT_LEFT8_Y_LOOP:
    ADD  HL,DE
    DJNZ MZ25_VRAM_SHIFT_RECT_LEFT8_Y_LOOP
MZ25_VRAM_SHIFT_RECT_LEFT8_ADD_X:
    LD   A,(MZ25_VRAM_SHIFT_RECT_LEFT8_XBYTE)
    LD   E,A
    LD   D,0
    ADD  HL,DE
    RET

MZ25_VRAM_SHIFT_RECT_LEFT8_WRAP:
    DB   0
MZ25_VRAM_SHIFT_RECT_LEFT8_SAVE:
    DB   0
MZ25_VRAM_SHIFT_RECT_LEFT8_BLOCK:
    DB   0
MZ25_VRAM_SHIFT_RECT_LEFT8_XBYTE:
    DB   0
MZ25_VRAM_SHIFT_RECT_LEFT8_Y:
    DB   0
MZ25_VRAM_SHIFT_RECT_LEFT8_WBYTE:
    DB   0
MZ25_VRAM_SHIFT_RECT_LEFT8_H:
    DB   0
MZ25_VRAM_SHIFT_RECT_LEFT8_COUNT:
    DB   0
MZ25_VRAM_SHIFT_RECT_LEFT8_LINEADD:
    DB   0
MZ25_VRAM_SHIFT_RECT_LEFT8_END:
    #END
}

