MZ25_VRAM_SHIFT_RECT_RIGHT8_LINE:
    LD   (MZ25_VRAM_SHIFT_RECT_RIGHT8_WRAP),A
    LD   D,H
    LD   E,L
    DEC  HL
    LD   A,(MZ25_VRAM_SHIFT_RECT_RIGHT8_COUNT)
    LD   C,A
    LD   B,0
    LDDR
    EX   DE,HL
    LD   A,(MZ25_VRAM_SHIFT_RECT_RIGHT8_LINEADD)
    LD   C,A
    LD   B,0
    ADD  HL,BC
    LD   A,(MZ25_VRAM_SHIFT_RECT_RIGHT8_WRAP)
    DEC  A
    JR   NZ,MZ25_VRAM_SHIFT_RECT_RIGHT8_LINE
    RET

MZ25_VRAM_SHIFT_RECT_RIGHT8_CALC_START:
    LD   HL,2000H
    LD   A,(MZ25_VRAM_SHIFT_RECT_RIGHT8_Y)
    OR   A
    JR   Z,MZ25_VRAM_SHIFT_RECT_RIGHT8_ADD_X
    LD   B,A
    LD   DE,40
MZ25_VRAM_SHIFT_RECT_RIGHT8_Y_LOOP:
    ADD  HL,DE
    DJNZ MZ25_VRAM_SHIFT_RECT_RIGHT8_Y_LOOP
MZ25_VRAM_SHIFT_RECT_RIGHT8_ADD_X:
    LD   A,(MZ25_VRAM_SHIFT_RECT_RIGHT8_XBYTE)
    LD   E,A
    LD   D,0
    ADD  HL,DE
    LD   A,(MZ25_VRAM_SHIFT_RECT_RIGHT8_WBYTE)
    DEC  A
    LD   E,A
    LD   D,0
    ADD  HL,DE
    RET

MZ25_VRAM_SHIFT_RECT_RIGHT8_WRAP:
    DB   0
MZ25_VRAM_SHIFT_RECT_RIGHT8_SAVE:
    DB   0
MZ25_VRAM_SHIFT_RECT_RIGHT8_BLOCK:
    DB   0
MZ25_VRAM_SHIFT_RECT_RIGHT8_XBYTE:
    DB   0
MZ25_VRAM_SHIFT_RECT_RIGHT8_Y:
    DB   0
MZ25_VRAM_SHIFT_RECT_RIGHT8_WBYTE:
    DB   0
MZ25_VRAM_SHIFT_RECT_RIGHT8_H:
    DB   0
MZ25_VRAM_SHIFT_RECT_RIGHT8_COUNT:
    DB   0
MZ25_VRAM_SHIFT_RECT_RIGHT8_LINEADD:
    DB   0
MZ25_VRAM_SHIFT_RECT_RIGHT8_END:
    #END
}
// 320x200x16色ページの指定矩形を8ドット上へ非ループシフトする。
