    SBC  HL,BC
    EX   DE,HL
    LD   HL,(MZ25_VRAM_SHIFT_RECT_DOWN4_2P_SRC)
    LD   A,(MZ25_VRAM_SHIFT_RECT_DOWN4_2P_LINEBACK)
    LD   C,A
    LD   B,0
    OR   A
    SBC  HL,BC
    LD   A,(MZ25_VRAM_SHIFT_RECT_DOWN4_2P_WRAP)
    DEC  A
    JR   NZ,MZ25_VRAM_SHIFT_RECT_DOWN4_2P_LINE
