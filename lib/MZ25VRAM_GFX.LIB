MZ25_VRAM_SHIFT_RECT_DOWN4_2P_BLOCK_PROC:
    CALL MZ25_VRAM_SHIFT_RECT_DOWN4_2P_CALC_BOTTOM
    LD   D,H
    LD   E,L
    LD   BC,160
    OR   A
    SBC  HL,BC
    LD   A,(MZ25_VRAM_SHIFT_RECT_DOWN4_2P_ROWS)
MZ25_VRAM_SHIFT_RECT_DOWN4_2P_LINE:
    LD   (MZ25_VRAM_SHIFT_RECT_DOWN4_2P_WRAP),A
