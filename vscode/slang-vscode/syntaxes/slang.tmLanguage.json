{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "SLANG",
  "scopeName": "source.slang",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#embedded-asm"
    },
    {
      "include": "#preprocessor"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#characters"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#registers"
    },
    {
      "include": "#system-arrays"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.slang",
          "match": "//.*$"
        },
        {
          "name": "comment.block.slang",
          "begin": "/\\*",
          "end": "\\*/"
        },
        {
          "name": "comment.block.parentheses.slang",
          "begin": "\\(\\*",
          "end": "\\*\\)"
        }
      ]
    },
    "preprocessor": {
      "patterns": [
        {
          "name": "meta.preprocessor.slang",
          "match": "^\\s*(#\\s*(?i:INCLUDE|CHAIN|IF|ELSE|ENDIF|MODULE|ASM|END)\\b).*$",
          "captures": {
            "1": {
              "name": "keyword.control.directive.slang"
            }
          }
        }
      ]
    },
    "embedded-asm": {
      "patterns": [
        {
          "name": "meta.embedded.block.asm.slang",
          "begin": "^\\s*(#\\s*(?i:ASM)\\b).*$",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.directive.slang"
            }
          },
          "end": "^\\s*(#\\s*(?i:END)\\b).*$",
          "endCaptures": {
            "1": {
              "name": "keyword.control.directive.slang"
            }
          },
          "patterns": [
            {
              "name": "comment.line.semicolon.asm.slang",
              "match": ";.*$"
            },
            {
              "name": "entity.name.label.asm.slang",
              "match": "^\\s*[A-Za-z_.$@][A-Za-z0-9_.$@]*:"
            },
            {
              "name": "keyword.mnemonic.z80.asm.slang",
              "match": "\\b(?i:adc|add|and|bit|call|ccf|cp|cpd|cpdr|cpi|cpir|cpl|daa|dec|di|djnz|ei|ex|exx|halt|im|in|inc|ind|indr|ini|inir|jp|jr|ld|ldd|lddr|ldi|ldir|neg|nop|or|otdr|otir|out|outd|outi|pop|push|res|ret|reti|retn|rl|rla|rlc|rlca|rld|rr|rra|rrc|rrca|rrd|rst|sbc|scf|set|sla|sll|sra|srl|sub|xor|db|defb|dw|defw|ds|defs|equ|org|include|incbin)\\b"
            },
            {
              "name": "constant.numeric.hex.asm.slang",
              "match": "(?<![A-Za-z0-9_])(?:\\$[0-9A-Fa-f]+|0[0-9A-Fa-f]+[Hh])\\b"
            },
            {
              "name": "constant.numeric.binary.asm.slang",
              "match": "(?<![A-Za-z0-9_])(?:0b[01]+|[01]+[Bb])\\b"
            },
            {
              "name": "string.quoted.double.asm.slang",
              "begin": "\"",
              "end": "\""
            }
          ]
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.slang",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.slang",
              "match": "\\\\(?:[\\\\\"'Nn/CcRrLlUuDd0])"
            }
          ]
        }
      ]
    },
    "characters": {
      "patterns": [
        {
          "name": "string.quoted.single.slang",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.slang",
              "match": "\\\\(?:[\\\\\"'Nn/CcRrLlUuDd0])"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.slang",
          "match": "(?<![A-Za-z0-9_])(?:\\$[0-9A-Fa-f]+|[0-9][0-9A-Fa-f]*[Hh])\\b"
        },
        {
          "name": "constant.numeric.binary.slang",
          "match": "(?<![A-Za-z0-9_])[01]+[Bb]\\b"
        },
        {
          "name": "constant.numeric.float.slang",
          "match": "(?<![A-Za-z0-9_])(?:[0-9]+\\.[0-9]*|\\.[0-9]+)(?:[Ee][+-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.decimal.slang",
          "match": "(?<![A-Za-z0-9_])[0-9]+\\b"
        }
      ]
    },
    "registers": {
      "patterns": [
        {
          "name": "variable.language.register.slang",
          "match": "\\^(?:A|AF|BC|DE|HL|IX|IY|SP|CARRY|CY|ZERO)\\b"
        },
        {
          "name": "variable.language.slang",
          "match": "@KBUFF\\b"
        }
      ]
    },
    "system-arrays": {
      "patterns": [
        {
          "name": "support.variable.system-array.slang",
          "match": "\\b(?:MEMW?|PORTW?|SOSW?)\\b(?=\\s*\\[)"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.slang",
          "match": "\\b(?:ABS|BEEP|BIT|CALL|CHR\\$|CR\\$|DECI\\$|FL\\$|FORM\\$|FTOI|GETL|GETLIN|GETREG|HEX2\\$|HEX4\\$|INKEY|INPUT|LINPUT|LOCATE|LOW|MSG\\$|MSX\\$|PN\\$|PRINT|PRMODE|RESET|RND|SCREEN|SET|SEX|SGN|SPC\\$|STOP|STR\\$|TAB\\$|VTOS|WIDTH|f24add|f24sub|f24mul|f24div|f24cmp|f24neg|i16tof24)\\b(?=\\s*\\()"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.slang",
          "match": "\\b(?:BEGIN|CASE|CONTINUE|DO|DOWNTO|EF|ELIF|ELSE|ELSEIF|END|ENDIF|EXIT|FOR|GOTO|IF|LOOP|NEXT|OF|OTHERS|REPEAT|RETURN|THEN|TO|UNTIL|WEND|WHILE)\\b"
        },
        {
          "name": "storage.modifier.slang",
          "match": "\\b(?:ARRAY|CONST|DIM|MACHINE|OFFSET|ORG|VAR|WORK)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.slang",
          "match": "\\b(?:BYTE|FLOAT|WORD)\\b|%%|%|!"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.slang",
          "match": "\\b(?:FALSE|TRUE|ENV_TYPE|OS_TYPE)\\b|\\$"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.definition.slang",
          "match": "^\\s*([A-Za-z_][A-Za-z0-9_$]*)(?=\\s*(?::\\s*(?:BYTE|WORD|FLOAT))?\\s*\\()",
          "captures": {
            "1": {
              "name": "entity.name.function.slang"
            }
          }
        },
        {
          "name": "support.function.call.slang",
          "match": "\\b([A-Za-z_][A-Za-z0-9_$]*)(?=\\s*\\()",
          "captures": {
            "1": {
              "name": "entity.name.function.call.slang"
            }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.word.slang",
          "match": "\\b(?:AND|CPL|HIGH|LOW|MOD|NOT|OR|XOR)\\b|\\.(?:\\*|/|MOD|<<|>>|<=|>=|<|>)\\."
        },
        {
          "name": "keyword.operator.slang",
          "match": "\\+\\+|--|==|<>|!=|<=|>=|<<|>>|&&|\\|\\||[+\\-*/=<>?:&,]"
        }
      ]
    }
  }
}
