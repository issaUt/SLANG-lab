    LD   A,(MZ25_VRAM_SHIFT_RECT_LEFT8_H)
    OR   A
    JP   Z,MZ25_VRAM_SHIFT_RECT_LEFT8_END
    LD   A,(MZ25_VRAM_SHIFT_RECT_LEFT8_WBYTE)
    CP   2
    JP   C,MZ25_VRAM_SHIFT_RECT_LEFT8_END

    LD   B,A
    DEC  B
    LD   A,B
    LD   (MZ25_VRAM_SHIFT_RECT_LEFT8_COUNT),A
    LD   A,40
    SUB  B
    DEC  A
    LD   (MZ25_VRAM_SHIFT_RECT_LEFT8_LINEADD),A

    DI
    LD   A,1
    OUT  (0B4H),A
    IN   A,(0B5H)
    LD   (MZ25_VRAM_SHIFT_RECT_LEFT8_SAVE),A

    LD   B,4
MZ25_VRAM_SHIFT_RECT_LEFT8_PLANE:
    PUSH BC
    LD   A,1
    OUT  (0B4H),A
