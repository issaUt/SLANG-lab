VAR BYTE MAP_DATA[240] = {
    2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,
    2,0,0,0,0,0,0,0,0,0,3,3,3,3,0,0,0,0,4,2,
    2,0,1,1,1,0,2,2,2,0,3,0,0,3,0,2,2,0,0,2,
    2,0,1,0,1,0,0,0,2,0,3,0,0,3,0,0,2,0,0,2,
    2,0,1,1,1,0,2,0,2,0,3,3,0,3,3,0,2,0,0,2,
