    LD   (MZ25_VRAM_SHIFT_RECT_LEFT8_BLOCK),A
    POP  BC
    DJNZ MZ25_VRAM_SHIFT_RECT_LEFT8_PLANE

    LD   A,1
    OUT  (0B4H),A
    LD   A,(MZ25_VRAM_SHIFT_RECT_LEFT8_SAVE)
    OUT  (0B5H),A
    EI
    JR   MZ25_VRAM_SHIFT_RECT_LEFT8_END

MZ25_VRAM_SHIFT_RECT_LEFT8_BLOCK_PROC:
    CALL MZ25_VRAM_SHIFT_RECT_LEFT8_CALC_START
    LD   A,(MZ25_VRAM_SHIFT_RECT_LEFT8_H)
MZ25_VRAM_SHIFT_RECT_LEFT8_LINE:
    LD   (MZ25_VRAM_SHIFT_RECT_LEFT8_WRAP),A
    LD   D,H
    LD   E,L
    INC  HL
    LD   A,(MZ25_VRAM_SHIFT_RECT_LEFT8_COUNT)
    LD   C,A
    LD   B,0
    LDIR
    EX   DE,HL
    INC  HL
    LD   A,(MZ25_VRAM_SHIFT_RECT_LEFT8_LINEADD)
    LD   C,A
    LD   B,0
    ADD  HL,BC
    LD   A,(MZ25_VRAM_SHIFT_RECT_LEFT8_WRAP)
    DEC  A
    JR   NZ,MZ25_VRAM_SHIFT_RECT_LEFT8_LINE
    RET

MZ25_VRAM_SHIFT_RECT_LEFT8_CALC_START:
    LD   HL,2000H
    LD   A,(MZ25_VRAM_SHIFT_RECT_LEFT8_Y)
    OR   A
    JR   Z,MZ25_VRAM_SHIFT_RECT_LEFT8_ADD_X
    LD   B,A
    LD   DE,40
MZ25_VRAM_SHIFT_RECT_LEFT8_Y_LOOP:
    ADD  HL,DE
    DJNZ MZ25_VRAM_SHIFT_RECT_LEFT8_Y_LOOP
MZ25_VRAM_SHIFT_RECT_LEFT8_ADD_X:
    LD   A,(MZ25_VRAM_SHIFT_RECT_LEFT8_XBYTE)
    LD   E,A
    LD   D,0
    ADD  HL,DE
    RET

MZ25_VRAM_SHIFT_RECT_LEFT8_WRAP:
    DB   0
MZ25_VRAM_SHIFT_RECT_LEFT8_SAVE:
    DB   0
MZ25_VRAM_SHIFT_RECT_LEFT8_BLOCK:
    DB   0
MZ25_VRAM_SHIFT_RECT_LEFT8_XBYTE:
    DB   0
MZ25_VRAM_SHIFT_RECT_LEFT8_Y:
    DB   0
MZ25_VRAM_SHIFT_RECT_LEFT8_WBYTE:
    DB   0
MZ25_VRAM_SHIFT_RECT_LEFT8_H:
    DB   0
MZ25_VRAM_SHIFT_RECT_LEFT8_COUNT:
    DB   0
MZ25_VRAM_SHIFT_RECT_LEFT8_LINEADD:
    DB   0
MZ25_VRAM_SHIFT_RECT_LEFT8_END:
    #END
}

