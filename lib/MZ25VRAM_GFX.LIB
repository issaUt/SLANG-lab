}
// 8x8ドットタイルの4x4ドットだけを、320x200x16色ページへ描画する。
// MODE bit0: 書き込み先 0=左半分, 1=右半分。
// MODE bit1: 読み込み元X 0=左半分, 1=右半分。
// MODE bit2: 読み込み元Y 0=上半分, 1=下半分。
// PAGE: 0..3, XBYTE: 0..39, Y: 0..196, TADR: タイルデータ先頭アドレス。
MZ25_VRAM_PUT_TILE_4X4(BYTE PAGE, BYTE XBYTE, BYTE Y, WORD TADR, BYTE MODE)
{
    ^A = PAGE;
    #ASM
    LD   A,(_A)
    AND  03H
    LD   C,A
    AND  01H
    LD   B,A
    LD   A,C
    AND  02H
    ADD  A,A
    ADD  A,A
    ADD  A,B
    ADD  A,20H
    LD   (MZ25_VRAM_PUT_TILE_4X4_BLOCK),A
    #END

    ^A = XBYTE;
    #ASM
    LD   A,(_A)
    LD   (MZ25_VRAM_PUT_TILE_4X4_XBYTE),A
    #END

    ^A = Y;
    #ASM
    LD   A,(_A)
    LD   (MZ25_VRAM_PUT_TILE_4X4_Y),A
    #END

    ^HL = TADR;
    #ASM
    LD   HL,(_HL)
    LD   (MZ25_VRAM_PUT_TILE_4X4_SRC_BASE),HL
    #END

    ^A = MODE;
    #ASM
    LD   A,(_A)
    AND  07H
    LD   (MZ25_VRAM_PUT_TILE_4X4_MODE),A

    DI
    LD   A,1
    OUT  (0B4H),A
    IN   A,(0B5H)
    LD   (MZ25_VRAM_PUT_TILE_4X4_SAVE),A

    LD   B,4
MZ25_VRAM_PUT_TILE_4X4_PLANE_LOOP:
    PUSH BC
    LD   A,1
    OUT  (0B4H),A
    LD   A,(MZ25_VRAM_PUT_TILE_4X4_BLOCK)
    OUT  (0B5H),A

    CALL MZ25_VRAM_PUT_TILE_4X4_PLANE

    LD   A,(MZ25_VRAM_PUT_TILE_4X4_BLOCK)
    ADD  A,2
    LD   (MZ25_VRAM_PUT_TILE_4X4_BLOCK),A
    LD   HL,(MZ25_VRAM_PUT_TILE_4X4_SRC_BASE)
    LD   DE,8
    ADD  HL,DE
    LD   (MZ25_VRAM_PUT_TILE_4X4_SRC_BASE),HL
    POP  BC
    DJNZ MZ25_VRAM_PUT_TILE_4X4_PLANE_LOOP

    LD   A,1
    OUT  (0B4H),A
    LD   A,(MZ25_VRAM_PUT_TILE_4X4_SAVE)
    OUT  (0B5H),A
    EI
    JR   MZ25_VRAM_PUT_TILE_4X4_END

MZ25_VRAM_PUT_TILE_4X4_PLANE:
    CALL MZ25_VRAM_PUT_TILE_4X4_CALC_DEST
    EX   DE,HL
    LD   HL,(MZ25_VRAM_PUT_TILE_4X4_SRC_BASE)
    LD   A,(MZ25_VRAM_PUT_TILE_4X4_MODE)
    AND  04H
    JR   Z,MZ25_VRAM_PUT_TILE_4X4_SRC_Y_READY
    INC  HL
    INC  HL
    INC  HL
    INC  HL
MZ25_VRAM_PUT_TILE_4X4_SRC_Y_READY:
    LD   B,4
MZ25_VRAM_PUT_TILE_4X4_ROW:
    LD   A,(HL)
    LD   C,A
    LD   A,(MZ25_VRAM_PUT_TILE_4X4_MODE)
    AND  02H
    JR   NZ,MZ25_VRAM_PUT_TILE_4X4_SRC_RIGHT
MZ25_VRAM_PUT_TILE_4X4_SRC_LEFT:
    LD   A,C
    AND  0FH
    JR   MZ25_VRAM_PUT_TILE_4X4_SRC_READY
MZ25_VRAM_PUT_TILE_4X4_SRC_RIGHT:
    LD   A,C
    AND  0F0H
    RRCA
    RRCA
    RRCA
    RRCA
MZ25_VRAM_PUT_TILE_4X4_SRC_READY:
    LD   C,A
    LD   A,(MZ25_VRAM_PUT_TILE_4X4_MODE)
    AND  01H
    JR   NZ,MZ25_VRAM_PUT_TILE_4X4_DST_RIGHT
MZ25_VRAM_PUT_TILE_4X4_DST_LEFT:
    LD   A,(DE)
    AND  0F0H
    OR   C
    LD   (DE),A
    JR   MZ25_VRAM_PUT_TILE_4X4_NEXT_ROW
MZ25_VRAM_PUT_TILE_4X4_DST_RIGHT:
    LD   A,C
    RLCA
    RLCA
    RLCA
    RLCA
    LD   C,A
    LD   A,(DE)
    AND  0FH
    OR   C
    LD   (DE),A
MZ25_VRAM_PUT_TILE_4X4_NEXT_ROW:
    INC  HL
    PUSH HL
    LD   HL,40
    ADD  HL,DE
    EX   DE,HL
    POP  HL
    DJNZ MZ25_VRAM_PUT_TILE_4X4_ROW
    RET

MZ25_VRAM_PUT_TILE_4X4_CALC_DEST:
    LD   HL,2000H
    LD   A,(MZ25_VRAM_PUT_TILE_4X4_Y)
    OR   A
    JR   Z,MZ25_VRAM_PUT_TILE_4X4_ADD_X
    LD   B,A
    LD   DE,40
MZ25_VRAM_PUT_TILE_4X4_Y_LOOP:
    ADD  HL,DE
    DJNZ MZ25_VRAM_PUT_TILE_4X4_Y_LOOP
MZ25_VRAM_PUT_TILE_4X4_ADD_X:
    LD   A,(MZ25_VRAM_PUT_TILE_4X4_XBYTE)
    LD   E,A
    LD   D,0
    ADD  HL,DE
    RET

MZ25_VRAM_PUT_TILE_4X4_SAVE:
    DB   0
MZ25_VRAM_PUT_TILE_4X4_BLOCK:
    DB   0
MZ25_VRAM_PUT_TILE_4X4_XBYTE:
    DB   0
MZ25_VRAM_PUT_TILE_4X4_Y:
    DB   0
MZ25_VRAM_PUT_TILE_4X4_MODE:
    DB   0
MZ25_VRAM_PUT_TILE_4X4_SRC_BASE:
    DW   0
MZ25_VRAM_PUT_TILE_4X4_END:
    #END
}
// 8x8ドットタイルの上半分または下半分4ラインだけを、320x200x16色ページへ描画する。
// MODE: 0=上半分4ライン, 1=下半分4ライン。
// PAGE: 0..3, XBYTE: 0..39, Y: 0..196, TADR: タイルデータ先頭アドレス。
MZ25_VRAM_PUT_TILE_V4(BYTE PAGE, BYTE XBYTE, BYTE Y, WORD TADR, BYTE MODE)
{
    ^A = PAGE;
    #ASM
    LD   A,(_A)
    AND  03H
    LD   C,A
    AND  01H
    LD   B,A
    LD   A,C
    AND  02H
    ADD  A,A
    ADD  A,A
    ADD  A,B
    ADD  A,20H
    LD   (MZ25_VRAM_PUT_TILE_V4_BLOCK),A
    #END

    ^A = XBYTE;
    #ASM
    LD   A,(_A)
    LD   (MZ25_VRAM_PUT_TILE_V4_XBYTE),A
    #END

    ^A = Y;
    #ASM
    LD   A,(_A)
    LD   (MZ25_VRAM_PUT_TILE_V4_Y),A
    #END

    ^HL = TADR;
    #ASM
    LD   HL,(_HL)
    LD   (MZ25_VRAM_PUT_TILE_V4_SRC_BASE),HL
    #END

    ^A = MODE;
    #ASM
    LD   A,(_A)
    AND  01H
    LD   (MZ25_VRAM_PUT_TILE_V4_MODE),A

    DI
    LD   A,1
    OUT  (0B4H),A
    IN   A,(0B5H)
    LD   (MZ25_VRAM_PUT_TILE_V4_SAVE),A

    LD   B,4
MZ25_VRAM_PUT_TILE_V4_PLANE_LOOP:
    PUSH BC
    LD   A,1
    OUT  (0B4H),A
    LD   A,(MZ25_VRAM_PUT_TILE_V4_BLOCK)
    OUT  (0B5H),A

    CALL MZ25_VRAM_PUT_TILE_V4_PLANE

    LD   A,(MZ25_VRAM_PUT_TILE_V4_BLOCK)
    ADD  A,2
    LD   (MZ25_VRAM_PUT_TILE_V4_BLOCK),A
    LD   HL,(MZ25_VRAM_PUT_TILE_V4_SRC_BASE)
    LD   DE,8
    ADD  HL,DE
    LD   (MZ25_VRAM_PUT_TILE_V4_SRC_BASE),HL
    POP  BC
    DJNZ MZ25_VRAM_PUT_TILE_V4_PLANE_LOOP

    LD   A,1
    OUT  (0B4H),A
    LD   A,(MZ25_VRAM_PUT_TILE_V4_SAVE)
    OUT  (0B5H),A
    EI
    JR   MZ25_VRAM_PUT_TILE_V4_END

MZ25_VRAM_PUT_TILE_V4_PLANE:
    CALL MZ25_VRAM_PUT_TILE_V4_CALC_DEST
    EX   DE,HL
    LD   HL,(MZ25_VRAM_PUT_TILE_V4_SRC_BASE)
    LD   A,(MZ25_VRAM_PUT_TILE_V4_MODE)
    OR   A
    JR   Z,MZ25_VRAM_PUT_TILE_V4_SRC_READY
    INC  HL
    INC  HL
    INC  HL
    INC  HL
MZ25_VRAM_PUT_TILE_V4_SRC_READY:
    LD   B,4
MZ25_VRAM_PUT_TILE_V4_ROW:
    LD   A,(HL)
    LD   (DE),A
    INC  HL
    PUSH HL
    LD   HL,40
    ADD  HL,DE
    EX   DE,HL
    POP  HL
    DJNZ MZ25_VRAM_PUT_TILE_V4_ROW
    RET

MZ25_VRAM_PUT_TILE_V4_CALC_DEST:
    LD   HL,2000H
    LD   A,(MZ25_VRAM_PUT_TILE_V4_Y)
    OR   A
    JR   Z,MZ25_VRAM_PUT_TILE_V4_ADD_X
    LD   B,A
    LD   DE,40
MZ25_VRAM_PUT_TILE_V4_Y_LOOP:
    ADD  HL,DE
    DJNZ MZ25_VRAM_PUT_TILE_V4_Y_LOOP
MZ25_VRAM_PUT_TILE_V4_ADD_X:
    LD   A,(MZ25_VRAM_PUT_TILE_V4_XBYTE)
    LD   E,A
    LD   D,0
    ADD  HL,DE
    RET

MZ25_VRAM_PUT_TILE_V4_SAVE:
    DB   0
MZ25_VRAM_PUT_TILE_V4_BLOCK:
    DB   0
MZ25_VRAM_PUT_TILE_V4_XBYTE:
    DB   0
MZ25_VRAM_PUT_TILE_V4_Y:
    DB   0
MZ25_VRAM_PUT_TILE_V4_MODE:
    DB   0
MZ25_VRAM_PUT_TILE_V4_SRC_BASE:
    DW   0
MZ25_VRAM_PUT_TILE_V4_END:
    #END
}

// 320x200x16色ページの指定矩形を4ドット上へ非ループシフトする。
// 下端4ラインは未更新。タイルマップ用途では直後に下端半タイル行を描画する。
MZ25_VRAM_SHIFT_RECT_UP4(BYTE PAGE, BYTE XBYTE, BYTE Y, BYTE WBYTE, BYTE H)
{
    ^A = PAGE;
    #ASM
    LD   A,(_A)
    AND  03H
    LD   C,A
    AND  01H
    LD   B,A
    LD   A,C
    AND  02H
    ADD  A,A
    ADD  A,A
    ADD  A,B
    ADD  A,20H
    LD   (MZ25_VRAM_SHIFT_RECT_UP4_BLOCK),A
    #END

    ^A = XBYTE;
    #ASM
    LD   A,(_A)
    LD   (MZ25_VRAM_SHIFT_RECT_UP4_XBYTE),A
    #END

    ^A = Y;
    #ASM
    LD   A,(_A)
    LD   (MZ25_VRAM_SHIFT_RECT_UP4_Y),A
    #END

    ^A = WBYTE;
    #ASM
    LD   A,(_A)
    LD   (MZ25_VRAM_SHIFT_RECT_UP4_WBYTE),A
    #END

    ^A = H;
    #ASM
    LD   A,(_A)
    LD   (MZ25_VRAM_SHIFT_RECT_UP4_H),A

    LD   A,(MZ25_VRAM_SHIFT_RECT_UP4_H)
    CP   5
    JP   C,MZ25_VRAM_SHIFT_RECT_UP4_END
    SUB  4
    LD   (MZ25_VRAM_SHIFT_RECT_UP4_ROWS),A
    LD   A,(MZ25_VRAM_SHIFT_RECT_UP4_WBYTE)
    OR   A
    JP   Z,MZ25_VRAM_SHIFT_RECT_UP4_END
    LD   C,A
    LD   B,0
    LD   A,40
    SUB  C
    LD   (MZ25_VRAM_SHIFT_RECT_UP4_LINEADD),A

    DI
    LD   A,1
    OUT  (0B4H),A
    IN   A,(0B5H)
    LD   (MZ25_VRAM_SHIFT_RECT_UP4_SAVE),A

    LD   B,4
MZ25_VRAM_SHIFT_RECT_UP4_PLANE:
    PUSH BC
    LD   A,1
    OUT  (0B4H),A
    LD   A,(MZ25_VRAM_SHIFT_RECT_UP4_BLOCK)
    OUT  (0B5H),A

    CALL MZ25_VRAM_SHIFT_RECT_UP4_BLOCK_PROC

    LD   A,(MZ25_VRAM_SHIFT_RECT_UP4_BLOCK)
    ADD  A,2
    LD   (MZ25_VRAM_SHIFT_RECT_UP4_BLOCK),A
    POP  BC
    DJNZ MZ25_VRAM_SHIFT_RECT_UP4_PLANE

    LD   A,1
    OUT  (0B4H),A
    LD   A,(MZ25_VRAM_SHIFT_RECT_UP4_SAVE)
    OUT  (0B5H),A
    EI
    JR   MZ25_VRAM_SHIFT_RECT_UP4_END

MZ25_VRAM_SHIFT_RECT_UP4_BLOCK_PROC:
    CALL MZ25_VRAM_SHIFT_RECT_UP4_CALC_START
    LD   D,H
    LD   E,L
    LD   BC,160
    ADD  HL,BC
    LD   A,(MZ25_VRAM_SHIFT_RECT_UP4_ROWS)
MZ25_VRAM_SHIFT_RECT_UP4_LINE:
    LD   (MZ25_VRAM_SHIFT_RECT_UP4_WRAP),A
    LD   A,(MZ25_VRAM_SHIFT_RECT_UP4_WBYTE)
    LD   C,A
    LD   B,0
    LDIR
    LD   A,(MZ25_VRAM_SHIFT_RECT_UP4_LINEADD)
    LD   C,A
    LD   B,0
    ADD  HL,BC
    EX   DE,HL
    ADD  HL,BC
    EX   DE,HL
    LD   A,(MZ25_VRAM_SHIFT_RECT_UP4_WRAP)
    DEC  A
    JR   NZ,MZ25_VRAM_SHIFT_RECT_UP4_LINE
    RET

MZ25_VRAM_SHIFT_RECT_UP4_CALC_START:
    LD   HL,2000H
    LD   A,(MZ25_VRAM_SHIFT_RECT_UP4_Y)
    OR   A
    JR   Z,MZ25_VRAM_SHIFT_RECT_UP4_ADD_X
    LD   B,A
    LD   DE,40
MZ25_VRAM_SHIFT_RECT_UP4_Y_LOOP:
    ADD  HL,DE
    DJNZ MZ25_VRAM_SHIFT_RECT_UP4_Y_LOOP
MZ25_VRAM_SHIFT_RECT_UP4_ADD_X:
    LD   A,(MZ25_VRAM_SHIFT_RECT_UP4_XBYTE)
    LD   E,A
    LD   D,0
    ADD  HL,DE
    RET

MZ25_VRAM_SHIFT_RECT_UP4_WRAP:
    DB   0
MZ25_VRAM_SHIFT_RECT_UP4_SAVE:
    DB   0
MZ25_VRAM_SHIFT_RECT_UP4_BLOCK:
    DB   0
MZ25_VRAM_SHIFT_RECT_UP4_XBYTE:
    DB   0
MZ25_VRAM_SHIFT_RECT_UP4_Y:
    DB   0
MZ25_VRAM_SHIFT_RECT_UP4_WBYTE:
    DB   0
MZ25_VRAM_SHIFT_RECT_UP4_H:
    DB   0
MZ25_VRAM_SHIFT_RECT_UP4_ROWS:
    DB   0
MZ25_VRAM_SHIFT_RECT_UP4_LINEADD:
    DB   0
MZ25_VRAM_SHIFT_RECT_UP4_END:
    #END
}

// 320x200x16色ページの指定矩形を4ドット下へ非ループシフトする。
// 上端4ラインは未更新。タイルマップ用途では直後に上端半タイル行を描画する。
MZ25_VRAM_SHIFT_RECT_DOWN4(BYTE PAGE, BYTE XBYTE, BYTE Y, BYTE WBYTE, BYTE H)
{
    ^A = PAGE;
    #ASM
    LD   A,(_A)
    AND  03H
    LD   C,A
    AND  01H
    LD   B,A
    LD   A,C
    AND  02H
    ADD  A,A
    ADD  A,A
    ADD  A,B
    ADD  A,20H
    LD   (MZ25_VRAM_SHIFT_RECT_DOWN4_BLOCK),A
    #END

    ^A = XBYTE;
    #ASM
    LD   A,(_A)
    LD   (MZ25_VRAM_SHIFT_RECT_DOWN4_XBYTE),A
    #END

    ^A = Y;
    #ASM
    LD   A,(_A)
    LD   (MZ25_VRAM_SHIFT_RECT_DOWN4_Y),A
    #END

    ^A = WBYTE;
    #ASM
    LD   A,(_A)
    LD   (MZ25_VRAM_SHIFT_RECT_DOWN4_WBYTE),A
    #END

    ^A = H;
    #ASM
    LD   A,(_A)
    LD   (MZ25_VRAM_SHIFT_RECT_DOWN4_H),A

    LD   A,(MZ25_VRAM_SHIFT_RECT_DOWN4_H)
    CP   5
    JP   C,MZ25_VRAM_SHIFT_RECT_DOWN4_END
    SUB  4
    LD   (MZ25_VRAM_SHIFT_RECT_DOWN4_ROWS),A
    LD   A,(MZ25_VRAM_SHIFT_RECT_DOWN4_WBYTE)
    OR   A
    JP   Z,MZ25_VRAM_SHIFT_RECT_DOWN4_END
    ADD  A,40
    LD   (MZ25_VRAM_SHIFT_RECT_DOWN4_LINEBACK),A

    DI
    LD   A,1
    OUT  (0B4H),A
    IN   A,(0B5H)
    LD   (MZ25_VRAM_SHIFT_RECT_DOWN4_SAVE),A

    LD   B,4
MZ25_VRAM_SHIFT_RECT_DOWN4_PLANE:
    PUSH BC
    LD   A,1
    OUT  (0B4H),A
    LD   A,(MZ25_VRAM_SHIFT_RECT_DOWN4_BLOCK)
    OUT  (0B5H),A

    CALL MZ25_VRAM_SHIFT_RECT_DOWN4_BLOCK_PROC

    LD   A,(MZ25_VRAM_SHIFT_RECT_DOWN4_BLOCK)
    ADD  A,2
    LD   (MZ25_VRAM_SHIFT_RECT_DOWN4_BLOCK),A
    POP  BC
    DJNZ MZ25_VRAM_SHIFT_RECT_DOWN4_PLANE

    LD   A,1
    OUT  (0B4H),A
    LD   A,(MZ25_VRAM_SHIFT_RECT_DOWN4_SAVE)
    OUT  (0B5H),A
    EI
    JR   MZ25_VRAM_SHIFT_RECT_DOWN4_END

MZ25_VRAM_SHIFT_RECT_DOWN4_BLOCK_PROC:
    CALL MZ25_VRAM_SHIFT_RECT_DOWN4_CALC_BOTTOM
    LD   D,H
    LD   E,L
    LD   BC,160
    OR   A
    SBC  HL,BC
    LD   A,(MZ25_VRAM_SHIFT_RECT_DOWN4_ROWS)
MZ25_VRAM_SHIFT_RECT_DOWN4_LINE:
    LD   (MZ25_VRAM_SHIFT_RECT_DOWN4_WRAP),A
    LD   A,(MZ25_VRAM_SHIFT_RECT_DOWN4_WBYTE)
    LD   C,A
    LD   B,0
    LDIR
    LD   (MZ25_VRAM_SHIFT_RECT_DOWN4_SRC),HL
    EX   DE,HL
    LD   A,(MZ25_VRAM_SHIFT_RECT_DOWN4_LINEBACK)
    LD   C,A
    LD   B,0
    OR   A
    SBC  HL,BC
    EX   DE,HL
    LD   HL,(MZ25_VRAM_SHIFT_RECT_DOWN4_SRC)
    LD   A,(MZ25_VRAM_SHIFT_RECT_DOWN4_LINEBACK)
    LD   C,A
    LD   B,0
    OR   A
    SBC  HL,BC
    LD   A,(MZ25_VRAM_SHIFT_RECT_DOWN4_WRAP)
    DEC  A
    JR   NZ,MZ25_VRAM_SHIFT_RECT_DOWN4_LINE
    RET

MZ25_VRAM_SHIFT_RECT_DOWN4_CALC_BOTTOM:
    LD   HL,2000H
    LD   A,(MZ25_VRAM_SHIFT_RECT_DOWN4_Y)
    LD   C,A
    LD   A,(MZ25_VRAM_SHIFT_RECT_DOWN4_H)
    ADD  A,C
    DEC  A
    OR   A
    JR   Z,MZ25_VRAM_SHIFT_RECT_DOWN4_ADD_X
    LD   B,A
    LD   DE,40
MZ25_VRAM_SHIFT_RECT_DOWN4_Y_LOOP:
    ADD  HL,DE
    DJNZ MZ25_VRAM_SHIFT_RECT_DOWN4_Y_LOOP
MZ25_VRAM_SHIFT_RECT_DOWN4_ADD_X:
    LD   A,(MZ25_VRAM_SHIFT_RECT_DOWN4_XBYTE)
    LD   E,A
    LD   D,0
    ADD  HL,DE
    RET

MZ25_VRAM_SHIFT_RECT_DOWN4_WRAP:
    DB   0
MZ25_VRAM_SHIFT_RECT_DOWN4_SAVE:
    DB   0
MZ25_VRAM_SHIFT_RECT_DOWN4_BLOCK:
    DB   0
MZ25_VRAM_SHIFT_RECT_DOWN4_XBYTE:
    DB   0
MZ25_VRAM_SHIFT_RECT_DOWN4_Y:
    DB   0
MZ25_VRAM_SHIFT_RECT_DOWN4_WBYTE:
    DB   0
MZ25_VRAM_SHIFT_RECT_DOWN4_H:
    DB   0
MZ25_VRAM_SHIFT_RECT_DOWN4_ROWS:
    DB   0
MZ25_VRAM_SHIFT_RECT_DOWN4_LINEBACK:
    DB   0
MZ25_VRAM_SHIFT_RECT_DOWN4_SRC:
    DW   0
MZ25_VRAM_SHIFT_RECT_DOWN4_END:
    #END
}
// 320x200x16色ページの指定矩形を4ドット右へ非ループシフトする。
// XBYTE と WBYTE は8ドット単位。左端4ドットは0で空く。
// PAGE: 0..3, XBYTE: 0..39, Y: 0..199, WBYTE: 1..40, H: 1..200
MZ25_VRAM_SHIFT_RECT_RIGHT4(BYTE PAGE, BYTE XBYTE, BYTE Y, BYTE WBYTE, BYTE H)
{
    ^A = PAGE;
    #ASM
    LD   A,(_A)
    AND  03H
    LD   C,A
    AND  01H
    LD   B,A
    LD   A,C
    AND  02H
    ADD  A,A
    ADD  A,A
    ADD  A,B
    ADD  A,20H
    LD   (MZ25_VRAM_SHIFT_RECT_RIGHT4_BLOCK),A
    #END

    ^A = XBYTE;
    #ASM
    LD   A,(_A)
    LD   (MZ25_VRAM_SHIFT_RECT_RIGHT4_XBYTE),A
    #END

    ^A = Y;
    #ASM
    LD   A,(_A)
    LD   (MZ25_VRAM_SHIFT_RECT_RIGHT4_Y),A
    #END

    ^A = WBYTE;
    #ASM
    LD   A,(_A)
    LD   (MZ25_VRAM_SHIFT_RECT_RIGHT4_WBYTE),A
    #END

    ^A = H;
    #ASM
    LD   A,(_A)
    LD   (MZ25_VRAM_SHIFT_RECT_RIGHT4_H),A

    LD   A,(MZ25_VRAM_SHIFT_RECT_RIGHT4_H)
    OR   A
    JP   Z,MZ25_VRAM_SHIFT_RECT_RIGHT4_END
    LD   A,(MZ25_VRAM_SHIFT_RECT_RIGHT4_WBYTE)
    OR   A
    JP   Z,MZ25_VRAM_SHIFT_RECT_RIGHT4_END
    LD   C,A
    LD   A,40
    SUB  C
    LD   (MZ25_VRAM_SHIFT_RECT_RIGHT4_LINEADD),A

    DI
    LD   A,1
    OUT  (0B4H),A
    IN   A,(0B5H)
    LD   (MZ25_VRAM_SHIFT_RECT_RIGHT4_SAVE),A

    LD   B,4
MZ25_VRAM_SHIFT_RECT_RIGHT4_PLANE:
    PUSH BC
    LD   A,1
    OUT  (0B4H),A
    LD   A,(MZ25_VRAM_SHIFT_RECT_RIGHT4_BLOCK)
    OUT  (0B5H),A

    CALL MZ25_VRAM_SHIFT_RECT_RIGHT4_BLOCK_PROC

    LD   A,(MZ25_VRAM_SHIFT_RECT_RIGHT4_BLOCK)
    ADD  A,2
    LD   (MZ25_VRAM_SHIFT_RECT_RIGHT4_BLOCK),A
    POP  BC
    DJNZ MZ25_VRAM_SHIFT_RECT_RIGHT4_PLANE

    LD   A,1
    OUT  (0B4H),A
    LD   A,(MZ25_VRAM_SHIFT_RECT_RIGHT4_SAVE)
    OUT  (0B5H),A
    EI
    JR   MZ25_VRAM_SHIFT_RECT_RIGHT4_END

MZ25_VRAM_SHIFT_RECT_RIGHT4_BLOCK_PROC:
    CALL MZ25_VRAM_SHIFT_RECT_RIGHT4_CALC_START
    LD   A,(MZ25_VRAM_SHIFT_RECT_RIGHT4_H)
MZ25_VRAM_SHIFT_RECT_RIGHT4_LINE:
    LD   (MZ25_VRAM_SHIFT_RECT_RIGHT4_WRAP),A
    LD   A,(MZ25_VRAM_SHIFT_RECT_RIGHT4_WBYTE)
    LD   B,A
    CALL MZ25_VRAM_SHIFT_RECT_RIGHT4_LINE_PROC
    LD   A,(MZ25_VRAM_SHIFT_RECT_RIGHT4_LINEADD)
    LD   C,A
    LD   B,0
    ADD  HL,BC
    LD   A,(MZ25_VRAM_SHIFT_RECT_RIGHT4_WRAP)
    DEC  A
    JR   NZ,MZ25_VRAM_SHIFT_RECT_RIGHT4_LINE
    RET

MZ25_VRAM_SHIFT_RECT_RIGHT4_LINE_PROC:
    LD   A,B
    DEC  A
    JR   Z,MZ25_VRAM_SHIFT_RECT_RIGHT4_LAST
    LD   B,A
MZ25_VRAM_SHIFT_RECT_RIGHT4_BYTE:
    LD   A,(HL)
    AND  0F0H
    RRCA
    RRCA
    RRCA
    RRCA
    LD   C,A
    INC  HL
    LD   A,(HL)
    AND  0FH
    RLCA
    RLCA
    RLCA
    RLCA
    OR   C
    DEC  HL
    LD   (HL),A
    INC  HL
    DJNZ MZ25_VRAM_SHIFT_RECT_RIGHT4_BYTE
MZ25_VRAM_SHIFT_RECT_RIGHT4_LAST:
    LD   A,(HL)
    AND  0F0H
    RRCA
    RRCA
    RRCA
    RRCA
    LD   (HL),A
    INC  HL
    RET

MZ25_VRAM_SHIFT_RECT_RIGHT4_CALC_START:
    LD   HL,2000H
    LD   A,(MZ25_VRAM_SHIFT_RECT_RIGHT4_Y)
    OR   A
    JR   Z,MZ25_VRAM_SHIFT_RECT_RIGHT4_ADD_X
    LD   B,A
    LD   DE,40
MZ25_VRAM_SHIFT_RECT_RIGHT4_Y_LOOP:
    ADD  HL,DE
    DJNZ MZ25_VRAM_SHIFT_RECT_RIGHT4_Y_LOOP
MZ25_VRAM_SHIFT_RECT_RIGHT4_ADD_X:
    LD   A,(MZ25_VRAM_SHIFT_RECT_RIGHT4_XBYTE)
    LD   E,A
    LD   D,0
    ADD  HL,DE
    RET

MZ25_VRAM_SHIFT_RECT_RIGHT4_WRAP:
    DB   0
MZ25_VRAM_SHIFT_RECT_RIGHT4_SAVE:
    DB   0
MZ25_VRAM_SHIFT_RECT_RIGHT4_BLOCK:
    DB   0
MZ25_VRAM_SHIFT_RECT_RIGHT4_XBYTE:
    DB   0
MZ25_VRAM_SHIFT_RECT_RIGHT4_Y:
    DB   0
MZ25_VRAM_SHIFT_RECT_RIGHT4_WBYTE:
    DB   0
MZ25_VRAM_SHIFT_RECT_RIGHT4_H:
    DB   0
MZ25_VRAM_SHIFT_RECT_RIGHT4_LINEADD:
    DB   0
MZ25_VRAM_SHIFT_RECT_RIGHT4_END:
    #END
}

// 320x200x16色ページの指定矩形を4ドット左へ非ループシフトする。
// XBYTE と WBYTE は8ドット単位。右端4ドットは0で空く。
// PAGE: 0..3, XBYTE: 0..39, Y: 0..199, WBYTE: 1..40, H: 1..200
MZ25_VRAM_SHIFT_RECT_LEFT4(BYTE PAGE, BYTE XBYTE, BYTE Y, BYTE WBYTE, BYTE H)
{
    ^A = PAGE;
    #ASM
    LD   A,(_A)
    AND  03H
    LD   C,A
    AND  01H
    LD   B,A
    LD   A,C
    AND  02H
    ADD  A,A
    ADD  A,A
    ADD  A,B
    ADD  A,20H
    LD   (MZ25_VRAM_SHIFT_RECT_LEFT4_BLOCK),A
    #END

    ^A = XBYTE;
    #ASM
    LD   A,(_A)
    LD   (MZ25_VRAM_SHIFT_RECT_LEFT4_XBYTE),A
    #END

    ^A = Y;
    #ASM
    LD   A,(_A)
    LD   (MZ25_VRAM_SHIFT_RECT_LEFT4_Y),A
    #END

    ^A = WBYTE;
    #ASM
    LD   A,(_A)
    LD   (MZ25_VRAM_SHIFT_RECT_LEFT4_WBYTE),A
    #END

    ^A = H;
    #ASM
    LD   A,(_A)
    LD   (MZ25_VRAM_SHIFT_RECT_LEFT4_H),A

    LD   A,(MZ25_VRAM_SHIFT_RECT_LEFT4_H)
    OR   A
    JP   Z,MZ25_VRAM_SHIFT_RECT_LEFT4_END
    LD   A,(MZ25_VRAM_SHIFT_RECT_LEFT4_WBYTE)
    OR   A
    JP   Z,MZ25_VRAM_SHIFT_RECT_LEFT4_END
    LD   C,A
    LD   A,40
    SUB  C
    LD   (MZ25_VRAM_SHIFT_RECT_LEFT4_LINEADD),A

    DI
    LD   A,1
    OUT  (0B4H),A
    IN   A,(0B5H)
    LD   (MZ25_VRAM_SHIFT_RECT_LEFT4_SAVE),A

    LD   B,4
MZ25_VRAM_SHIFT_RECT_LEFT4_PLANE:
    PUSH BC
    LD   A,1
    OUT  (0B4H),A
    LD   A,(MZ25_VRAM_SHIFT_RECT_LEFT4_BLOCK)
    OUT  (0B5H),A

    CALL MZ25_VRAM_SHIFT_RECT_LEFT4_BLOCK_PROC

    LD   A,(MZ25_VRAM_SHIFT_RECT_LEFT4_BLOCK)
    ADD  A,2
    LD   (MZ25_VRAM_SHIFT_RECT_LEFT4_BLOCK),A
    POP  BC
    DJNZ MZ25_VRAM_SHIFT_RECT_LEFT4_PLANE

    LD   A,1
    OUT  (0B4H),A
    LD   A,(MZ25_VRAM_SHIFT_RECT_LEFT4_SAVE)
    OUT  (0B5H),A
    EI
    JR   MZ25_VRAM_SHIFT_RECT_LEFT4_END

MZ25_VRAM_SHIFT_RECT_LEFT4_BLOCK_PROC:
    CALL MZ25_VRAM_SHIFT_RECT_LEFT4_CALC_START
    LD   A,(MZ25_VRAM_SHIFT_RECT_LEFT4_H)
MZ25_VRAM_SHIFT_RECT_LEFT4_LINE:
    LD   (MZ25_VRAM_SHIFT_RECT_LEFT4_WRAP),A
    LD   A,(MZ25_VRAM_SHIFT_RECT_LEFT4_WBYTE)
    LD   B,A
    CALL MZ25_VRAM_SHIFT_RECT_LEFT4_LINE_PROC
    LD   A,(MZ25_VRAM_SHIFT_RECT_LEFT4_LINEADD)
    LD   C,A
    LD   B,0
    ADD  HL,BC
    LD   A,(MZ25_VRAM_SHIFT_RECT_LEFT4_WRAP)
    DEC  A
    JR   NZ,MZ25_VRAM_SHIFT_RECT_LEFT4_LINE
    RET

MZ25_VRAM_SHIFT_RECT_LEFT4_LINE_PROC:
    LD   E,B
    LD   D,0
    ADD  HL,DE
    DEC  HL
    LD   A,B
    DEC  A
    JR   Z,MZ25_VRAM_SHIFT_RECT_LEFT4_FIRST
    LD   B,A
MZ25_VRAM_SHIFT_RECT_LEFT4_BYTE:
    LD   A,(HL)
    AND  0FH
    RLCA
    RLCA
    RLCA
    RLCA
    LD   C,A
    DEC  HL
    LD   A,(HL)
    AND  0F0H
    RRCA
    RRCA
    RRCA
    RRCA
    OR   C
    INC  HL
    LD   (HL),A
    DEC  HL
    DJNZ MZ25_VRAM_SHIFT_RECT_LEFT4_BYTE
MZ25_VRAM_SHIFT_RECT_LEFT4_FIRST:
    LD   A,(HL)
    AND  0FH
    RLCA
    RLCA
    RLCA
    RLCA
    LD   (HL),A
    LD   A,(MZ25_VRAM_SHIFT_RECT_LEFT4_WBYTE)
    LD   E,A
    LD   D,0
    ADD  HL,DE
    RET

MZ25_VRAM_SHIFT_RECT_LEFT4_CALC_START:
    LD   HL,2000H
    LD   A,(MZ25_VRAM_SHIFT_RECT_LEFT4_Y)
    OR   A
    JR   Z,MZ25_VRAM_SHIFT_RECT_LEFT4_ADD_X
    LD   B,A
    LD   DE,40
MZ25_VRAM_SHIFT_RECT_LEFT4_Y_LOOP:
    ADD  HL,DE
    DJNZ MZ25_VRAM_SHIFT_RECT_LEFT4_Y_LOOP
MZ25_VRAM_SHIFT_RECT_LEFT4_ADD_X:
    LD   A,(MZ25_VRAM_SHIFT_RECT_LEFT4_XBYTE)
    LD   E,A
    LD   D,0
    ADD  HL,DE
    RET

MZ25_VRAM_SHIFT_RECT_LEFT4_WRAP:
    DB   0
MZ25_VRAM_SHIFT_RECT_LEFT4_SAVE:
    DB   0
MZ25_VRAM_SHIFT_RECT_LEFT4_BLOCK:
    DB   0
MZ25_VRAM_SHIFT_RECT_LEFT4_XBYTE:
    DB   0
MZ25_VRAM_SHIFT_RECT_LEFT4_Y:
    DB   0
MZ25_VRAM_SHIFT_RECT_LEFT4_WBYTE:
    DB   0
MZ25_VRAM_SHIFT_RECT_LEFT4_H:
    DB   0
MZ25_VRAM_SHIFT_RECT_LEFT4_LINEADD:
    DB   0
MZ25_VRAM_SHIFT_RECT_LEFT4_END:
    #END
}
// タイル番号マップから、8x8タイル矩形を高速にまとめて描画する。
// TILETBL は plane0 のタイルアドレス表を先頭に、plane1, plane2, plane3 の順で並べる。
// 各プレーンの表サイズは TILE_COUNT * 2 バイト。
// MAPADR: マップ配列先頭, MAP_W: マップ横幅, VIEW_W/VIEW_H: 表示タイル数。
MZ25_VRAM_DRAW_TILEMAP8(BYTE PAGE, BYTE SXBYTE, BYTE SY, BYTE VIEW_X, BYTE VIEW_Y, BYTE MAP_W, BYTE VIEW_W, BYTE VIEW_H, BYTE TILE_COUNT, WORD MAPADR, WORD TILETBL)
{
    ^A = PAGE;
    #ASM
    LD   A,(_A)
    AND  03H
    LD   C,A
    AND  01H
    LD   B,A
    LD   A,C
    AND  02H
    ADD  A,A
    ADD  A,A
    ADD  A,B
    ADD  A,20H
    LD   (MZ25_VRAM_DRAW_TILEMAP8_BLOCK),A
    #END

    ^A = SXBYTE;
    #ASM
    LD   A,(_A)
    LD   (MZ25_VRAM_DRAW_TILEMAP8_SXBYTE),A
    #END

    ^A = SY;
    #ASM
    LD   A,(_A)
    LD   (MZ25_VRAM_DRAW_TILEMAP8_SY),A
    #END

    ^A = VIEW_X;
    #ASM
    LD   A,(_A)
    LD   (MZ25_VRAM_DRAW_TILEMAP8_VIEW_X),A
    #END

    ^A = VIEW_Y;
    #ASM
    LD   A,(_A)
    LD   (MZ25_VRAM_DRAW_TILEMAP8_VIEW_Y),A
    #END

    ^A = MAP_W;
    #ASM
    LD   A,(_A)
    LD   (MZ25_VRAM_DRAW_TILEMAP8_MAP_W),A
    #END

    ^A = VIEW_W;
    #ASM
    LD   A,(_A)
    LD   (MZ25_VRAM_DRAW_TILEMAP8_VIEW_W),A
    #END

    ^A = VIEW_H;
    #ASM
    LD   A,(_A)
    LD   (MZ25_VRAM_DRAW_TILEMAP8_VIEW_H),A
    #END

    ^A = TILE_COUNT;
    #ASM
    LD   A,(_A)
    ADD  A,A
    LD   (MZ25_VRAM_DRAW_TILEMAP8_TABLE_STEP),A
    #END

    ^HL = MAPADR;
    #ASM
    LD   HL,(_HL)
    LD   (MZ25_VRAM_DRAW_TILEMAP8_MAP_BASE),HL
    #END

    ^HL = TILETBL;
    #ASM
    LD   HL,(_HL)
    LD   (MZ25_VRAM_DRAW_TILEMAP8_TABLE),HL

    DI
    LD   A,1
    OUT  (0B4H),A
    IN   A,(0B5H)
    LD   (MZ25_VRAM_DRAW_TILEMAP8_SAVE),A

    LD   C,4
MZ25_VRAM_DRAW_TILEMAP8_PLANE:
    PUSH BC
    LD   A,1
    OUT  (0B4H),A
    LD   A,(MZ25_VRAM_DRAW_TILEMAP8_BLOCK)
    OUT  (0B5H),A

    CALL MZ25_VRAM_DRAW_TILEMAP8_PLANE_PROC

    LD   A,(MZ25_VRAM_DRAW_TILEMAP8_BLOCK)
    ADD  A,2
    LD   (MZ25_VRAM_DRAW_TILEMAP8_BLOCK),A
    LD   HL,(MZ25_VRAM_DRAW_TILEMAP8_TABLE)
    LD   A,(MZ25_VRAM_DRAW_TILEMAP8_TABLE_STEP)
    LD   E,A
    LD   D,0
    ADD  HL,DE
    LD   (MZ25_VRAM_DRAW_TILEMAP8_TABLE),HL
    POP  BC
    DEC  C
    JR   NZ,MZ25_VRAM_DRAW_TILEMAP8_PLANE

    LD   A,1
    OUT  (0B4H),A
    LD   A,(MZ25_VRAM_DRAW_TILEMAP8_SAVE)
    OUT  (0B5H),A
    EI
    JP   MZ25_VRAM_DRAW_TILEMAP8_END

MZ25_VRAM_DRAW_TILEMAP8_PLANE_PROC:
    LD   HL,(MZ25_VRAM_DRAW_TILEMAP8_MAP_BASE)
    LD   A,(MZ25_VRAM_DRAW_TILEMAP8_VIEW_Y)
    OR   A
    JR   Z,MZ25_VRAM_DRAW_TILEMAP8_MAP_ADD_X
    LD   B,A
MZ25_VRAM_DRAW_TILEMAP8_MAP_Y_LOOP:
    LD   A,(MZ25_VRAM_DRAW_TILEMAP8_MAP_W)
    LD   E,A
    LD   D,0
    ADD  HL,DE
    DJNZ MZ25_VRAM_DRAW_TILEMAP8_MAP_Y_LOOP
MZ25_VRAM_DRAW_TILEMAP8_MAP_ADD_X:
    LD   A,(MZ25_VRAM_DRAW_TILEMAP8_VIEW_X)
    LD   E,A
    LD   D,0
    ADD  HL,DE
    LD   (MZ25_VRAM_DRAW_TILEMAP8_MAP_ROW),HL

    CALL MZ25_VRAM_DRAW_TILEMAP8_CALC_DEST
    LD   (MZ25_VRAM_DRAW_TILEMAP8_DEST_ROW),HL
    LD   A,(MZ25_VRAM_DRAW_TILEMAP8_VIEW_H)
MZ25_VRAM_DRAW_TILEMAP8_TILE_ROW:
    LD   (MZ25_VRAM_DRAW_TILEMAP8_ROW_COUNT),A
    LD   HL,(MZ25_VRAM_DRAW_TILEMAP8_MAP_ROW)
    LD   (MZ25_VRAM_DRAW_TILEMAP8_MAP_PTR),HL
    LD   HL,(MZ25_VRAM_DRAW_TILEMAP8_DEST_ROW)
    LD   (MZ25_VRAM_DRAW_TILEMAP8_DEST_PTR),HL
    LD   A,(MZ25_VRAM_DRAW_TILEMAP8_VIEW_W)
MZ25_VRAM_DRAW_TILEMAP8_TILE_COL:
    LD   (MZ25_VRAM_DRAW_TILEMAP8_COL_COUNT),A

    LD   HL,(MZ25_VRAM_DRAW_TILEMAP8_MAP_PTR)
    LD   A,(HL)
    INC  HL
    LD   (MZ25_VRAM_DRAW_TILEMAP8_MAP_PTR),HL

    LD   L,A
    LD   H,0
    ADD  HL,HL
    LD   DE,(MZ25_VRAM_DRAW_TILEMAP8_TABLE)
    ADD  HL,DE
    LD   E,(HL)
    INC  HL
    LD   D,(HL)

    LD   HL,(MZ25_VRAM_DRAW_TILEMAP8_DEST_PTR)
    LD   B,8
MZ25_VRAM_DRAW_TILEMAP8_TILE_BYTE:
    LD   A,(DE)
    LD   (HL),A
    INC  DE
    PUSH DE
    LD   DE,40
    ADD  HL,DE
    POP  DE
    DJNZ MZ25_VRAM_DRAW_TILEMAP8_TILE_BYTE

    LD   HL,(MZ25_VRAM_DRAW_TILEMAP8_DEST_PTR)
    INC  HL
    LD   (MZ25_VRAM_DRAW_TILEMAP8_DEST_PTR),HL
    LD   A,(MZ25_VRAM_DRAW_TILEMAP8_COL_COUNT)
    DEC  A
    JR   NZ,MZ25_VRAM_DRAW_TILEMAP8_TILE_COL

    LD   HL,(MZ25_VRAM_DRAW_TILEMAP8_MAP_ROW)
    LD   A,(MZ25_VRAM_DRAW_TILEMAP8_MAP_W)
    LD   E,A
    LD   D,0
    ADD  HL,DE
    LD   (MZ25_VRAM_DRAW_TILEMAP8_MAP_ROW),HL
    LD   HL,(MZ25_VRAM_DRAW_TILEMAP8_DEST_ROW)
    LD   DE,320
    ADD  HL,DE
    LD   (MZ25_VRAM_DRAW_TILEMAP8_DEST_ROW),HL
    LD   A,(MZ25_VRAM_DRAW_TILEMAP8_ROW_COUNT)
    DEC  A
    JR   NZ,MZ25_VRAM_DRAW_TILEMAP8_TILE_ROW
    RET

MZ25_VRAM_DRAW_TILEMAP8_CALC_DEST:
    LD   HL,2000H
    LD   A,(MZ25_VRAM_DRAW_TILEMAP8_SY)
    OR   A
    JR   Z,MZ25_VRAM_DRAW_TILEMAP8_ADD_X
    LD   B,A
    LD   DE,40
MZ25_VRAM_DRAW_TILEMAP8_Y_LOOP:
    ADD  HL,DE
    DJNZ MZ25_VRAM_DRAW_TILEMAP8_Y_LOOP
MZ25_VRAM_DRAW_TILEMAP8_ADD_X:
    LD   A,(MZ25_VRAM_DRAW_TILEMAP8_SXBYTE)
    LD   E,A
    LD   D,0
    ADD  HL,DE
    RET

MZ25_VRAM_DRAW_TILEMAP8_SAVE:
    DB   0
MZ25_VRAM_DRAW_TILEMAP8_BLOCK:
    DB   0
MZ25_VRAM_DRAW_TILEMAP8_SXBYTE:
    DB   0
MZ25_VRAM_DRAW_TILEMAP8_SY:
    DB   0
MZ25_VRAM_DRAW_TILEMAP8_VIEW_X:
    DB   0
MZ25_VRAM_DRAW_TILEMAP8_VIEW_Y:
    DB   0
MZ25_VRAM_DRAW_TILEMAP8_MAP_W:
    DB   0
MZ25_VRAM_DRAW_TILEMAP8_VIEW_W:
    DB   0
MZ25_VRAM_DRAW_TILEMAP8_VIEW_H:
    DB   0
MZ25_VRAM_DRAW_TILEMAP8_TABLE_STEP:
    DB   0
MZ25_VRAM_DRAW_TILEMAP8_TABLE:
    DW   0
MZ25_VRAM_DRAW_TILEMAP8_MAP_BASE:
    DW   0
MZ25_VRAM_DRAW_TILEMAP8_ROW_COUNT:
    DB   0
MZ25_VRAM_DRAW_TILEMAP8_COL_COUNT:
    DB   0
MZ25_VRAM_DRAW_TILEMAP8_MAP_ROW:
    DW   0
MZ25_VRAM_DRAW_TILEMAP8_MAP_PTR:
    DW   0
MZ25_VRAM_DRAW_TILEMAP8_DEST_ROW:
    DW   0
MZ25_VRAM_DRAW_TILEMAP8_DEST_PTR:
    DW   0
MZ25_VRAM_DRAW_TILEMAP8_END:
    #END
}

// 設定配列を使って、タイル番号マップから8x8タイル矩形を高速描画する。
// PARAM[0] = MAPADR, PARAM[1] = TILETBL, PARAM[2] = PAGE, PARAM[3] = SXBYTE,
// PARAM[4] = SY, PARAM[5] = VIEW_X, PARAM[6] = VIEW_Y, PARAM[7] = MAP_W,
// PARAM[8] = VIEW_W, PARAM[9] = VIEW_H, PARAM[10] = TILE_COUNT。
MZ25_VRAM_DRAW_TILEMAP8_PARAM(WORD P)
VAR WORD PARAM[];
{
    PARAM = P;

    ^HL = PARAM[0];
    #ASM
    LD   HL,(_HL)
    LD   (MZ25_VRAM_DRAW_TILEMAP8_MAP_BASE),HL
    #END

    ^HL = PARAM[1];
    #ASM
    LD   HL,(_HL)
    LD   (MZ25_VRAM_DRAW_TILEMAP8_TABLE),HL
    #END

    ^A = PARAM[2];
    #ASM
    LD   A,(_A)
    AND  03H
    LD   C,A
    AND  01H
    LD   B,A
    LD   A,C
    AND  02H
    ADD  A,A
    ADD  A,A
    ADD  A,B
    ADD  A,20H
    LD   (MZ25_VRAM_DRAW_TILEMAP8_BLOCK),A
    #END

    ^A = PARAM[3];
    #ASM
    LD   A,(_A)
    LD   (MZ25_VRAM_DRAW_TILEMAP8_SXBYTE),A
    #END

    ^A = PARAM[4];
    #ASM
    LD   A,(_A)
    LD   (MZ25_VRAM_DRAW_TILEMAP8_SY),A
    #END

    ^A = PARAM[5];
    #ASM
    LD   A,(_A)
    LD   (MZ25_VRAM_DRAW_TILEMAP8_VIEW_X),A
    #END

    ^A = PARAM[6];
    #ASM
    LD   A,(_A)
    LD   (MZ25_VRAM_DRAW_TILEMAP8_VIEW_Y),A
    #END

    ^A = PARAM[7];
    #ASM
    LD   A,(_A)
    LD   (MZ25_VRAM_DRAW_TILEMAP8_MAP_W),A
    #END

    ^A = PARAM[8];
    #ASM
    LD   A,(_A)
    LD   (MZ25_VRAM_DRAW_TILEMAP8_VIEW_W),A
    #END

    ^A = PARAM[9];
    #ASM
    LD   A,(_A)
    LD   (MZ25_VRAM_DRAW_TILEMAP8_VIEW_H),A
    #END

    ^A = PARAM[10];
    #ASM
    LD   A,(_A)
    ADD  A,A
    LD   (MZ25_VRAM_DRAW_TILEMAP8_TABLE_STEP),A

    DI
    LD   A,1
    OUT  (0B4H),A
    IN   A,(0B5H)
    LD   (MZ25_VRAM_DRAW_TILEMAP8_SAVE),A

    LD   C,4
MZ25_VRAM_DRAW_TILEMAP8_PARAM_PLANE:
    PUSH BC
    LD   A,1
    OUT  (0B4H),A
    LD   A,(MZ25_VRAM_DRAW_TILEMAP8_BLOCK)
    OUT  (0B5H),A

    CALL MZ25_VRAM_DRAW_TILEMAP8_PLANE_PROC

    LD   A,(MZ25_VRAM_DRAW_TILEMAP8_BLOCK)
    ADD  A,2
    LD   (MZ25_VRAM_DRAW_TILEMAP8_BLOCK),A
    LD   HL,(MZ25_VRAM_DRAW_TILEMAP8_TABLE)
    LD   A,(MZ25_VRAM_DRAW_TILEMAP8_TABLE_STEP)
    LD   E,A
    LD   D,0
    ADD  HL,DE
    LD   (MZ25_VRAM_DRAW_TILEMAP8_TABLE),HL
    POP  BC
    DEC  C
    JR   NZ,MZ25_VRAM_DRAW_TILEMAP8_PARAM_PLANE

    LD   A,1
    OUT  (0B4H),A
    LD   A,(MZ25_VRAM_DRAW_TILEMAP8_SAVE)
    OUT  (0B5H),A
    EI
MZ25_VRAM_DRAW_TILEMAP8_PARAM_END:
    #END
}
// PARAM設定を使って、マップ上のタイル番号から8x8タイルを描画する。
MZ25_VRAM_PUT_MAP_TILE8_PARAM(WORD P, BYTE XBYTE, BYTE Y, BYTE T)
VAR WORD PARAM[];
VAR WORD TABLE[];
{
    PARAM = P;
    TABLE = PARAM[1];
    MZ25_VRAM_PUT_TILE8(PARAM[2], XBYTE, Y, TABLE[T]);
}

// PARAM設定を使って、マップ上のタイル番号から横4ドット分を描画する。
MZ25_VRAM_PUT_MAP_TILE4_PARAM(WORD P, BYTE XBYTE, BYTE Y, BYTE T, BYTE MODE)
VAR WORD PARAM[];
VAR WORD TABLE[];
{
    PARAM = P;
    TABLE = PARAM[1];
    MZ25_VRAM_PUT_TILE4(PARAM[2], XBYTE, Y, TABLE[T], MODE);
}

// PARAM設定を使って、マップ上のタイル番号から縦4ライン分を描画する。
MZ25_VRAM_PUT_MAP_TILE_V4_PARAM(WORD P, BYTE XBYTE, BYTE Y, BYTE T, BYTE MODE)
VAR WORD PARAM[];
VAR WORD TABLE[];
{
    PARAM = P;
    TABLE = PARAM[1];
    MZ25_VRAM_PUT_TILE_V4(PARAM[2], XBYTE, Y, TABLE[T], MODE);
}

// PARAM設定を使って、マップ上のタイル番号から4x4ドット分を描画する。
MZ25_VRAM_PUT_MAP_TILE_4X4_PARAM(WORD P, BYTE XBYTE, BYTE Y, BYTE T, BYTE MODE)
VAR WORD PARAM[];
VAR WORD TABLE[];
{
    PARAM = P;
    TABLE = PARAM[1];
    MZ25_VRAM_PUT_TILE_4X4(PARAM[2], XBYTE, Y, TABLE[T], MODE);
}

// PARAM設定を使って、表示範囲の端1列へ横4ドット分を補充する。
MZ25_VRAM_DRAW_MAP_HALF_COL_PARAM(WORD P, BYTE MAP_COL, BYTE DST_COL, BYTE MODE)
VAR WORD PARAM[];
VAR BYTE MAP[];
VAR Y, I;
{
    PARAM = P;
    MAP = PARAM[0];
    FOR Y = 0 TO PARAM[9] - 1 {
        I = (PARAM[6] + Y) * PARAM[7] + MAP_COL;
        MZ25_VRAM_PUT_MAP_TILE4_PARAM(P, PARAM[3] + DST_COL, PARAM[4] + Y * 8, MAP[I], MODE);
    }
}

// PARAM設定を使って、表示範囲の端1行へ縦4ライン分を補充する。
MZ25_VRAM_DRAW_MAP_HALF_ROW_PARAM(WORD P, BYTE MAP_ROW, BYTE DST_Y, BYTE MODE)
VAR WORD PARAM[];
VAR BYTE MAP[];
VAR X, I;
{
    PARAM = P;
    MAP = PARAM[0];
    FOR X = 0 TO PARAM[8] - 1 {
        I = MAP_ROW * PARAM[7] + PARAM[5] + X;
        MZ25_VRAM_PUT_MAP_TILE_V4_PARAM(P, PARAM[3] + X, PARAM[4] + DST_Y, MAP[I], MODE);
    }
}

// 横4ドットずれ状態で、表示範囲の端1行を4x4合成で補充する。
MZ25_VRAM_DRAW_MAP_HALF_ROW_XSHIFT_PARAM(WORD P, BYTE MAP_ROW, BYTE DST_Y, BYTE VMODE)
VAR WORD PARAM[];
VAR BYTE MAP[];
VAR X, I, M1, M2;
{
    PARAM = P;
    MAP = PARAM[0];
    M1 = VMODE * 4 + 2;
    M2 = VMODE * 4 + 1;
    FOR X = 0 TO PARAM[8] - 1 {
        I = MAP_ROW * PARAM[7] + PARAM[5] + X;
        MZ25_VRAM_PUT_MAP_TILE_4X4_PARAM(P, PARAM[3] + X, PARAM[4] + DST_Y, MAP[I], M1);
        I = MAP_ROW * PARAM[7] + PARAM[5] + X + 1;
        MZ25_VRAM_PUT_MAP_TILE_4X4_PARAM(P, PARAM[3] + X, PARAM[4] + DST_Y, MAP[I], M2);
    }
}

// 縦4ラインずれ状態で、表示範囲の端1列を4x4合成で補充する。
MZ25_VRAM_DRAW_MAP_HALF_COL_YSHIFT_PARAM(WORD P, BYTE MAP_COL, BYTE DST_COL, BYTE HMODE)
VAR WORD PARAM[];
VAR BYTE MAP[];
VAR Y, I, M1, M2;
{
    PARAM = P;
    MAP = PARAM[0];
    M1 = 4 + HMODE;
    M2 = HMODE;
    FOR Y = 0 TO PARAM[9] - 1 {
        I = (PARAM[6] + Y) * PARAM[7] + MAP_COL;
        MZ25_VRAM_PUT_MAP_TILE_4X4_PARAM(P, PARAM[3] + DST_COL, PARAM[4] + Y * 8, MAP[I], M1);
        I = (PARAM[6] + Y + 1) * PARAM[7] + MAP_COL;
        MZ25_VRAM_PUT_MAP_TILE_4X4_PARAM(P, PARAM[3] + DST_COL, PARAM[4] + Y * 8 + 4, MAP[I], M2);
    }
}



// -----------------------------------------------------------------------------
// 2プレーン版タイルマップ補助ルーチン。
// B,R の2プレーンだけを処理し、4色相当の描画速度比較に使う。
// タイルデータは16バイト構成、plane0 8バイト + plane1 8バイト。
// -----------------------------------------------------------------------------
MZ25_VRAM_PUT_TILE8_2P(BYTE PAGE, BYTE XBYTE, BYTE Y, WORD TADR)
{
    ^A = PAGE;
    #ASM
    LD   A,(_A)
    AND  03H
    LD   C,A
    AND  01H
    LD   B,A
    LD   A,C
    AND  02H
    ADD  A,A
    ADD  A,A
    ADD  A,B
    ADD  A,20H
    LD   (MZ25_VRAM_PUT_TILE8_2P_BLOCK),A
    #END

    ^A = XBYTE;
    #ASM
    LD   A,(_A)
    LD   (MZ25_VRAM_PUT_TILE8_2P_XBYTE),A
    #END

    ^A = Y;
    #ASM
    LD   A,(_A)
    LD   (MZ25_VRAM_PUT_TILE8_2P_Y),A
    #END

    ^HL = TADR;
    #ASM
    LD   HL,(_HL)
    LD   (MZ25_VRAM_PUT_TILE8_2P_SRC),HL

    DI
    LD   A,1
    OUT  (0B4H),A
    IN   A,(0B5H)
    LD   (MZ25_VRAM_PUT_TILE8_2P_SAVE),A

    LD   B,2
MZ25_VRAM_PUT_TILE8_2P_PLANE_LOOP:
    PUSH BC
    LD   A,1
    OUT  (0B4H),A
    LD   A,(MZ25_VRAM_PUT_TILE8_2P_BLOCK)
    OUT  (0B5H),A

    CALL MZ25_VRAM_PUT_TILE8_2P_PLANE

    LD   A,(MZ25_VRAM_PUT_TILE8_2P_BLOCK)
    ADD  A,2
    LD   (MZ25_VRAM_PUT_TILE8_2P_BLOCK),A
    POP  BC
    DJNZ MZ25_VRAM_PUT_TILE8_2P_PLANE_LOOP

    LD   A,1
    OUT  (0B4H),A
    LD   A,(MZ25_VRAM_PUT_TILE8_2P_SAVE)
    OUT  (0B5H),A
    EI
    JR   MZ25_VRAM_PUT_TILE8_2P_END

MZ25_VRAM_PUT_TILE8_2P_PLANE:
    CALL MZ25_VRAM_PUT_TILE8_2P_CALC_DEST
    EX   DE,HL
    LD   HL,(MZ25_VRAM_PUT_TILE8_2P_SRC)
    LD   B,8
MZ25_VRAM_PUT_TILE8_2P_ROW:
    LD   A,(HL)
    LD   (DE),A
    INC  HL
    PUSH HL
    LD   HL,40
    ADD  HL,DE
    EX   DE,HL
    POP  HL
    DJNZ MZ25_VRAM_PUT_TILE8_2P_ROW
    LD   (MZ25_VRAM_PUT_TILE8_2P_SRC),HL
    RET

MZ25_VRAM_PUT_TILE8_2P_CALC_DEST:
    LD   HL,2000H
    LD   A,(MZ25_VRAM_PUT_TILE8_2P_Y)
    OR   A
    JR   Z,MZ25_VRAM_PUT_TILE8_2P_ADD_X
    LD   B,A
    LD   DE,40
MZ25_VRAM_PUT_TILE8_2P_Y_LOOP:
    ADD  HL,DE
    DJNZ MZ25_VRAM_PUT_TILE8_2P_Y_LOOP
MZ25_VRAM_PUT_TILE8_2P_ADD_X:
    LD   A,(MZ25_VRAM_PUT_TILE8_2P_XBYTE)
    LD   E,A
    LD   D,0
    ADD  HL,DE
    RET

MZ25_VRAM_PUT_TILE8_2P_SAVE:
    DB   0
MZ25_VRAM_PUT_TILE8_2P_BLOCK:
    DB   0
MZ25_VRAM_PUT_TILE8_2P_XBYTE:
    DB   0
MZ25_VRAM_PUT_TILE8_2P_Y:
    DB   0
MZ25_VRAM_PUT_TILE8_2P_SRC:
    DW   0
MZ25_VRAM_PUT_TILE8_2P_END:
    #END
}

MZ25_VRAM_PUT_TILE4_2P(BYTE PAGE, BYTE XBYTE, BYTE Y, WORD TADR, BYTE MODE)
{
    ^A = PAGE;
    #ASM
    LD   A,(_A)
    AND  03H
    LD   C,A
    AND  01H
    LD   B,A
    LD   A,C
    AND  02H
    ADD  A,A
    ADD  A,A
    ADD  A,B
    ADD  A,20H
    LD   (MZ25_VRAM_PUT_TILE4_2P_BLOCK),A
    #END

    ^A = XBYTE;
    #ASM
    LD   A,(_A)
    LD   (MZ25_VRAM_PUT_TILE4_2P_XBYTE),A
    #END

    ^A = Y;
    #ASM
    LD   A,(_A)
    LD   (MZ25_VRAM_PUT_TILE4_2P_Y),A
    #END

    ^HL = TADR;
    #ASM
    LD   HL,(_HL)
    LD   (MZ25_VRAM_PUT_TILE4_2P_SRC),HL
    #END

    ^A = MODE;
    #ASM
    LD   A,(_A)
    AND  03H
    LD   (MZ25_VRAM_PUT_TILE4_2P_MODE),A

    DI
    LD   A,1
    OUT  (0B4H),A
    IN   A,(0B5H)
    LD   (MZ25_VRAM_PUT_TILE4_2P_SAVE),A

    LD   B,2
MZ25_VRAM_PUT_TILE4_2P_PLANE_LOOP:
    PUSH BC
    LD   A,1
    OUT  (0B4H),A
    LD   A,(MZ25_VRAM_PUT_TILE4_2P_BLOCK)
    OUT  (0B5H),A

    CALL MZ25_VRAM_PUT_TILE4_2P_PLANE

    LD   A,(MZ25_VRAM_PUT_TILE4_2P_BLOCK)
    ADD  A,2
    LD   (MZ25_VRAM_PUT_TILE4_2P_BLOCK),A
    POP  BC
    DJNZ MZ25_VRAM_PUT_TILE4_2P_PLANE_LOOP

    LD   A,1
    OUT  (0B4H),A
    LD   A,(MZ25_VRAM_PUT_TILE4_2P_SAVE)
    OUT  (0B5H),A
    EI
    JR   MZ25_VRAM_PUT_TILE4_2P_END

MZ25_VRAM_PUT_TILE4_2P_PLANE:
    CALL MZ25_VRAM_PUT_TILE4_2P_CALC_DEST
    EX   DE,HL
    LD   HL,(MZ25_VRAM_PUT_TILE4_2P_SRC)
    LD   B,8
MZ25_VRAM_PUT_TILE4_2P_ROW:
    LD   A,(HL)
    LD   C,A
    LD   A,(MZ25_VRAM_PUT_TILE4_2P_MODE)
    AND  02H
    JR   NZ,MZ25_VRAM_PUT_TILE4_2P_SRC_RIGHT
MZ25_VRAM_PUT_TILE4_2P_SRC_LEFT:
    LD   A,C
    AND  0FH
    JR   MZ25_VRAM_PUT_TILE4_2P_SRC_READY
MZ25_VRAM_PUT_TILE4_2P_SRC_RIGHT:
    LD   A,C
    AND  0F0H
    RRCA
    RRCA
    RRCA
    RRCA
MZ25_VRAM_PUT_TILE4_2P_SRC_READY:
    LD   C,A
    LD   A,(MZ25_VRAM_PUT_TILE4_2P_MODE)
    AND  01H
    JR   NZ,MZ25_VRAM_PUT_TILE4_2P_DST_RIGHT
MZ25_VRAM_PUT_TILE4_2P_DST_LEFT:
    LD   A,(DE)
    AND  0F0H
    OR   C
    LD   (DE),A
    JR   MZ25_VRAM_PUT_TILE4_2P_NEXT_ROW
MZ25_VRAM_PUT_TILE4_2P_DST_RIGHT:
    LD   A,C
    RLCA
    RLCA
    RLCA
    RLCA
    LD   C,A
    LD   A,(DE)
    AND  0FH
    OR   C
    LD   (DE),A
MZ25_VRAM_PUT_TILE4_2P_NEXT_ROW:
    INC  HL
    PUSH HL
    LD   HL,40
    ADD  HL,DE
    EX   DE,HL
    POP  HL
    DJNZ MZ25_VRAM_PUT_TILE4_2P_ROW
    LD   (MZ25_VRAM_PUT_TILE4_2P_SRC),HL
    RET

MZ25_VRAM_PUT_TILE4_2P_CALC_DEST:
    LD   HL,2000H
    LD   A,(MZ25_VRAM_PUT_TILE4_2P_Y)
    OR   A
    JR   Z,MZ25_VRAM_PUT_TILE4_2P_ADD_X
    LD   B,A
    LD   DE,40
MZ25_VRAM_PUT_TILE4_2P_Y_LOOP:
    ADD  HL,DE
    DJNZ MZ25_VRAM_PUT_TILE4_2P_Y_LOOP
MZ25_VRAM_PUT_TILE4_2P_ADD_X:
    LD   A,(MZ25_VRAM_PUT_TILE4_2P_XBYTE)
    LD   E,A
    LD   D,0
    ADD  HL,DE
    RET

MZ25_VRAM_PUT_TILE4_2P_SAVE:
    DB   0
MZ25_VRAM_PUT_TILE4_2P_BLOCK:
    DB   0
MZ25_VRAM_PUT_TILE4_2P_XBYTE:
    DB   0
MZ25_VRAM_PUT_TILE4_2P_Y:
    DB   0
MZ25_VRAM_PUT_TILE4_2P_MODE:
    DB   0
MZ25_VRAM_PUT_TILE4_2P_SRC:
    DW   0
MZ25_VRAM_PUT_TILE4_2P_END:
    #END
}

MZ25_VRAM_PUT_TILE_4X4_2P(BYTE PAGE, BYTE XBYTE, BYTE Y, WORD TADR, BYTE MODE)
{
    ^A = PAGE;
    #ASM
    LD   A,(_A)
    AND  03H
    LD   C,A
    AND  01H
    LD   B,A
    LD   A,C
    AND  02H
    ADD  A,A
    ADD  A,A
    ADD  A,B
    ADD  A,20H
    LD   (MZ25_VRAM_PUT_TILE_4X4_2P_BLOCK),A
    #END

    ^A = XBYTE;
    #ASM
    LD   A,(_A)
    LD   (MZ25_VRAM_PUT_TILE_4X4_2P_XBYTE),A
    #END

    ^A = Y;
    #ASM
    LD   A,(_A)
    LD   (MZ25_VRAM_PUT_TILE_4X4_2P_Y),A
    #END

    ^HL = TADR;
    #ASM
    LD   HL,(_HL)
    LD   (MZ25_VRAM_PUT_TILE_4X4_2P_SRC_BASE),HL
    #END

    ^A = MODE;
    #ASM
    LD   A,(_A)
    AND  07H
    LD   (MZ25_VRAM_PUT_TILE_4X4_2P_MODE),A

    DI
    LD   A,1
    OUT  (0B4H),A
    IN   A,(0B5H)
    LD   (MZ25_VRAM_PUT_TILE_4X4_2P_SAVE),A

    LD   B,2
MZ25_VRAM_PUT_TILE_4X4_2P_PLANE_LOOP:
    PUSH BC
    LD   A,1
    OUT  (0B4H),A
    LD   A,(MZ25_VRAM_PUT_TILE_4X4_2P_BLOCK)
    OUT  (0B5H),A

    CALL MZ25_VRAM_PUT_TILE_4X4_2P_PLANE

    LD   A,(MZ25_VRAM_PUT_TILE_4X4_2P_BLOCK)
    ADD  A,2
    LD   (MZ25_VRAM_PUT_TILE_4X4_2P_BLOCK),A
    LD   HL,(MZ25_VRAM_PUT_TILE_4X4_2P_SRC_BASE)
    LD   DE,8
    ADD  HL,DE
    LD   (MZ25_VRAM_PUT_TILE_4X4_2P_SRC_BASE),HL
    POP  BC
    DJNZ MZ25_VRAM_PUT_TILE_4X4_2P_PLANE_LOOP

    LD   A,1
    OUT  (0B4H),A
    LD   A,(MZ25_VRAM_PUT_TILE_4X4_2P_SAVE)
    OUT  (0B5H),A
    EI
    JR   MZ25_VRAM_PUT_TILE_4X4_2P_END

MZ25_VRAM_PUT_TILE_4X4_2P_PLANE:
    CALL MZ25_VRAM_PUT_TILE_4X4_2P_CALC_DEST
    EX   DE,HL
    LD   HL,(MZ25_VRAM_PUT_TILE_4X4_2P_SRC_BASE)
    LD   A,(MZ25_VRAM_PUT_TILE_4X4_2P_MODE)
    AND  04H
    JR   Z,MZ25_VRAM_PUT_TILE_4X4_2P_SRC_Y_READY
    INC  HL
    INC  HL
    INC  HL
    INC  HL
MZ25_VRAM_PUT_TILE_4X4_2P_SRC_Y_READY:
    LD   B,4
MZ25_VRAM_PUT_TILE_4X4_2P_ROW:
    LD   A,(HL)
    LD   C,A
    LD   A,(MZ25_VRAM_PUT_TILE_4X4_2P_MODE)
    AND  02H
    JR   NZ,MZ25_VRAM_PUT_TILE_4X4_2P_SRC_RIGHT
MZ25_VRAM_PUT_TILE_4X4_2P_SRC_LEFT:
    LD   A,C
    AND  0FH
    JR   MZ25_VRAM_PUT_TILE_4X4_2P_SRC_READY
MZ25_VRAM_PUT_TILE_4X4_2P_SRC_RIGHT:
    LD   A,C
    AND  0F0H
    RRCA
    RRCA
    RRCA
    RRCA
MZ25_VRAM_PUT_TILE_4X4_2P_SRC_READY:
    LD   C,A
    LD   A,(MZ25_VRAM_PUT_TILE_4X4_2P_MODE)
    AND  01H
    JR   NZ,MZ25_VRAM_PUT_TILE_4X4_2P_DST_RIGHT
MZ25_VRAM_PUT_TILE_4X4_2P_DST_LEFT:
    LD   A,(DE)
    AND  0F0H
    OR   C
    LD   (DE),A
    JR   MZ25_VRAM_PUT_TILE_4X4_2P_NEXT_ROW
MZ25_VRAM_PUT_TILE_4X4_2P_DST_RIGHT:
    LD   A,C
    RLCA
    RLCA
    RLCA
    RLCA
    LD   C,A
    LD   A,(DE)
    AND  0FH
    OR   C
    LD   (DE),A
MZ25_VRAM_PUT_TILE_4X4_2P_NEXT_ROW:
    INC  HL
    PUSH HL
    LD   HL,40
    ADD  HL,DE
    EX   DE,HL
    POP  HL
    DJNZ MZ25_VRAM_PUT_TILE_4X4_2P_ROW
    RET

MZ25_VRAM_PUT_TILE_4X4_2P_CALC_DEST:
    LD   HL,2000H
    LD   A,(MZ25_VRAM_PUT_TILE_4X4_2P_Y)
    OR   A
    JR   Z,MZ25_VRAM_PUT_TILE_4X4_2P_ADD_X
    LD   B,A
    LD   DE,40
MZ25_VRAM_PUT_TILE_4X4_2P_Y_LOOP:
    ADD  HL,DE
    DJNZ MZ25_VRAM_PUT_TILE_4X4_2P_Y_LOOP
MZ25_VRAM_PUT_TILE_4X4_2P_ADD_X:
    LD   A,(MZ25_VRAM_PUT_TILE_4X4_2P_XBYTE)
    LD   E,A
    LD   D,0
    ADD  HL,DE
    RET

MZ25_VRAM_PUT_TILE_4X4_2P_SAVE:
    DB   0
MZ25_VRAM_PUT_TILE_4X4_2P_BLOCK:
    DB   0
MZ25_VRAM_PUT_TILE_4X4_2P_XBYTE:
    DB   0
MZ25_VRAM_PUT_TILE_4X4_2P_Y:
    DB   0
MZ25_VRAM_PUT_TILE_4X4_2P_MODE:
    DB   0
MZ25_VRAM_PUT_TILE_4X4_2P_SRC_BASE:
    DW   0
MZ25_VRAM_PUT_TILE_4X4_2P_END:
    #END
}

MZ25_VRAM_PUT_TILE_V4_2P(BYTE PAGE, BYTE XBYTE, BYTE Y, WORD TADR, BYTE MODE)
{
    ^A = PAGE;
    #ASM
    LD   A,(_A)
    AND  03H
    LD   C,A
    AND  01H
    LD   B,A
    LD   A,C
    AND  02H
    ADD  A,A
    ADD  A,A
    ADD  A,B
    ADD  A,20H
    LD   (MZ25_VRAM_PUT_TILE_V4_2P_BLOCK),A
    #END

    ^A = XBYTE;
    #ASM
    LD   A,(_A)
    LD   (MZ25_VRAM_PUT_TILE_V4_2P_XBYTE),A
    #END

    ^A = Y;
    #ASM
    LD   A,(_A)
    LD   (MZ25_VRAM_PUT_TILE_V4_2P_Y),A
    #END

    ^HL = TADR;
    #ASM
    LD   HL,(_HL)
    LD   (MZ25_VRAM_PUT_TILE_V4_2P_SRC_BASE),HL
    #END

    ^A = MODE;
    #ASM
    LD   A,(_A)
    AND  01H
    LD   (MZ25_VRAM_PUT_TILE_V4_2P_MODE),A

    DI
    LD   A,1
    OUT  (0B4H),A
    IN   A,(0B5H)
    LD   (MZ25_VRAM_PUT_TILE_V4_2P_SAVE),A

    LD   B,2
MZ25_VRAM_PUT_TILE_V4_2P_PLANE_LOOP:
    PUSH BC
    LD   A,1
    OUT  (0B4H),A
    LD   A,(MZ25_VRAM_PUT_TILE_V4_2P_BLOCK)
    OUT  (0B5H),A

    CALL MZ25_VRAM_PUT_TILE_V4_2P_PLANE

    LD   A,(MZ25_VRAM_PUT_TILE_V4_2P_BLOCK)
    ADD  A,2
    LD   (MZ25_VRAM_PUT_TILE_V4_2P_BLOCK),A
    LD   HL,(MZ25_VRAM_PUT_TILE_V4_2P_SRC_BASE)
    LD   DE,8
    ADD  HL,DE
    LD   (MZ25_VRAM_PUT_TILE_V4_2P_SRC_BASE),HL
    POP  BC
    DJNZ MZ25_VRAM_PUT_TILE_V4_2P_PLANE_LOOP

    LD   A,1
    OUT  (0B4H),A
    LD   A,(MZ25_VRAM_PUT_TILE_V4_2P_SAVE)
    OUT  (0B5H),A
    EI
    JR   MZ25_VRAM_PUT_TILE_V4_2P_END

MZ25_VRAM_PUT_TILE_V4_2P_PLANE:
    CALL MZ25_VRAM_PUT_TILE_V4_2P_CALC_DEST
    EX   DE,HL
    LD   HL,(MZ25_VRAM_PUT_TILE_V4_2P_SRC_BASE)
    LD   A,(MZ25_VRAM_PUT_TILE_V4_2P_MODE)
    OR   A
    JR   Z,MZ25_VRAM_PUT_TILE_V4_2P_SRC_READY
    INC  HL
    INC  HL
    INC  HL
    INC  HL
MZ25_VRAM_PUT_TILE_V4_2P_SRC_READY:
    LD   B,4
MZ25_VRAM_PUT_TILE_V4_2P_ROW:
    LD   A,(HL)
    LD   (DE),A
    INC  HL
    PUSH HL
    LD   HL,40
    ADD  HL,DE
    EX   DE,HL
    POP  HL
    DJNZ MZ25_VRAM_PUT_TILE_V4_2P_ROW
    RET

MZ25_VRAM_PUT_TILE_V4_2P_CALC_DEST:
    LD   HL,2000H
    LD   A,(MZ25_VRAM_PUT_TILE_V4_2P_Y)
    OR   A
    JR   Z,MZ25_VRAM_PUT_TILE_V4_2P_ADD_X
    LD   B,A
    LD   DE,40
MZ25_VRAM_PUT_TILE_V4_2P_Y_LOOP:
    ADD  HL,DE
    DJNZ MZ25_VRAM_PUT_TILE_V4_2P_Y_LOOP
MZ25_VRAM_PUT_TILE_V4_2P_ADD_X:
    LD   A,(MZ25_VRAM_PUT_TILE_V4_2P_XBYTE)
    LD   E,A
    LD   D,0
    ADD  HL,DE
    RET

MZ25_VRAM_PUT_TILE_V4_2P_SAVE:
    DB   0
MZ25_VRAM_PUT_TILE_V4_2P_BLOCK:
    DB   0
MZ25_VRAM_PUT_TILE_V4_2P_XBYTE:
    DB   0
MZ25_VRAM_PUT_TILE_V4_2P_Y:
    DB   0
MZ25_VRAM_PUT_TILE_V4_2P_MODE:
    DB   0
MZ25_VRAM_PUT_TILE_V4_2P_SRC_BASE:
    DW   0
MZ25_VRAM_PUT_TILE_V4_2P_END:
    #END
}

MZ25_VRAM_SHIFT_RECT_UP4_2P(BYTE PAGE, BYTE XBYTE, BYTE Y, BYTE WBYTE, BYTE H)
{
    ^A = PAGE;
    #ASM
    LD   A,(_A)
    AND  03H
    LD   C,A
    AND  01H
    LD   B,A
    LD   A,C
    AND  02H
    ADD  A,A
    ADD  A,A
    ADD  A,B
    ADD  A,20H
    LD   (MZ25_VRAM_SHIFT_RECT_UP4_2P_BLOCK),A
    #END

    ^A = XBYTE;
    #ASM
    LD   A,(_A)
    LD   (MZ25_VRAM_SHIFT_RECT_UP4_2P_XBYTE),A
    #END

    ^A = Y;
    #ASM
    LD   A,(_A)
    LD   (MZ25_VRAM_SHIFT_RECT_UP4_2P_Y),A
    #END

    ^A = WBYTE;
    #ASM
    LD   A,(_A)
    LD   (MZ25_VRAM_SHIFT_RECT_UP4_2P_WBYTE),A
    #END

    ^A = H;
    #ASM
    LD   A,(_A)
    LD   (MZ25_VRAM_SHIFT_RECT_UP4_2P_H),A

    LD   A,(MZ25_VRAM_SHIFT_RECT_UP4_2P_H)
    CP   5
    JP   C,MZ25_VRAM_SHIFT_RECT_UP4_2P_END
    SUB  4
    LD   (MZ25_VRAM_SHIFT_RECT_UP4_2P_ROWS),A
    LD   A,(MZ25_VRAM_SHIFT_RECT_UP4_2P_WBYTE)
    OR   A
    JP   Z,MZ25_VRAM_SHIFT_RECT_UP4_2P_END
    LD   C,A
    LD   B,0
    LD   A,40
    SUB  C
    LD   (MZ25_VRAM_SHIFT_RECT_UP4_2P_LINEADD),A

    DI
    LD   A,1
    OUT  (0B4H),A
    IN   A,(0B5H)
    LD   (MZ25_VRAM_SHIFT_RECT_UP4_2P_SAVE),A

    LD   B,2
MZ25_VRAM_SHIFT_RECT_UP4_2P_PLANE:
    PUSH BC
    LD   A,1
    OUT  (0B4H),A
    LD   A,(MZ25_VRAM_SHIFT_RECT_UP4_2P_BLOCK)
    OUT  (0B5H),A

    CALL MZ25_VRAM_SHIFT_RECT_UP4_2P_BLOCK_PROC

    LD   A,(MZ25_VRAM_SHIFT_RECT_UP4_2P_BLOCK)
    ADD  A,2
    LD   (MZ25_VRAM_SHIFT_RECT_UP4_2P_BLOCK),A
    POP  BC
    DJNZ MZ25_VRAM_SHIFT_RECT_UP4_2P_PLANE

    LD   A,1
    OUT  (0B4H),A
    LD   A,(MZ25_VRAM_SHIFT_RECT_UP4_2P_SAVE)
    OUT  (0B5H),A
    EI
    JR   MZ25_VRAM_SHIFT_RECT_UP4_2P_END

MZ25_VRAM_SHIFT_RECT_UP4_2P_BLOCK_PROC:
    CALL MZ25_VRAM_SHIFT_RECT_UP4_2P_CALC_START
    LD   D,H
    LD   E,L
    LD   BC,160
    ADD  HL,BC
    LD   A,(MZ25_VRAM_SHIFT_RECT_UP4_2P_ROWS)
MZ25_VRAM_SHIFT_RECT_UP4_2P_LINE:
    LD   (MZ25_VRAM_SHIFT_RECT_UP4_2P_WRAP),A
    LD   A,(MZ25_VRAM_SHIFT_RECT_UP4_2P_WBYTE)
    LD   C,A
    LD   B,0
    LDIR
    LD   A,(MZ25_VRAM_SHIFT_RECT_UP4_2P_LINEADD)
    LD   C,A
    LD   B,0
    ADD  HL,BC
    EX   DE,HL
    ADD  HL,BC
    EX   DE,HL
    LD   A,(MZ25_VRAM_SHIFT_RECT_UP4_2P_WRAP)
    DEC  A
    JR   NZ,MZ25_VRAM_SHIFT_RECT_UP4_2P_LINE
    RET

MZ25_VRAM_SHIFT_RECT_UP4_2P_CALC_START:
    LD   HL,2000H
    LD   A,(MZ25_VRAM_SHIFT_RECT_UP4_2P_Y)
    OR   A
    JR   Z,MZ25_VRAM_SHIFT_RECT_UP4_2P_ADD_X
    LD   B,A
    LD   DE,40
MZ25_VRAM_SHIFT_RECT_UP4_2P_Y_LOOP:
    ADD  HL,DE
    DJNZ MZ25_VRAM_SHIFT_RECT_UP4_2P_Y_LOOP
MZ25_VRAM_SHIFT_RECT_UP4_2P_ADD_X:
    LD   A,(MZ25_VRAM_SHIFT_RECT_UP4_2P_XBYTE)
    LD   E,A
    LD   D,0
    ADD  HL,DE
    RET

MZ25_VRAM_SHIFT_RECT_UP4_2P_WRAP:
    DB   0
MZ25_VRAM_SHIFT_RECT_UP4_2P_SAVE:
    DB   0
MZ25_VRAM_SHIFT_RECT_UP4_2P_BLOCK:
    DB   0
MZ25_VRAM_SHIFT_RECT_UP4_2P_XBYTE:
    DB   0
MZ25_VRAM_SHIFT_RECT_UP4_2P_Y:
    DB   0
MZ25_VRAM_SHIFT_RECT_UP4_2P_WBYTE:
    DB   0
MZ25_VRAM_SHIFT_RECT_UP4_2P_H:
    DB   0
MZ25_VRAM_SHIFT_RECT_UP4_2P_ROWS:
    DB   0
MZ25_VRAM_SHIFT_RECT_UP4_2P_LINEADD:
    DB   0
MZ25_VRAM_SHIFT_RECT_UP4_2P_END:
    #END
}

