// MZ-2500 VRAM direct graphics helpers.
//
// 320x200x16色を主対象にした、IOCSを介さないVRAM直接操作用ライブラリ。
// VRAM本体は 8KB ブロック $20-$2F に割り当てられている想定。
// このライブラリではメモリマップレジスタ1を使い、2000H-3FFFH に
// 1ブロックずつVRAMを割り当てて処理する。
//
// 320x200x16色では、1ページは4プレーン x 8000バイト。
// ブロック配置はプレーン単位にページが並ぶものとして扱う。
//
//   plane0: page0=$20 page1=$21 page2=$22 page3=$23
//   plane1: page0=$24 page1=$25 page2=$26 page3=$27
//   plane2: page0=$28 page1=$29 page2=$2A page3=$2B
//   plane3: page0=$2C page1=$2D page2=$2E page3=$2F
//
// 各プレーン内は 1ライン40バイト x 200ラインの連続配置。
//
// 注意:
// - 処理中はメモリマップレジスタ1を一時的に変更する。
// - 割り込み中に2000H-3FFFHを参照されると危険なため、処理中はDIする。
// - X方向8ドット単位、つまりVRAM上の1バイト単位で処理する。

// 320x200x16色ページを8ドット左へループスクロールする。
// PAGE: 0..3
MZ25_VRAM_SCROLL_LEFT8(BYTE PAGE)
{
    ^A = PAGE;
    #ASM
    LD   A,(_A)
    AND  03H
    ADD  A,20H
    LD   (MZ25_VRAM_SCROLL_LEFT8_BLOCK),A

    DI
    LD   A,1
    OUT  (0B4H),A
    IN   A,(0B5H)
    LD   (MZ25_VRAM_SCROLL_LEFT8_SAVE),A

    LD   B,4
MZ25_VRAM_SCROLL_LEFT8_PLANE:
    PUSH BC
    LD   A,1
    OUT  (0B4H),A
    LD   A,(MZ25_VRAM_SCROLL_LEFT8_BLOCK)
    OUT  (0B5H),A

    CALL MZ25_VRAM_SCROLL_LEFT8_BLOCK_PROC

    LD   A,(MZ25_VRAM_SCROLL_LEFT8_BLOCK)
    ADD  A,4
    LD   (MZ25_VRAM_SCROLL_LEFT8_BLOCK),A
    POP  BC
    DJNZ MZ25_VRAM_SCROLL_LEFT8_PLANE

    LD   A,1
    OUT  (0B4H),A
    LD   A,(MZ25_VRAM_SCROLL_LEFT8_SAVE)
    OUT  (0B5H),A
    EI
    JR   MZ25_VRAM_SCROLL_LEFT8_END

MZ25_VRAM_SCROLL_LEFT8_BLOCK_PROC:
    LD   HL,2000H
    LD   A,200
MZ25_VRAM_SCROLL_LEFT8_LINE:
    LD   (MZ25_VRAM_SCROLL_LEFT8_WRAP),A
    LD   A,(HL)
    LD   (MZ25_VRAM_SCROLL_LEFT8_FIRST),A
    LD   D,H
    LD   E,L
    INC  HL
    LD   BC,39
    LDIR
    LD   A,(MZ25_VRAM_SCROLL_LEFT8_FIRST)
    LD   (DE),A
    EX   DE,HL
    INC  HL
    LD   A,(MZ25_VRAM_SCROLL_LEFT8_WRAP)
    DEC  A
    JR   NZ,MZ25_VRAM_SCROLL_LEFT8_LINE
    RET

MZ25_VRAM_SCROLL_LEFT8_FIRST:
    DB   0
MZ25_VRAM_SCROLL_LEFT8_WRAP:
    DB   0
MZ25_VRAM_SCROLL_LEFT8_SAVE:
    DB   0
MZ25_VRAM_SCROLL_LEFT8_BLOCK:
    DB   0
MZ25_VRAM_SCROLL_LEFT8_END:
    #END
}

// 320x200x16色ページを8ドット右へループスクロールする。
// PAGE: 0..3
MZ25_VRAM_SCROLL_RIGHT8(BYTE PAGE)
{
    ^A = PAGE;
    #ASM
    LD   A,(_A)
    AND  03H
    ADD  A,20H
    LD   (MZ25_VRAM_SCROLL_RIGHT8_BLOCK),A

    DI
    LD   A,1
    OUT  (0B4H),A
    IN   A,(0B5H)
    LD   (MZ25_VRAM_SCROLL_RIGHT8_SAVE),A

    LD   B,4
MZ25_VRAM_SCROLL_RIGHT8_PLANE:
    PUSH BC
    LD   A,1
    OUT  (0B4H),A
    LD   A,(MZ25_VRAM_SCROLL_RIGHT8_BLOCK)
    OUT  (0B5H),A

    CALL MZ25_VRAM_SCROLL_RIGHT8_BLOCK_PROC

    LD   A,(MZ25_VRAM_SCROLL_RIGHT8_BLOCK)
    ADD  A,4
    LD   (MZ25_VRAM_SCROLL_RIGHT8_BLOCK),A
    POP  BC
    DJNZ MZ25_VRAM_SCROLL_RIGHT8_PLANE

    LD   A,1
    OUT  (0B4H),A
    LD   A,(MZ25_VRAM_SCROLL_RIGHT8_SAVE)
    OUT  (0B5H),A
    EI
    JR   MZ25_VRAM_SCROLL_RIGHT8_END

MZ25_VRAM_SCROLL_RIGHT8_BLOCK_PROC:
    LD   HL,2027H
    LD   A,200
MZ25_VRAM_SCROLL_RIGHT8_LINE:
    LD   (MZ25_VRAM_SCROLL_RIGHT8_WRAP),A
    LD   A,(HL)
    LD   (MZ25_VRAM_SCROLL_RIGHT8_LAST),A
    LD   D,H
    LD   E,L
    DEC  HL
    LD   BC,39
    LDDR
    LD   A,(MZ25_VRAM_SCROLL_RIGHT8_LAST)
    LD   (DE),A
    EX   DE,HL
    LD   BC,79
    ADD  HL,BC
    LD   A,(MZ25_VRAM_SCROLL_RIGHT8_WRAP)
    DEC  A
    JR   NZ,MZ25_VRAM_SCROLL_RIGHT8_LINE
    RET

MZ25_VRAM_SCROLL_RIGHT8_LAST:
    DB   0
MZ25_VRAM_SCROLL_RIGHT8_WRAP:
    DB   0
MZ25_VRAM_SCROLL_RIGHT8_SAVE:
    DB   0
MZ25_VRAM_SCROLL_RIGHT8_BLOCK:
    DB   0
MZ25_VRAM_SCROLL_RIGHT8_END:
    #END
}
// 320x200x16色ページの指定矩形を8ドット左へループスクロールする。
// XBYTE と WBYTE は8ドット単位。例: X=40, 幅=240なら XBYTE=5, WBYTE=30。
// PAGE: 0..3, XBYTE: 0..39, Y: 0..199, WBYTE: 1..40, H: 1..200
MZ25_VRAM_SCROLL_RECT_LEFT8(BYTE PAGE, BYTE XBYTE, BYTE Y, BYTE WBYTE, BYTE H)
{
    ^A = PAGE;
    #ASM
    LD   A,(_A)
    AND  03H
    ADD  A,20H
    LD   (MZ25_VRAM_SCROLL_RECT_LEFT8_BLOCK),A
    #END

    ^A = XBYTE;
    #ASM
    LD   A,(_A)
    LD   (MZ25_VRAM_SCROLL_RECT_LEFT8_XBYTE),A
    #END

    ^A = Y;
    #ASM
    LD   A,(_A)
    LD   (MZ25_VRAM_SCROLL_RECT_LEFT8_Y),A
    #END

    ^A = WBYTE;
    #ASM
    LD   A,(_A)
    LD   (MZ25_VRAM_SCROLL_RECT_LEFT8_WBYTE),A
    #END

    ^A = H;
    #ASM
    LD   A,(_A)
    LD   (MZ25_VRAM_SCROLL_RECT_LEFT8_H),A

    LD   A,(MZ25_VRAM_SCROLL_RECT_LEFT8_H)
    OR   A
    JP   Z,MZ25_VRAM_SCROLL_RECT_LEFT8_END
    LD   A,(MZ25_VRAM_SCROLL_RECT_LEFT8_WBYTE)
    CP   2
    JP   C,MZ25_VRAM_SCROLL_RECT_LEFT8_END

    LD   B,A
    DEC  B
    LD   A,B
    LD   (MZ25_VRAM_SCROLL_RECT_LEFT8_COUNT),A
    LD   A,40
    SUB  B
    DEC  A
    LD   (MZ25_VRAM_SCROLL_RECT_LEFT8_LINEADD),A

    DI
    LD   A,1
    OUT  (0B4H),A
    IN   A,(0B5H)
    LD   (MZ25_VRAM_SCROLL_RECT_LEFT8_SAVE),A

    LD   B,4
MZ25_VRAM_SCROLL_RECT_LEFT8_PLANE:
    PUSH BC
    LD   A,1
    OUT  (0B4H),A
    LD   A,(MZ25_VRAM_SCROLL_RECT_LEFT8_BLOCK)
    OUT  (0B5H),A

    CALL MZ25_VRAM_SCROLL_RECT_LEFT8_BLOCK_PROC

    LD   A,(MZ25_VRAM_SCROLL_RECT_LEFT8_BLOCK)
    ADD  A,4
    LD   (MZ25_VRAM_SCROLL_RECT_LEFT8_BLOCK),A
    POP  BC
    DJNZ MZ25_VRAM_SCROLL_RECT_LEFT8_PLANE

    LD   A,1
    OUT  (0B4H),A
    LD   A,(MZ25_VRAM_SCROLL_RECT_LEFT8_SAVE)
    OUT  (0B5H),A
    EI
    JR   MZ25_VRAM_SCROLL_RECT_LEFT8_END

MZ25_VRAM_SCROLL_RECT_LEFT8_BLOCK_PROC:
    CALL MZ25_VRAM_SCROLL_RECT_LEFT8_CALC_START
    LD   A,(MZ25_VRAM_SCROLL_RECT_LEFT8_H)
MZ25_VRAM_SCROLL_RECT_LEFT8_LINE:
    LD   (MZ25_VRAM_SCROLL_RECT_LEFT8_WRAP),A
    LD   A,(HL)
    LD   (MZ25_VRAM_SCROLL_RECT_LEFT8_FIRST),A
    LD   D,H
    LD   E,L
    INC  HL
    LD   A,(MZ25_VRAM_SCROLL_RECT_LEFT8_COUNT)
    LD   C,A
    LD   B,0
    LDIR
    LD   A,(MZ25_VRAM_SCROLL_RECT_LEFT8_FIRST)
    LD   (DE),A
    EX   DE,HL
    INC  HL
    LD   A,(MZ25_VRAM_SCROLL_RECT_LEFT8_LINEADD)
    LD   C,A
    LD   B,0
    ADD  HL,BC
    LD   A,(MZ25_VRAM_SCROLL_RECT_LEFT8_WRAP)
    DEC  A
    JR   NZ,MZ25_VRAM_SCROLL_RECT_LEFT8_LINE
    RET

MZ25_VRAM_SCROLL_RECT_LEFT8_CALC_START:
    LD   HL,2000H
    LD   A,(MZ25_VRAM_SCROLL_RECT_LEFT8_Y)
    OR   A
    JR   Z,MZ25_VRAM_SCROLL_RECT_LEFT8_ADD_X
    LD   B,A
    LD   DE,40
MZ25_VRAM_SCROLL_RECT_LEFT8_Y_LOOP:
    ADD  HL,DE
    DJNZ MZ25_VRAM_SCROLL_RECT_LEFT8_Y_LOOP
MZ25_VRAM_SCROLL_RECT_LEFT8_ADD_X:
    LD   A,(MZ25_VRAM_SCROLL_RECT_LEFT8_XBYTE)
    LD   E,A
    LD   D,0
    ADD  HL,DE
    RET

MZ25_VRAM_SCROLL_RECT_LEFT8_FIRST:
    DB   0
MZ25_VRAM_SCROLL_RECT_LEFT8_WRAP:
    DB   0
MZ25_VRAM_SCROLL_RECT_LEFT8_SAVE:
    DB   0
MZ25_VRAM_SCROLL_RECT_LEFT8_BLOCK:
    DB   0
MZ25_VRAM_SCROLL_RECT_LEFT8_XBYTE:
    DB   0
MZ25_VRAM_SCROLL_RECT_LEFT8_Y:
    DB   0
MZ25_VRAM_SCROLL_RECT_LEFT8_WBYTE:
    DB   0
MZ25_VRAM_SCROLL_RECT_LEFT8_H:
    DB   0
MZ25_VRAM_SCROLL_RECT_LEFT8_COUNT:
    DB   0
MZ25_VRAM_SCROLL_RECT_LEFT8_LINEADD:
    DB   0
MZ25_VRAM_SCROLL_RECT_LEFT8_END:
    #END
}

// 320x200x16色ページの指定矩形を8ドット右へループスクロールする。
// XBYTE と WBYTE は8ドット単位。例: X=40, 幅=240なら XBYTE=5, WBYTE=30。
// PAGE: 0..3, XBYTE: 0..39, Y: 0..199, WBYTE: 1..40, H: 1..200
MZ25_VRAM_SCROLL_RECT_RIGHT8(BYTE PAGE, BYTE XBYTE, BYTE Y, BYTE WBYTE, BYTE H)
{
    ^A = PAGE;
    #ASM
    LD   A,(_A)
    AND  03H
    ADD  A,20H
    LD   (MZ25_VRAM_SCROLL_RECT_RIGHT8_BLOCK),A
    #END

    ^A = XBYTE;
    #ASM
    LD   A,(_A)
    LD   (MZ25_VRAM_SCROLL_RECT_RIGHT8_XBYTE),A
    #END

    ^A = Y;
    #ASM
    LD   A,(_A)
    LD   (MZ25_VRAM_SCROLL_RECT_RIGHT8_Y),A
    #END

    ^A = WBYTE;
    #ASM
    LD   A,(_A)
    LD   (MZ25_VRAM_SCROLL_RECT_RIGHT8_WBYTE),A
    #END

    ^A = H;
    #ASM
    LD   A,(_A)
    LD   (MZ25_VRAM_SCROLL_RECT_RIGHT8_H),A

    LD   A,(MZ25_VRAM_SCROLL_RECT_RIGHT8_H)
    OR   A
    JP   Z,MZ25_VRAM_SCROLL_RECT_RIGHT8_END
    LD   A,(MZ25_VRAM_SCROLL_RECT_RIGHT8_WBYTE)
    CP   2
    JP   C,MZ25_VRAM_SCROLL_RECT_RIGHT8_END

    LD   B,A
    DEC  B
    LD   A,B
    LD   (MZ25_VRAM_SCROLL_RECT_RIGHT8_COUNT),A
    LD   A,(MZ25_VRAM_SCROLL_RECT_RIGHT8_WBYTE)
    ADD  A,39
    LD   (MZ25_VRAM_SCROLL_RECT_RIGHT8_LINEADD),A

    DI
    LD   A,1
    OUT  (0B4H),A
    IN   A,(0B5H)
    LD   (MZ25_VRAM_SCROLL_RECT_RIGHT8_SAVE),A

    LD   B,4
MZ25_VRAM_SCROLL_RECT_RIGHT8_PLANE:
    PUSH BC
    LD   A,1
    OUT  (0B4H),A
    LD   A,(MZ25_VRAM_SCROLL_RECT_RIGHT8_BLOCK)
    OUT  (0B5H),A

    CALL MZ25_VRAM_SCROLL_RECT_RIGHT8_BLOCK_PROC

    LD   A,(MZ25_VRAM_SCROLL_RECT_RIGHT8_BLOCK)
    ADD  A,4
    LD   (MZ25_VRAM_SCROLL_RECT_RIGHT8_BLOCK),A
    POP  BC
    DJNZ MZ25_VRAM_SCROLL_RECT_RIGHT8_PLANE

    LD   A,1
    OUT  (0B4H),A
    LD   A,(MZ25_VRAM_SCROLL_RECT_RIGHT8_SAVE)
    OUT  (0B5H),A
    EI
    JR   MZ25_VRAM_SCROLL_RECT_RIGHT8_END

MZ25_VRAM_SCROLL_RECT_RIGHT8_BLOCK_PROC:
    CALL MZ25_VRAM_SCROLL_RECT_RIGHT8_CALC_START
    LD   A,(MZ25_VRAM_SCROLL_RECT_RIGHT8_H)
MZ25_VRAM_SCROLL_RECT_RIGHT8_LINE:
    LD   (MZ25_VRAM_SCROLL_RECT_RIGHT8_WRAP),A
    LD   A,(HL)
    LD   (MZ25_VRAM_SCROLL_RECT_RIGHT8_LAST),A
    LD   D,H
    LD   E,L
    DEC  HL
    LD   A,(MZ25_VRAM_SCROLL_RECT_RIGHT8_COUNT)
    LD   C,A
    LD   B,0
    LDDR
    LD   A,(MZ25_VRAM_SCROLL_RECT_RIGHT8_LAST)
    LD   (DE),A
    EX   DE,HL
    LD   A,(MZ25_VRAM_SCROLL_RECT_RIGHT8_LINEADD)
    LD   C,A
    LD   B,0
    ADD  HL,BC
    LD   A,(MZ25_VRAM_SCROLL_RECT_RIGHT8_WRAP)
    DEC  A
    JR   NZ,MZ25_VRAM_SCROLL_RECT_RIGHT8_LINE
    RET

MZ25_VRAM_SCROLL_RECT_RIGHT8_CALC_START:
    LD   HL,2000H
    LD   A,(MZ25_VRAM_SCROLL_RECT_RIGHT8_Y)
    OR   A
    JR   Z,MZ25_VRAM_SCROLL_RECT_RIGHT8_ADD_X
    LD   B,A
    LD   DE,40
MZ25_VRAM_SCROLL_RECT_RIGHT8_Y_LOOP:
    ADD  HL,DE
    DJNZ MZ25_VRAM_SCROLL_RECT_RIGHT8_Y_LOOP
MZ25_VRAM_SCROLL_RECT_RIGHT8_ADD_X:
    LD   A,(MZ25_VRAM_SCROLL_RECT_RIGHT8_XBYTE)
    LD   E,A
    LD   D,0
    ADD  HL,DE
    LD   A,(MZ25_VRAM_SCROLL_RECT_RIGHT8_WBYTE)
    DEC  A
    LD   E,A
    LD   D,0
    ADD  HL,DE
    RET

MZ25_VRAM_SCROLL_RECT_RIGHT8_LAST:
    DB   0
MZ25_VRAM_SCROLL_RECT_RIGHT8_WRAP:
    DB   0
MZ25_VRAM_SCROLL_RECT_RIGHT8_SAVE:
    DB   0
MZ25_VRAM_SCROLL_RECT_RIGHT8_BLOCK:
    DB   0
MZ25_VRAM_SCROLL_RECT_RIGHT8_XBYTE:
    DB   0
MZ25_VRAM_SCROLL_RECT_RIGHT8_Y:
    DB   0
MZ25_VRAM_SCROLL_RECT_RIGHT8_WBYTE:
    DB   0
MZ25_VRAM_SCROLL_RECT_RIGHT8_H:
    DB   0
MZ25_VRAM_SCROLL_RECT_RIGHT8_COUNT:
    DB   0
MZ25_VRAM_SCROLL_RECT_RIGHT8_LINEADD:
    DB   0
MZ25_VRAM_SCROLL_RECT_RIGHT8_END:
    #END
}
// 8x8ドットの4プレーンタイルを、320x200x16色ページへ描画する。
// タイルデータは32バイト構成。plane0, plane1, plane2, plane3 の順に各8バイト。
// PAGE: 0..3, XBYTE: 0..39, Y: 0..192, TADR: タイルデータ先頭アドレス。
MZ25_VRAM_PUT_TILE8(BYTE PAGE, BYTE XBYTE, BYTE Y, WORD TADR)
{
    ^A = PAGE;
    #ASM
    LD   A,(_A)
    AND  03H
    ADD  A,20H
    LD   (MZ25_VRAM_PUT_TILE8_BLOCK),A
    #END

    ^A = XBYTE;
    #ASM
    LD   A,(_A)
    LD   (MZ25_VRAM_PUT_TILE8_XBYTE),A
    #END

    ^A = Y;
    #ASM
    LD   A,(_A)
    LD   (MZ25_VRAM_PUT_TILE8_Y),A
    #END

    ^HL = TADR;
    #ASM
    LD   HL,(_HL)
    LD   (MZ25_VRAM_PUT_TILE8_SRC),HL

    DI
    LD   A,1
    OUT  (0B4H),A
    IN   A,(0B5H)
    LD   (MZ25_VRAM_PUT_TILE8_SAVE),A

    LD   B,4
MZ25_VRAM_PUT_TILE8_PLANE_LOOP:
    PUSH BC
    LD   A,1
    OUT  (0B4H),A
    LD   A,(MZ25_VRAM_PUT_TILE8_BLOCK)
    OUT  (0B5H),A

    CALL MZ25_VRAM_PUT_TILE8_PLANE

    LD   A,(MZ25_VRAM_PUT_TILE8_BLOCK)
    ADD  A,4
    LD   (MZ25_VRAM_PUT_TILE8_BLOCK),A
    POP  BC
    DJNZ MZ25_VRAM_PUT_TILE8_PLANE_LOOP

    LD   A,1
    OUT  (0B4H),A
    LD   A,(MZ25_VRAM_PUT_TILE8_SAVE)
    OUT  (0B5H),A
    EI
    JR   MZ25_VRAM_PUT_TILE8_END

MZ25_VRAM_PUT_TILE8_PLANE:
    CALL MZ25_VRAM_PUT_TILE8_CALC_DEST
    EX   DE,HL
    LD   HL,(MZ25_VRAM_PUT_TILE8_SRC)
    LD   B,8
MZ25_VRAM_PUT_TILE8_ROW:
    LD   A,(HL)
    LD   (DE),A
    INC  HL
    PUSH HL
    LD   HL,40
    ADD  HL,DE
    EX   DE,HL
    POP  HL
    DJNZ MZ25_VRAM_PUT_TILE8_ROW
    LD   (MZ25_VRAM_PUT_TILE8_SRC),HL
    RET

MZ25_VRAM_PUT_TILE8_CALC_DEST:
    LD   HL,2000H
    LD   A,(MZ25_VRAM_PUT_TILE8_Y)
    OR   A
    JR   Z,MZ25_VRAM_PUT_TILE8_ADD_X
    LD   B,A
    LD   DE,40
MZ25_VRAM_PUT_TILE8_Y_LOOP:
    ADD  HL,DE
    DJNZ MZ25_VRAM_PUT_TILE8_Y_LOOP
MZ25_VRAM_PUT_TILE8_ADD_X:
    LD   A,(MZ25_VRAM_PUT_TILE8_XBYTE)
    LD   E,A
    LD   D,0
    ADD  HL,DE
    RET

MZ25_VRAM_PUT_TILE8_SAVE:
    DB   0
MZ25_VRAM_PUT_TILE8_BLOCK:
    DB   0
MZ25_VRAM_PUT_TILE8_XBYTE:
    DB   0
MZ25_VRAM_PUT_TILE8_Y:
    DB   0
MZ25_VRAM_PUT_TILE8_SRC:
    DW   0
MZ25_VRAM_PUT_TILE8_END:
    #END
}
// 320x200x16色ページの指定矩形を8ドット上へスクロールする。
// 下端8ラインは未更新になるため、呼び出し側で新しいタイル行を描画する。
// PAGE: 0..3, XBYTE: 0..39, Y: 0..199, WBYTE: 1..40, H: 9..200
MZ25_VRAM_SCROLL_RECT_UP8(BYTE PAGE, BYTE XBYTE, BYTE Y, BYTE WBYTE, BYTE H)
{
    ^A = PAGE;
    #ASM
    LD   A,(_A)
    AND  03H
    ADD  A,20H
    LD   (MZ25_VRAM_SCROLL_RECT_UP8_BLOCK),A
    #END

    ^A = XBYTE;
    #ASM
    LD   A,(_A)
    LD   (MZ25_VRAM_SCROLL_RECT_UP8_XBYTE),A
    #END

    ^A = Y;
    #ASM
    LD   A,(_A)
    LD   (MZ25_VRAM_SCROLL_RECT_UP8_Y),A
    #END

    ^A = WBYTE;
    #ASM
    LD   A,(_A)
    LD   (MZ25_VRAM_SCROLL_RECT_UP8_WBYTE),A
    #END

    ^A = H;
    #ASM
    LD   A,(_A)
    LD   (MZ25_VRAM_SCROLL_RECT_UP8_H),A

    LD   A,(MZ25_VRAM_SCROLL_RECT_UP8_H)
    CP   9
    JP   C,MZ25_VRAM_SCROLL_RECT_UP8_END
    SUB  8
    LD   (MZ25_VRAM_SCROLL_RECT_UP8_ROWS),A
    LD   A,(MZ25_VRAM_SCROLL_RECT_UP8_WBYTE)
    OR   A
    JP   Z,MZ25_VRAM_SCROLL_RECT_UP8_END
    LD   C,A
    LD   B,0
    LD   A,40
    SUB  C
    LD   (MZ25_VRAM_SCROLL_RECT_UP8_LINEADD),A

    DI
    LD   A,1
    OUT  (0B4H),A
    IN   A,(0B5H)
    LD   (MZ25_VRAM_SCROLL_RECT_UP8_SAVE),A

    LD   B,4
MZ25_VRAM_SCROLL_RECT_UP8_PLANE:
    PUSH BC
    LD   A,1
    OUT  (0B4H),A
    LD   A,(MZ25_VRAM_SCROLL_RECT_UP8_BLOCK)
    OUT  (0B5H),A

    CALL MZ25_VRAM_SCROLL_RECT_UP8_BLOCK_PROC

    LD   A,(MZ25_VRAM_SCROLL_RECT_UP8_BLOCK)
    ADD  A,4
    LD   (MZ25_VRAM_SCROLL_RECT_UP8_BLOCK),A
    POP  BC
    DJNZ MZ25_VRAM_SCROLL_RECT_UP8_PLANE

    LD   A,1
    OUT  (0B4H),A
    LD   A,(MZ25_VRAM_SCROLL_RECT_UP8_SAVE)
    OUT  (0B5H),A
    EI
    JR   MZ25_VRAM_SCROLL_RECT_UP8_END

MZ25_VRAM_SCROLL_RECT_UP8_BLOCK_PROC:
    CALL MZ25_VRAM_SCROLL_RECT_UP8_CALC_START
    LD   D,H
    LD   E,L
    LD   BC,320
    ADD  HL,BC
    LD   A,(MZ25_VRAM_SCROLL_RECT_UP8_ROWS)
MZ25_VRAM_SCROLL_RECT_UP8_LINE:
    LD   (MZ25_VRAM_SCROLL_RECT_UP8_WRAP),A
    LD   A,(MZ25_VRAM_SCROLL_RECT_UP8_WBYTE)
    LD   C,A
    LD   B,0
    LDIR
    LD   A,(MZ25_VRAM_SCROLL_RECT_UP8_LINEADD)
    LD   C,A
    LD   B,0
    ADD  HL,BC
    EX   DE,HL
    ADD  HL,BC
    EX   DE,HL
    LD   A,(MZ25_VRAM_SCROLL_RECT_UP8_WRAP)
    DEC  A
    JR   NZ,MZ25_VRAM_SCROLL_RECT_UP8_LINE
    RET

MZ25_VRAM_SCROLL_RECT_UP8_CALC_START:
    LD   HL,2000H
    LD   A,(MZ25_VRAM_SCROLL_RECT_UP8_Y)
    OR   A
    JR   Z,MZ25_VRAM_SCROLL_RECT_UP8_ADD_X
    LD   B,A
    LD   DE,40
MZ25_VRAM_SCROLL_RECT_UP8_Y_LOOP:
    ADD  HL,DE
    DJNZ MZ25_VRAM_SCROLL_RECT_UP8_Y_LOOP
MZ25_VRAM_SCROLL_RECT_UP8_ADD_X:
    LD   A,(MZ25_VRAM_SCROLL_RECT_UP8_XBYTE)
    LD   E,A
    LD   D,0
    ADD  HL,DE
    RET

MZ25_VRAM_SCROLL_RECT_UP8_WRAP:
    DB   0
MZ25_VRAM_SCROLL_RECT_UP8_SAVE:
    DB   0
MZ25_VRAM_SCROLL_RECT_UP8_BLOCK:
    DB   0
MZ25_VRAM_SCROLL_RECT_UP8_XBYTE:
    DB   0
MZ25_VRAM_SCROLL_RECT_UP8_Y:
    DB   0
MZ25_VRAM_SCROLL_RECT_UP8_WBYTE:
    DB   0
MZ25_VRAM_SCROLL_RECT_UP8_H:
    DB   0
MZ25_VRAM_SCROLL_RECT_UP8_ROWS:
    DB   0
MZ25_VRAM_SCROLL_RECT_UP8_LINEADD:
    DB   0
MZ25_VRAM_SCROLL_RECT_UP8_END:
    #END
}

// 320x200x16色ページの指定矩形を8ドット下へスクロールする。
// 上端8ラインは未更新になるため、呼び出し側で新しいタイル行を描画する。
// PAGE: 0..3, XBYTE: 0..39, Y: 0..199, WBYTE: 1..40, H: 9..200
MZ25_VRAM_SCROLL_RECT_DOWN8(BYTE PAGE, BYTE XBYTE, BYTE Y, BYTE WBYTE, BYTE H)
{
    ^A = PAGE;
    #ASM
    LD   A,(_A)
    AND  03H
    ADD  A,20H
    LD   (MZ25_VRAM_SCROLL_RECT_DOWN8_BLOCK),A
    #END

    ^A = XBYTE;
    #ASM
    LD   A,(_A)
    LD   (MZ25_VRAM_SCROLL_RECT_DOWN8_XBYTE),A
    #END

    ^A = Y;
    #ASM
    LD   A,(_A)
    LD   (MZ25_VRAM_SCROLL_RECT_DOWN8_Y),A
    #END

    ^A = WBYTE;
    #ASM
    LD   A,(_A)
    LD   (MZ25_VRAM_SCROLL_RECT_DOWN8_WBYTE),A
    #END

    ^A = H;
    #ASM
    LD   A,(_A)
    LD   (MZ25_VRAM_SCROLL_RECT_DOWN8_H),A

    LD   A,(MZ25_VRAM_SCROLL_RECT_DOWN8_H)
    CP   9
    JP   C,MZ25_VRAM_SCROLL_RECT_DOWN8_END
    SUB  8
    LD   (MZ25_VRAM_SCROLL_RECT_DOWN8_ROWS),A
    LD   A,(MZ25_VRAM_SCROLL_RECT_DOWN8_WBYTE)
    OR   A
    JP   Z,MZ25_VRAM_SCROLL_RECT_DOWN8_END
    ADD  A,40
    LD   (MZ25_VRAM_SCROLL_RECT_DOWN8_LINEBACK),A

    DI
    LD   A,1
    OUT  (0B4H),A
    IN   A,(0B5H)
    LD   (MZ25_VRAM_SCROLL_RECT_DOWN8_SAVE),A

    LD   B,4
MZ25_VRAM_SCROLL_RECT_DOWN8_PLANE:
    PUSH BC
    LD   A,1
    OUT  (0B4H),A
    LD   A,(MZ25_VRAM_SCROLL_RECT_DOWN8_BLOCK)
    OUT  (0B5H),A

    CALL MZ25_VRAM_SCROLL_RECT_DOWN8_BLOCK_PROC

    LD   A,(MZ25_VRAM_SCROLL_RECT_DOWN8_BLOCK)
    ADD  A,4
    LD   (MZ25_VRAM_SCROLL_RECT_DOWN8_BLOCK),A
    POP  BC
    DJNZ MZ25_VRAM_SCROLL_RECT_DOWN8_PLANE

    LD   A,1
    OUT  (0B4H),A
    LD   A,(MZ25_VRAM_SCROLL_RECT_DOWN8_SAVE)
    OUT  (0B5H),A
    EI
    JR   MZ25_VRAM_SCROLL_RECT_DOWN8_END

MZ25_VRAM_SCROLL_RECT_DOWN8_BLOCK_PROC:
    CALL MZ25_VRAM_SCROLL_RECT_DOWN8_CALC_BOTTOM
    LD   D,H
    LD   E,L
    LD   BC,320
    OR   A
    SBC  HL,BC
    LD   A,(MZ25_VRAM_SCROLL_RECT_DOWN8_ROWS)
MZ25_VRAM_SCROLL_RECT_DOWN8_LINE:
    LD   (MZ25_VRAM_SCROLL_RECT_DOWN8_WRAP),A
    LD   A,(MZ25_VRAM_SCROLL_RECT_DOWN8_WBYTE)
    LD   C,A
    LD   B,0
    LDIR
    LD   (MZ25_VRAM_SCROLL_RECT_DOWN8_SRC),HL
    EX   DE,HL
    LD   A,(MZ25_VRAM_SCROLL_RECT_DOWN8_LINEBACK)
    LD   C,A
    LD   B,0
    OR   A
    SBC  HL,BC
    EX   DE,HL
    LD   HL,(MZ25_VRAM_SCROLL_RECT_DOWN8_SRC)
    LD   A,(MZ25_VRAM_SCROLL_RECT_DOWN8_LINEBACK)
    LD   C,A
    LD   B,0
    OR   A
    SBC  HL,BC
    LD   A,(MZ25_VRAM_SCROLL_RECT_DOWN8_WRAP)
    DEC  A
    JR   NZ,MZ25_VRAM_SCROLL_RECT_DOWN8_LINE
    RET

MZ25_VRAM_SCROLL_RECT_DOWN8_CALC_BOTTOM:
    LD   HL,2000H
    LD   A,(MZ25_VRAM_SCROLL_RECT_DOWN8_Y)
    LD   C,A
    LD   A,(MZ25_VRAM_SCROLL_RECT_DOWN8_H)
    ADD  A,C
    DEC  A
    OR   A
    JR   Z,MZ25_VRAM_SCROLL_RECT_DOWN8_ADD_X
    LD   B,A
    LD   DE,40
MZ25_VRAM_SCROLL_RECT_DOWN8_Y_LOOP:
    ADD  HL,DE
    DJNZ MZ25_VRAM_SCROLL_RECT_DOWN8_Y_LOOP
MZ25_VRAM_SCROLL_RECT_DOWN8_ADD_X:
    LD   A,(MZ25_VRAM_SCROLL_RECT_DOWN8_XBYTE)
    LD   E,A
    LD   D,0
    ADD  HL,DE
    RET

MZ25_VRAM_SCROLL_RECT_DOWN8_WRAP:
    DB   0
MZ25_VRAM_SCROLL_RECT_DOWN8_SAVE:
    DB   0
MZ25_VRAM_SCROLL_RECT_DOWN8_BLOCK:
    DB   0
MZ25_VRAM_SCROLL_RECT_DOWN8_XBYTE:
    DB   0
MZ25_VRAM_SCROLL_RECT_DOWN8_Y:
    DB   0
MZ25_VRAM_SCROLL_RECT_DOWN8_WBYTE:
    DB   0
MZ25_VRAM_SCROLL_RECT_DOWN8_H:
    DB   0
MZ25_VRAM_SCROLL_RECT_DOWN8_ROWS:
    DB   0
MZ25_VRAM_SCROLL_RECT_DOWN8_LINEBACK:
    DB   0
MZ25_VRAM_SCROLL_RECT_DOWN8_SRC:
    DW   0
MZ25_VRAM_SCROLL_RECT_DOWN8_END:
    #END
}

// 320x200x16色ページの指定矩形を8ドット左へ非ループシフトする。
// XBYTE と WBYTE は8ドット単位。例: X=40, 幅=240なら XBYTE=5, WBYTE=30。
// PAGE: 0..3, XBYTE: 0..39, Y: 0..199, WBYTE: 1..40, H: 1..200
MZ25_VRAM_SHIFT_RECT_LEFT8(BYTE PAGE, BYTE XBYTE, BYTE Y, BYTE WBYTE, BYTE H)
{
    ^A = PAGE;
    #ASM
    LD   A,(_A)
    AND  03H
    ADD  A,20H
